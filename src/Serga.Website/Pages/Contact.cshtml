@page "/contact"
@{ ViewData["Title"] = "Contact and book a demo"; ViewData["Description"] = "Explore Serga for your business. Internal contact and demo page prototype."; }
<section class="hero container contact-page"><div class="hero-copy"><p class="eyebrow">Contact / Book a demo</p><h1>Let’s make<br /><em>the connection.</em></h1><p class="hero-description">Explore the Serga products that fit your business. A conversation can start with one product, a shared challenge or a wider vision.</p><div class="contact-prompts"><p class="eyebrow">A useful starting point</p><p>What do you provide or manage?</p><p>Where does the context get fragmented?</p><p>Which systems do you already use?</p></div><p class="prototype-note">Internal website prototype. Demo booking and contact submission are not available yet.</p></div><div class="product-stage services-stage"><form class="contact-form" aria-describedby="contact-prototype"><p class="eyebrow">A first conversation</p><h2>Tell us about<br /><em>your business.</em></h2><p id="contact-prototype" class="prototype-note">Visual prototype only. Fields and submission are disabled; no information is sent or saved.</p><fieldset disabled><legend class="sr-only">Demo request prototype</legend><label for="contact-name">Name</label><input id="contact-name" type="text" placeholder="Your name" /><label for="contact-email">Work email</label><input id="contact-email" type="email" placeholder="Your work email" /><label for="contact-company">Organization</label><input id="contact-company" type="text" placeholder="Your organization" /><label for="contact-product">Interested in</label><select id="contact-product"><option>Choose a product or combination</option><option>Serga Services</option><option>Serga Contracts</option><option>Serga Revenue</option><option>Serga Leasing</option><option>Multiple products</option></select><label for="contact-message">What would you like to explore?</label><textarea id="contact-message" rows="3" placeholder="Your business context"></textarea><button class="button button-dark" type="button" disabled>Book a demo — coming soon</button></fieldset></form></div></section>
