@inherits LayoutComponentBase

@using TenantPlatform.Web.Components.Shared
@using TenantPlatform.Web.Security.CurrentUserContext
@using Microsoft.Extensions.Localization
@using TenantPlatform.Web
@inject IStringLocalizer<TenantPlatformResources> L
@inject ICurrentUserContextService UserContext

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-header">
            <a class="navbar-brand" href="/">
                <img class="brand-logo brand-logo-light"
                    src="/images/branding/serga-logo-light.png"
                    alt="Serga" />

                <img class="brand-logo brand-logo-dark"
                    src="/images/branding/serga-logo-dark.png"
                    alt="Serga" />
            </a>            
        </div>
        <nav class="sidebar-nav">
            <NavMenu />
        </nav>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <div class="topbar-account">
                <CurrentAccountDisplay />
            </div>

            <div class="topbar-user">
                <CurrentUserMenu />
            </div>
        </header>

        <main class="content">
            @Body
        </main>

    </div>

</div>
