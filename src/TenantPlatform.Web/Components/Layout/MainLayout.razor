@inherits LayoutComponentBase

@using TenantPlatform.Web.Components.Shared
@using TenantPlatform.Web.Security.CurrentUserContext
@using Microsoft.Extensions.Localization
@using TenantPlatform.Web
@inject IStringLocalizer<TenantPlatformResources> L
@inject ICurrentUserContextService UserContext

<div class="app-shell">

    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="/" class="brand">
                TenantPlatform
            </a>
        </div>
        <nav class="sidebar-nav">

            <NavLink href="/"
                    Match="NavLinkMatch.All"
                    class="sidebar-link">
                <i class="bi bi-house-door"></i>
                <span>@L["Dashboard"]</span>
            </NavLink>

            <NavLink href="/buildings"
                    class="sidebar-link">
                <i class="bi bi-buildings"></i>
                <span>@L["Buildings"]</span>
            </NavLink>

            <NavLink href="/organizations"
                    class="sidebar-link">
                <i class="bi bi-people"></i>
                <span>@L["Organizations"]</span>
            </NavLink>

            <NavLink href="/users"
                    class="sidebar-link">
                <i class="bi bi-person"></i>
                <span>@L["Users"]</span>
            </NavLink>

            <NavLink href="/services"
                    class="sidebar-link">
                <i class="bi bi-briefcase"></i>
                <span>@L["Services"]</span>
            </NavLink>

            <NavLink href="/network"
                    class="sidebar-link">
                <i class="bi bi-wifi"></i>
                <span>@L["Network"]</span>
            </NavLink>

            <NavLink href="/administration"
                    class="sidebar-link">
                <i class="bi bi-shield-check"></i>
                <span>@L["Administration"]</span>
            </NavLink>

        </nav>
    </aside>

    <div class="main-area">

        <header class="topbar">
            <div class="topbar-account">
                <CurrentAccountDisplay />
            </div>

            <div class="topbar-user">
                <CurrentUserMenu />
            </div>
        </header>

        <main class="content">
            @Body
        </main>

    </div>

</div>
