@using TenantPlatform.Application.Agent
@using TenantPlatform.Application.Mcp
@using TenantPlatform.Infrastructure.Agent
@using TenantPlatform.Web.Agent
@using Microsoft.AspNetCore.Antiforgery
@inject IServiceProvider Services
@inject Microsoft.Extensions.Options.IOptions<ReadAgentOptions> Options

<section class="card card-body" data-read-agent data-account="@account" data-context="@context" data-csrf="@verification"
    data-edit-page="@EditPage" data-edit-connection="@editConnection" data-edit-updated="@L["DraftUpdated"]" data-edit-copied="@L["DraftCopied"]"
    data-editing="@L["DraftEditing"]" data-edit-save="@L["DraftSaveChanges"]" data-edit-copy="@L["DraftSaveCopy"]" data-edit-discard="@L["DraftDiscard"]" data-edit-reload="@L["DraftReload"]" data-edit-reload-confirm="@L["DraftReloadConfirm"]" data-edit-changes="@L["DraftChanges"]" data-edit-no-changes="@L["DraftNoChanges"]"
    data-running="@L["AgentRunning"]" data-done="@L["AgentDone"]" data-failure="@L["AgentErrorUnavailable"]"
    data-changed="@L["AgentErrorAccessChanged"]" data-cancelled="@L["AgentMessageCancelled"]"
    data-question-label="@L["AgentQuestion"]" data-answer-label="@L["AgentAnswerLabel"]"
    data-revalidated="@L["AgentSourceRevalidated"]" data-new-source="@L["AgentSourceNew"]"
    data-draft-title="@L["DraftTitle"]" data-draft-save="@L["DraftSave"]" data-draft-open="@L["DraftOpen"]" data-draft-saved="@L["DraftSaved"]" data-draft-old="@L["DraftOld"]" data-draft-snapshot="@L["DraftSnapshot"]" data-draft-summary="@L["DraftSummary"]" data-draft-new="@L["DraftNew"]"
    data-error="@L["PagesErrorUnavailable"]" data-yes="@L["Yes"]" data-no="@L["No"]" data-complete="@L["PagesComplete"]" data-more="@L["PagesMore"]" data-limit="@L["PagesLimitReached"]" data-empty="@L["PagesEmpty"]" data-missing="@L["PagesMissing"]" data-total="@L["PagesTotal"]" data-date="@L["PagesDate"]" data-snapshot="@L["PagesSnapshot"]" data-title="@L["Name"]" data-building="@L["Building"]" data-end="@L["AgreementEndDate"]" data-count="@L["PagesCount"]" data-page="@L["PagesPage"]"
    data-pending-history="@L["AgentHistoryPending"]" data-expired="@L["AgentSessionExpired"]">
    <h1 class="h4">@L["AgentTitle"]</h1>
    <p class="alert alert-warning">@L["AgentDisclosure"]</p>
    <p>@L["AgentAccount"]: @account</p>
    <p>@L["AgentTemporaryContext"]</p>
    @if (!ready) { <p role="status">@L["AgentErrorDisabled"]</p> }
    else if (connections.Count == 0) { <p>@L["AgentNoConnections"] <a href="/mcp-client/registry">@L["McpRegistryTitle"]</a></p> }
    else
    {
        <label class="form-label">@L["AgentConnection"]
            <select class="form-select" data-connection required>
                <option value="">@L["AgentSelectConnection"]</option>
                @foreach (var connection in connections) { <option value="@connection.Id" selected="@(editConnection == connection.Id)">@connection.Name (@connection.ToolCount)</option> }
            </select>
        </label>
        <label class="form-check mb-3"><input type="checkbox" class="form-check-input" data-consent /> <span>@L["AgentAcceptDisclosure"]</span></label>
        @if (EditPage.HasValue) { <p data-edit-intro>@L["DraftEditing"]: @editTitle</p><button class="btn btn-outline-primary" type="button" data-edit-start>@L["PagesEditAi"]</button> }
        <form data-question-form>
            <label class="form-label w-100">@L["AgentQuestion"]<textarea class="form-control" data-prompt rows="3" maxlength="@Options.Value.Limits.PromptCharacters" required></textarea></label>
            <button class="btn btn-primary" type="submit" data-send>@L["AgentSend"]</button>
            <button class="btn btn-outline-secondary" type="button" data-cancel disabled>@L["AgentCancel"]</button>
            <button class="btn btn-outline-secondary" type="button" data-new>@L["AgentNew"]</button>
        </form>
        <p class="mt-3" data-status role="status" aria-live="polite"></p>
        <div data-turns aria-live="polite"></div>
        <section data-report-draft aria-live="polite"></section>
    }
</section>
@code {
    [CascadingParameter] public HttpContext? Http { get; set; }
    // TestServer rendering can explicitly pass the same real authenticated request.
    [Parameter] public HttpContext? RequestContext { get; set; }
    [Parameter] public Guid? EditPage { get; set; }
    private Guid? editConnection;
    private string? editTitle;
    private Guid? account;
    private string? context, verification;
    private bool ready;
    private IReadOnlyList<AgentConnection> connections = [];
    protected override async Task OnInitializedAsync()
    {
        var http = Http ?? RequestContext;
        if (http is null) return;
        http.Response.Headers.CacheControl = "no-store";
        try
        {
            var identity = await ReadAgentEndpoints.Identity(http, http.RequestAborted);
            if (identity is null) return;
            account = identity.Value.Account; context = identity.Value.Key;
            verification = Services.GetRequiredService<IAntiforgery>().GetAndStoreTokens(http).RequestToken;
            ready = Options.Value.Ready && Services.GetService<McpRegistryService>() is not null;
            if (ready) {
                var agent = Services.GetRequiredService<ReadAgentService>();
                connections = await agent.ConnectionsAsync(http.RequestAborted);
                if (EditPage is Guid pageId) {
                    var draft = await agent.EditPageAsync(pageId, http.RequestAborted);
                    editConnection = draft.Definition.ConnectionId; editTitle = draft.Definition.Title;
                }
            }
        }
        catch (Exception) { ready = false; }
    }
}
