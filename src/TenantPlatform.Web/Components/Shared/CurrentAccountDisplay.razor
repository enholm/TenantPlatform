@using TenantPlatform.Application.Security
@using TenantPlatform.Web.Security.CurrentUserContext
@inject AccountContextReader Accounts
@inject ICurrentUserContextService UserContext

@if (!string.IsNullOrWhiteSpace(accountName))
{
    <span>@accountName</span>
}

@code {
    private string? accountName;
    protected override async Task OnInitializedAsync()
    {
        if (!UserContext.Current.IsAuthenticated) return;
        try { accountName = await Accounts.ReadSelectedNameAsync(); }
        catch (UnauthorizedAccessException) { accountName = null; }
    }
}
