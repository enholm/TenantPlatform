@page "/select-account"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Application.Security
@using TenantPlatform.Web.Security.CurrentUserContext

@inject AccountContextReader Accounts
@inject ICurrentUserContextService CurrentUserContextService

<PageTitle>Velg selskap</PageTitle>

<h1>Velg selskap</h1>

@if (accounts is null)
{
    <p>Laster...</p>
}
else if (accounts.Count == 0)
{
    <div class="alert alert-warning">
        Du har ikke tilgang til noen Accounts.
    </div>
}
else
{
    @foreach (var account in accounts)
    {
        <form method="post"
              action="/auth/select-account"
              class="mb-2">
            
            <AntiforgeryToken />
            
            <input type="hidden"
                   name="accountId"
                   value="@account.Id" />

            <button type="submit"
                    class="btn btn-outline-primary">
                @account.Name
            </button>
        </form>
    }
}

@code {
    private IReadOnlyList<MemberAccount>? accounts;
    protected override async Task OnInitializedAsync()
    {
        try { accounts = await Accounts.ReadAsync(); }
        catch (UnauthorizedAccessException) { accounts = []; }
    }
}
