@page "/units/create"
@page "/buildings/{BuildingId:guid}/units/create"

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Properties
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.Buildings
@using TenantPlatform.Web.Services.Units

@inject IUnitService UnitService
@inject IBuildingService BuildingService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L["CreateUnit"]</PageTitle>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (buildings.Count == 0)
{
    <div class="alert alert-warning">
        @L["NoBuildingsAvailableForUnit"]
    </div>
}
else if (Model is not null)
{
    <div class="mb-4">
        @if (BuildingId.HasValue)
        {
            <a href="@($"/buildings/{BuildingId.Value}")"
               class="text-decoration-none">
                ← @L["Building"]
            </a>
        }
        else
        {
            <a href="/units"
               class="text-decoration-none">
                ← @L["Units"]
            </a>
        }
    </div>

    <h1>@L["CreateUnit"]</h1>

    <div class="card mt-4">
        <div class="card-body">

            <EditForm Model="Model"
                      OnValidSubmit="CreateAsync"
                      FormName="CreateUnit">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">
                        @L["Building"]
                    </label>

                    <InputSelect id="buildingSelect"
                                 class="form-select"
                                 @bind-Value="Model.BuildingId"
                                 oninput="tenantPlatformUnitForm.filterParents(this.value, 'parentUnitSelect')">
                        @foreach (var building in buildings)
                        {
                            <option value="@building.Id">
                                @building.Name
                            </option>
                        }
                    </InputSelect>

                    <ValidationMessage For="() => Model.BuildingId" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["ParentUnit"]
                    </label>

                    <InputSelect id="parentUnitSelect"
                                 class="form-select"
                                 @bind-Value="Model.ParentUnitId">

                        <option value="">
                            @L["NoParentUnit"]
                        </option>

                        @foreach (var unit in parentUnits)
                        {
                            <option value="@unit.Id"
                                    data-building-id="@unit.BuildingId"
                                    hidden="@(unit.BuildingId != Model.BuildingId)">
                                @unit.Name
                            </option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["Name"]
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Model.Name" />

                    <ValidationMessage For="() => Model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["Type"]
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="Model.Type">

                        <option value="@UnitType.Section">
                            @L["UnitTypeSection"]
                        </option>

                        <option value="@UnitType.Floor">
                            @L["UnitTypeFloor"]
                        </option>

                        <option value="@UnitType.Office">
                            @L["UnitTypeOffice"]
                        </option>

                        <option value="@UnitType.Other">
                            @L["UnitTypeOther"]
                        </option>

                    </InputSelect>
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.IsActive" />

                    <label class="form-check-label">
                        @L["IsActive"]
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">
                        @(isSaving
                            ? L["Saving"]
                            : L["Create"])
                    </button>

                    <a href="@GetCancelUrl()"
                       class="btn btn-outline-secondary">
                        @L["Cancel"]
                    </a>
                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    [Parameter]
    public Guid? BuildingId { get; set; }

    [SupplyParameterFromForm(FormName = "CreateUnit")]
    public CreateUnitFormModel? Model { get; set; }

    private bool isLoading = true;
    private bool isSaving;

    private List<BuildingListItemDto> buildings = [];
    private List<UnitListItemDto> parentUnits = [];

    protected override void OnInitialized()
    {
        Model ??= new CreateUnitFormModel();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthorizationService.CanManageUnitsAsync())
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var allBuildings =
            await BuildingService.GetBuildingsAsync(
                accountId.Value);

        foreach (var building in allBuildings)
        {
            if (await AuthorizationService
                .CanCreateUnitAsync(building.Id))
            {
                buildings.Add(building);
            }
        }

        if (buildings.Count == 0)
        {
            isLoading = false;
            return;
        }

        // På første GET velger vi Building fra URL hvis den er gyldig.
        if (Model!.BuildingId == Guid.Empty)
        {
            if (BuildingId.HasValue &&
                buildings.Any(x => x.Id == BuildingId.Value))
            {
                Model.BuildingId = BuildingId.Value;
            }
            else
            {
                Model.BuildingId = buildings[0].Id;
            }
        }

        // Beskytt mot manipulert form-post.
        if (!buildings.Any(x => x.Id == Model.BuildingId))
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        parentUnits =
            await UnitService.GetUnitsAsync(
                accountId.Value);

        isLoading = false;
    }

    private async Task CreateAsync()
    {
        if (Model is null)
        {
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        if (!await AuthorizationService
            .CanCreateUnitAsync(Model.BuildingId))
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        isSaving = true;

        try
        {
            var id =
                await UnitService.CreateUnitAsync(
                    accountId.Value,
                    new CreateUnitRequest
                    {
                        BuildingId = Model.BuildingId,
                        ParentUnitId = Model.ParentUnitId,
                        Name = Model.Name,
                        Type = Model.Type,
                        IsActive = Model.IsActive
                    });

            Navigation.NavigateTo(
                $"/units/{id}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetCancelUrl()
    {
        if (BuildingId.HasValue)
        {
            return $"/buildings/{BuildingId.Value}";
        }

        return "/units";
    }

    public sealed class CreateUnitFormModel
    {
        [Required]
        public Guid BuildingId { get; set; }

        public Guid? ParentUnitId { get; set; }

        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [Required]
        public UnitType Type { get; set; }
            = UnitType.Office;

        public bool IsActive { get; set; } = true;
    }
}

