@page "/units"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Properties
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.Units

@inject IUnitService UnitService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L["Units"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@L["Units"]</h1>
        <p class="text-body-secondary mb-0">
            @L["UnitsDescription"]
        </p>
    </div>

    @if (canCreateAny)
    {
        <a href="/units/create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            @L["CreateUnit"]
        </a>
    }
</div>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (units.Count == 0)
{
    <div class="alert alert-info">
        @L["NoUnits"]
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["Name"]</th>
                        <th>@L["Building"]</th>
                        <th>@L["ParentUnit"]</th>
                        <th>@L["Type"]</th>
                        <th>@L["Status"]</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var unit in units)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @unit.Name
                            </td>

                            <td>
                                @unit.BuildingName
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(unit.ParentUnitName)
                                    ? "-"
                                    : unit.ParentUnitName)
                            </td>

                            <td>
                                @GetUnitTypeText(unit.Type)
                            </td>

                            <td>
                                @if (unit.IsActive)
                                {
                                    <span class="badge text-bg-success">
                                        @L["Active"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        @L["Inactive"]
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <a href="@($"/units/{unit.Id}")"
                                   class="btn btn-outline-secondary btn-sm">
                                    @L["Open"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool canCreateAny;

    private List<UnitListItemDto> units = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthorizationService.CanManageUnitsAsync())
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            isLoading = false;
            return;
        }

        units = await UnitService.GetUnitsAsync(
            accountId.Value);

        foreach (var buildingId in units
            .Select(x => x.BuildingId)
            .Distinct())
        {
            if (await AuthorizationService
                .CanCreateUnitAsync(buildingId))
            {
                canCreateAny = true;
                break;
            }
        }

        isLoading = false;
    }

    private string GetUnitTypeText(UnitType type)
    {
        return type switch
        {
            UnitType.Section => L["UnitTypeSection"],
            UnitType.Floor => L["UnitTypeFloor"],
            UnitType.Office => L["UnitTypeOffice"],
            UnitType.Other => L["UnitTypeOther"],
            _ => type.ToString()
        };
    }
}

