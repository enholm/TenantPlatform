@using TenantPlatform.Core.Leasing

<section class="card">
    <div class="card-body">
        <h2 class="h5">@L["DimensionLeasingRules"]</h2>

        @if (Error is not null)
        {
            <div role="alert" class="alert alert-danger">@L[Error]</div>
        }

        <EditForm @key="Rule" Model="Rule" OnValidSubmit="SaveAsync" FormName="dimension-rule">
            <fieldset disabled="@IsBusy">
                <label class="d-block">
                    <InputCheckbox @bind-Value="Rule.IsEnabled" /> @L["DimensionEnabledLeasing"]
                </label>
                <label class="d-block">
                    <InputCheckbox @bind-Value="Rule.IsRequired" /> @L["DimensionRequired"]
                </label>
                <label class="d-block mb-2">
                    <InputCheckbox @bind-Value="Rule.AllowAllocation" /> @L["DimensionAllowAllocation"]
                </label>
                <button type="submit" class="btn btn-primary" disabled="@IsBusy">@L["Save"]</button>
            </fieldset>
        </EditForm>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public LeasingDimensionRule Rule { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback OnSave { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private Task SaveAsync() => OnSave.InvokeAsync();
}
