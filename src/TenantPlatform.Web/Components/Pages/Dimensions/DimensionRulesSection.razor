@using TenantPlatform.Core.Leasing

<section class="card">
    <div class="card-body">
        <h2 class="h5">@L["DimensionLeasingRules"]</h2>

        @if (Error is not null)
        {
            <div role="alert" class="alert alert-danger">@L[Error]</div>
        }

        <EditForm @key="AgreementRule" Model="AgreementRule" OnValidSubmit="SaveAgreementAsync" FormName="leasing-agreement-dimension-rule">
            <fieldset disabled="@IsBusy">
                <h3 class="h6">@L["LeasingDimensionsOnAgreement"]</h3>
                <label class="d-block">
                    <InputCheckbox @bind-Value="AgreementRule.IsEnabled" @bind-Value:after="AgreementEnabledChanged" /> @L["DimensionEnabledLeasingAgreement"]
                </label>
                <label class="d-block mb-2">
                    <InputCheckbox @bind-Value="AgreementRule.IsRequired" @bind-Value:after="AgreementRequiredChanged" /> @L["DimensionRequiredLeasingAgreement"]
                </label>
                <button type="submit" class="btn btn-primary" disabled="@IsBusy">@L["Save"]</button>
            </fieldset>
        </EditForm>

        <hr />

        <EditForm @key="LineRule" Model="LineRule" OnValidSubmit="SaveLineAsync" FormName="leasing-line-dimension-rule">
            <fieldset disabled="@IsBusy">
                <h3 class="h6">@L["LeasingDimensionsOnLines"]</h3>
                <label class="d-block">
                    <InputCheckbox @bind-Value="LineRule.IsEnabled" /> @L["DimensionEnabledLeasingLines"]
                </label>
                <label class="d-block">
                    <InputCheckbox @bind-Value="LineRule.IsRequired" /> @L["DimensionRequiredLeasingLines"]
                </label>
                <label class="d-block mb-2">
                    <InputCheckbox @bind-Value="LineRule.AllowAllocation" /> @L["DimensionAllowAllocation"]
                </label>
                <button type="submit" class="btn btn-primary" disabled="@IsBusy">@L["Save"]</button>
            </fieldset>
        </EditForm>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public LeasingDimensionRule LineRule { get; set; } = null!;

    [Parameter, EditorRequired]
    public LeasingAgreementDimensionRule AgreementRule { get; set; } = null!;

    [Parameter, EditorRequired]
    public EventCallback OnSaveLine { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnSaveAgreement { get; set; }

    [Parameter]
    public string? Error { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    private void AgreementEnabledChanged() { if (!AgreementRule.IsEnabled) AgreementRule.IsRequired = false; }
    private void AgreementRequiredChanged() { if (AgreementRule.IsRequired) AgreementRule.IsEnabled = true; }
    private Task SaveLineAsync() => OnSaveLine.InvokeAsync();
    private Task SaveAgreementAsync() => OnSaveAgreement.InvokeAsync();
}
