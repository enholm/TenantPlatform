@page "/settings/dimensions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using TenantPlatform.Core.Dimensions
@using TenantPlatform.Core.Leasing
@using TenantPlatform.Core.Agreements
@using TenantPlatform.Web.Services.Agreements
@using TenantPlatform.Web.Services.Dimensions
@using TenantPlatform.Web.Services.Leasing
@using TenantPlatform.Web.Security.CurrentUserContext
@inject DimensionService Service
@inject LeasingService Leasing
@inject IAgreementService Agreements
@inject ICurrentUserContextService User
@inject NavigationManager Navigation

<PageTitle>@L["Dimensions"]</PageTitle>

<h1>@L["Dimensions"]</h1>
<p class="text-muted">@L["DimensionHistoryNotice"]</p>

@if (error is not null && !dimensionEditorOpen && valueInput is null)
{
    <div role="alert" class="alert alert-danger">@L[error]</div>
}

@if (register is null)
{
    <p role="status">@L["Loading"]</p>
}
else
{
    <fieldset disabled="@busy">
        <div class="row g-3 align-items-start">
            <div class="col-12 col-xl-5">
                <DimensionOverview Dimensions="register.Dimensions"
                                   DefaultLanguage="@register.DefaultLanguage"
                                   SelectedDimensionId="dimensionId"
                                   OnCreate="NewDimension"
                                   OnSelect="SelectDimension"
                                   OnEdit="OpenDimensionEditor"
                                   OnRules="OpenRules"
                                   OnValues="OpenValues" />
            </div>

            <div class="col-12 col-xl-7">
                @if (SelectedDimension is null)
                {
                    <section class="card">
                        <div class="card-body text-center text-muted py-5" role="status">
                            <h2 class="h5 text-body">@L["Dimensions"]</h2>
                            <p class="mb-3">@L["ProcessingEmpty"]</p>
                            <button type="button" class="btn btn-primary" @onclick="NewDimension">
                                @L["DimensionNew"]
                            </button>
                        </div>
                    </section>
                }
                else
                {
                    <section class="card mb-3">
                        <div class="card-header bg-body">
                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                <div>
                                    <h2 class="h5 mb-0">@register.DisplayName(SelectedDimension)</h2>
                                    <span class="small text-muted">@SelectedDimension.Code</span>
                                </div>
                                <button type="button" class="btn btn-outline-secondary btn-sm"
                                        @onclick="() => OpenDimensionEditor(SelectedDimension)">
                                    @L["Edit"]
                                </button>
                            </div>
                        </div>
                        <div class="card-body pb-0">
                            <ul class="nav nav-tabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(activeTab == DetailTab.Properties ? "active" : null)"
                                            role="tab" aria-selected="@(activeTab == DetailTab.Properties)"
                                            @onclick="() => activeTab = DetailTab.Properties">
                                        @L["Dimension"]
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(activeTab == DetailTab.Rules ? "active" : null)"
                                            role="tab" aria-selected="@(activeTab == DetailTab.Rules)"
                                            @onclick="() => activeTab = DetailTab.Rules">
                                        @L["DimensionLeasingRules"]
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(activeTab == DetailTab.Agreements ? "active" : null)"
                                            role="tab" aria-selected="@(activeTab == DetailTab.Agreements)"
                                            @onclick="() => activeTab = DetailTab.Agreements">
                                        @L["DimensionAgreementRules"]
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(activeTab == DetailTab.Values ? "active" : null)"
                                            role="tab" aria-selected="@(activeTab == DetailTab.Values)"
                                            @onclick="() => activeTab = DetailTab.Values">
                                        @L["DimensionValues"]
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button type="button" class="nav-link @(activeTab == DetailTab.History ? "active" : null)"
                                            role="tab" aria-selected="@(activeTab == DetailTab.History)"
                                            @onclick="() => activeTab = DetailTab.History">
                                        @L["LeasingHistory"]
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </section>

                    @if (activeTab == DetailTab.Properties)
                    {
                        <section class="card">
                            <div class="card-body">
                                <dl class="row mb-0">
                                    <dt class="col-sm-4">@L["Name"]</dt><dd class="col-sm-8">@register.DisplayName(SelectedDimension)</dd>
                                    <dt class="col-sm-4">@L["DimensionCode"]</dt><dd class="col-sm-8">@SelectedDimension.Code</dd>
                                    <dt class="col-sm-4">@L["Description"]</dt><dd class="col-sm-8">@register.DisplayDescription(SelectedDimension)</dd>
                                    <dt class="col-sm-4">@L["Status"]</dt><dd class="col-sm-8">@L[SelectedDimension.IsActive ? "DimensionActive" : "DimensionInactive"]</dd>
                                </dl>
                            </div>
                        </section>
                    }
                    else if (activeTab == DetailTab.Rules)
                    {
                        <DimensionRulesSection LineRule="rule" AgreementRule="leasingAgreementRule"
                                               OnSaveLine="SaveRule" OnSaveAgreement="SaveLeasingAgreementRule"
                                               Error="@error" IsBusy="busy" />
                    }
                    else if (activeTab == DetailTab.Agreements)
                    {
                        <AgreementDimensionRulesSection Rule="agreementRule" OnSave="SaveAgreementRule" Error="@error" IsBusy="busy" />
                    }
                    else if (activeTab == DetailTab.Values)
                    {
                        <DimensionValuesSection Values="Paths" DimensionName="@register.DisplayName(SelectedDimension)" IsBusy="busy"
                                                OnCreate="NewValue" OnCreateChild="NewChild" OnEdit="EditValue" />
                    }
                    else if (activeTab == DetailTab.History)
                    {
                        <section class="card">
                            <div class="card-body">
                                <h2 class="h5">@L["LeasingHistory"]</h2>
                                @foreach (var entry in register.History.Where(x => x.DimensionId == dimensionId))
                                {
                                    <details class="border-bottom py-2">
                                        <summary>@entry.RecordedUtc.ToString("dd.MM.yyyy HH:mm 'UTC'") · @register.Actors.GetValueOrDefault(entry.ActorUserId, entry.ActorUserId.ToString())</summary>
                                        <div class="row">
                                            <div class="col-md-6"><strong>@L["LeasingBefore"]</strong><DimensionHistoryView Json="@entry.BeforeJson" /></div>
                                            <div class="col-md-6"><strong>@L["LeasingAfter"]</strong><DimensionHistoryView Json="@entry.AfterJson" /></div>
                                        </div>
                                    </details>
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        </div>
    </fieldset>
}

<DimensionEditorDialog IsOpen="dimensionEditorOpen" Dimension="dimensionInput" Error="@error"
                       OnSave="SaveDimension" OnCancel="CancelDimensionEditor" />
<DimensionValueEditorDialog IsOpen="@(valueInput is not null)" IsEditing="@valueId.HasValue"
                            Value="valueInput" ParentOptions="Paths" Error="@error"
                            OnSave="SaveValue" OnCancel="CancelValue" />

@code {
    private enum DetailTab { Properties, Rules, Agreements, Values, History }

    private DimensionRegister? register;
    private LeasingClassificationCatalog? catalog;
    private List<AgreementDimensionRuleDto> agreementRules = [];
    private AgreementDimensionRule agreementRule = new();
    private List<LeasingAgreementDimensionRule> leasingAgreementRules = [];
    private LeasingAgreementDimensionRule leasingAgreementRule = new();
    private Guid? dimensionId, valueId;
    private Guid account;
    private Dimension? dimensionInput;
    private DimensionValue? valueInput;
    private LeasingDimensionRule rule = new();
    private DetailTab activeTab;
    private bool busy, dimensionEditorOpen;
    private string? error;

    private Dimension? SelectedDimension => dimensionId.HasValue
        ? register?.Dimensions.SingleOrDefault(x => x.Id == dimensionId)
        : null;
    private List<DimensionValueOption> Paths => dimensionId.HasValue && register is not null
        ? DimensionHierarchy.Build(register.Dimensions.Single(x => x.Id == dimensionId), register.Values)
        : [];

    private static T Copy<T>(T input) => System.Text.Json.JsonSerializer.Deserialize<T>(System.Text.Json.JsonSerializer.Serialize(input))!;

    protected override async Task OnInitializedAsync()
    {
        if (User.Current.CurrentAccountId is not Guid id)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        account = id;
        await Run(Reload);
    }

    private async Task Reload()
    {
        register = await Service.GetAsync();
        catalog = await Leasing.ClassificationCatalogAsync(account);
        leasingAgreementRules = await Leasing.GetAgreementDimensionRulesAsync(account);
        agreementRules = await Agreements.GetAgreementDimensionRulesAsync(account);
    }

    private void NewDimension()
    {
        error = null;
        dimensionInput = null;
        dimensionEditorOpen = true;
    }

    private void SelectDimension(Dimension value) => SelectDimension(value, DetailTab.Properties);
    private void OpenRules(Dimension value) => SelectDimension(value, DetailTab.Rules);
    private void OpenValues(Dimension value) => SelectDimension(value, DetailTab.Values);

    private void SelectDimension(Dimension value, DetailTab tab)
    {
        dimensionId = value.Id;
        rule = Copy(catalog!.Dimensions.Single(x => x.Dimension.Id == value.Id).Rule);
        LoadLeasingAgreementRule(value.Id);
        LoadAgreementRule(value.Id);
        activeTab = tab;
        CancelValue();
    }

    private void OpenDimensionEditor(Dimension value)
    {
        SelectDimension(value, DetailTab.Properties);
        dimensionInput = Copy(value);
        dimensionEditorOpen = true;
    }

    private void CancelDimensionEditor()
    {
        dimensionEditorOpen = false;
        dimensionInput = null;
        error = null;
    }

    private void CancelValue()
    {
        valueId = null;
        valueInput = null;
        error = null;
    }

    private void NewChild(Guid parentId)
    {
        NewValue();
        valueInput!.ParentId = parentId;
    }

    private void NewValue()
    {
        error = null;
        valueId = null;
        valueInput = new DimensionValue { DimensionId = dimensionId ?? Guid.Empty };
    }

    private void EditValue(Guid id)
    {
        error = null;
        valueId = id;
        valueInput = Copy(register!.Values.Single(x => x.Id == id));
    }

    private Task SaveDimension(Dimension input) => Run(async () =>
    {
        var editingId = dimensionInput?.Id == Guid.Empty ? null : dimensionInput?.Id;
        var id = await Service.SaveDimensionAsync(editingId, input);
        await Reload();
        var saved = register!.Dimensions.Single(x => x.Id == id);
        SelectDimension(saved, DetailTab.Properties);
        dimensionEditorOpen = false;
        dimensionInput = null;
    });

    private Task SaveValue(DimensionValue input) => Run(async () =>
    {
        await Service.SaveValueAsync(dimensionId!.Value, valueId, input);
        await Reload();
        CancelValue();
    });

    private Task SaveRule() => Run(async () =>
    {
        await Leasing.SaveDimensionRuleAsync(account, rule);
        await Reload();
        rule = Copy(catalog!.Dimensions.Single(x => x.Dimension.Id == dimensionId).Rule);
    });

    private void LoadLeasingAgreementRule(Guid id) => leasingAgreementRule = Copy(leasingAgreementRules.Single(x => x.DimensionId == id));

    private Task SaveLeasingAgreementRule() => Run(async () =>
    {
        await Leasing.SaveAgreementDimensionRuleAsync(account, Copy(leasingAgreementRule));
        await Reload();
        LoadLeasingAgreementRule(dimensionId!.Value);
    });

    private void LoadAgreementRule(Guid id)
    {
        var saved = agreementRules.Single(x => x.DimensionId == id);
        agreementRule = new AgreementDimensionRule { AccountId = account, DimensionId = id,
            IsEnabled = saved.IsEnabled, IsRequired = saved.IsRequired, Revision = saved.Revision };
    }

    private Task SaveAgreementRule() => Run(async () =>
    {
        await Agreements.SaveAgreementDimensionRuleAsync(account, Copy(agreementRule));
        await Reload();
        LoadAgreementRule(dimensionId!.Value);
    });

    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true;
        error = null;
        try { await action(); }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (DimensionValidationException ex) { error = ex.Message; }
        catch (LeasingValidationException ex) { error = ex.Message; }
        catch (AgreementValidationException ex) { error = ex.Message; }
        catch (Exception) { error = "LeasingFailed"; }
        finally { busy = false; }
    }
}
