@page "/authentication-test"
@rendermode InteractiveServer

@using TenantPlatform.Infrastructure.Authentication
@inject IAuthenticationService AuthenticationService

<PageTitle>Authentication Test</PageTitle>

<h1>Authentication Test</h1>

<div class="mb-3">
    <label class="form-label">Email</label>
    <input class="form-control"
           @bind="email" />
</div>

<div class="mb-3">
    <label class="form-label">Password</label>
    <input class="form-control"
           type="password"
           @bind="password" />
</div>

<button class="btn btn-primary"
        @onclick="AuthenticateAsync"
        disabled="@isAuthenticating">
    @(isAuthenticating ? "Checking..." : "Login")
</button>

@if (result is not null)
{
    <div class="mt-4">
        @if (result.Succeeded && result.User is not null)
        {
            <div class="alert alert-success">
                <strong>Authentication succeeded</strong>

                <div>
                    User:
                    @result.User.FirstName
                    @result.User.LastName
                </div>

                <div>
                    Email:
                    @result.User.Email
                </div>

                <div>
                    User ID:
                    @result.User.Id
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-danger">
                <strong>Authentication failed</strong>

                <div>
                    @result.ErrorMessage
                </div>
            </div>
        }
    </div>
}

@code {
    private string email = "per@nordicproperty.example";
    private string password = string.Empty;

    private bool isAuthenticating;

    private AuthenticationResult? result;

    private async Task AuthenticateAsync()
    {
        result = null;
        isAuthenticating = true;

        try
        {
            result = await AuthenticationService.AuthenticateAsync(
                email,
                password);
        }
        finally
        {
            isAuthenticating = false;
        }
    }
}