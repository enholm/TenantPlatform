@page "/portal/requests/{Id:guid}/assign-provider"

@rendermode InteractiveServer

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Globalization

@using Microsoft.AspNetCore.Authorization

@using TenantPlatform.Core.Services
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.ServiceRequests

@inject IServiceRequestService ServiceRequestService
@inject ICurrentUserContextService UserContext
@inject ITenantAuthorizationService AuthorizationService
@inject NavigationManager Navigation

<PageTitle>@L["AssignProvider"]</PageTitle>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (request is null)
{
    <div class="alert alert-warning">
        @L["ServiceRequestNotFound"]
    </div>

    <a href="/portal/requests"
       class="btn btn-outline-secondary">
        @L["Back"]
    </a>
}
else if (!isAuthorized)
{
    <div class="alert alert-danger">
        @L["AccessDenied"]
    </div>

    <a href="@($"/portal/requests/{Id}")"
       class="btn btn-outline-secondary">
        @L["Back"]
    </a>
}
else
{
    <div class="mb-4">
        <a href="@($"/portal/requests/{Id}")"
           class="text-decoration-none">
            ← @L["BackToRequest"]
        </a>
    </div>

    <div class="mb-4">
        <h1 class="mb-1">
            @L["AssignProvider"]
        </h1>

        <div class="text-body-secondary">
            @request.ServiceName
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="alert alert-danger">
            @L[actionError]
        </div>
    }

    @if (request.Status != ServiceRequestStatus.Approved)
    {
        <div class="alert alert-warning">
            @L["ServiceRequestProviderAssignmentNotAllowed"]
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(
        request.AssignedServiceProviderOrganizationName))
    {
        <div class="alert alert-info">
            @L["ServiceRequestAlreadyAssigned"]
        </div>

        <div class="card mb-4">
            <div class="card-header">
                @L["RequestInformation"]
            </div>

            <div class="card-body">
                <dl class="mb-0">
                    <dt>@L["Service"]</dt>
                    <dd>@request.ServiceName</dd>

                    <dt>@L["Organization"]</dt>
                    <dd>@request.RequesterOrganizationName</dd>

                    <dt>@L["Building"]</dt>
                    <dd>@request.BuildingName</dd>

                    @if (!string.IsNullOrWhiteSpace(request.UnitName))
                    {
                        <dt>@L["Unit"]</dt>
                        <dd>@request.UnitName</dd>
                    }

                    <dt>@L["Provider"]</dt>
                    <dd>
                        @request.AssignedServiceProviderOrganizationName
                    </dd>
                </dl>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @L["ProviderAssignmentCannotBeChanged"]
        </div>

        <div class="row g-4">
            <div class="col-lg-8">

                <div class="card mb-4">
                    <div class="card-header">
                        @L["RequestInformation"]
                    </div>

                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">
                                @L["Service"]
                            </dt>
                            <dd class="col-sm-8">
                                @request.ServiceName
                            </dd>

                            <dt class="col-sm-4">
                                @L["Organization"]
                            </dt>
                            <dd class="col-sm-8">
                                @request.RequesterOrganizationName
                            </dd>

                            <dt class="col-sm-4">
                                @L["Building"]
                            </dt>
                            <dd class="col-sm-8">
                                @request.BuildingName
                            </dd>

                            @if (!string.IsNullOrWhiteSpace(request.UnitName))
                            {
                                <dt class="col-sm-4">
                                    @L["Unit"]
                                </dt>
                                <dd class="col-sm-8">
                                    @request.UnitName
                                </dd>
                            }

                            <dt class="col-sm-4">
                                @L["Status"]
                            </dt>
                            <dd class="col-sm-8">
                                @L[$"ServiceRequestStatus_{request.Status}"]
                            </dd>
                        </dl>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        @L["Provider"]
                    </div>

                    <div class="card-body">

                        @if (providers.Count == 0)
                        {
                            <div class="alert alert-warning mb-0">
                                @L["NoAvailableProviders"]
                            </div>
                        }
                        else
                        {
                            <EditForm Model="model"
                                      OnValidSubmit="AssignAsync">

                                <DataAnnotationsValidator />

                                <div class="mb-3">
                                    <label for="provider"
                                           class="form-label">
                                        @L["Provider"]
                                    </label>

                                    <InputSelect id="provider"
                                                 class="form-select"
                                                 @bind-Value="model.ProviderOrganizationId">

                                        <option value="">
                                            @L["SelectProvider"]
                                        </option>

                                        @foreach (var provider in providers)
                                        {
                                            <option value="@provider.OrganizationId">
                                                @provider.OrganizationName
                                            </option>
                                        }

                                    </InputSelect>

                                    <ValidationMessage For="@(() =>
                                        model.ProviderOrganizationId)" />
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit"
                                            class="btn btn-primary"
                                            disabled="@isProcessing">

                                        @if (isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-person-check me-1"></i>
                                        }

                                        @L["AssignProvider"]
                                    </button>

                                    <a href="@($"/portal/requests/{Id}")"
                                       class="btn btn-outline-secondary">
                                        @L["Cancel"]
                                    </a>
                                </div>

                            </EditForm>
                        }

                    </div>
                </div>
            </div>
        </div>
    }
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private ServiceRequestDetailsDto? request;

    private IReadOnlyList<ServiceRequestProviderOptionDto> providers =
        Array.Empty<ServiceRequestProviderOptionDto>();

    private AssignProviderFormModel model = new();

    private bool isLoading = true;

    private bool isAuthorized;

    private bool isProcessing;

    private string? actionError;

    protected override async Task OnInitializedAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        isAuthorized =
            await AuthorizationService
                .CanApproveServiceRequestAsync(Id);

        if (!isAuthorized)
        {
            isLoading = false;
            return;
        }

        request =
            await ServiceRequestService
                .GetRequestAsync(
                    accountId.Value,
                    Id,
                    UserContext.Current.UserId,
                    CultureInfo.CurrentUICulture.Name);

        if (request is null)
        {
            isLoading = false;
            return;
        }

        if (request.Status == ServiceRequestStatus.Approved &&
            string.IsNullOrWhiteSpace(
                request.AssignedServiceProviderOrganizationName))
        {
            providers =
                await ServiceRequestService
                    .GetAvailableProvidersAsync(
                        accountId.Value,
                        Id);
        }

        isLoading = false;
    }

    private async Task AssignAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue ||
            !model.ProviderOrganizationId.HasValue)
        {
            return;
        }

        actionError = null;
        isProcessing = true;

        try
        {
            await ServiceRequestService
                .AssignProviderAsync(
                    accountId.Value,
                    Id,
                    model.ProviderOrganizationId.Value,
                    UserContext.Current.UserId);

            Navigation.NavigateTo(
                $"/portal/requests/{Id}");
        }
        catch (ServiceRequestValidationException ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private sealed class AssignProviderFormModel
    {
        [Required(
            ErrorMessage = "ServiceProviderRequired")]
        public Guid? ProviderOrganizationId { get; set; }
    }

}
