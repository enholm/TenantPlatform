@page "/portal/requests/{Id:guid}"

@rendermode InteractiveServer

@attribute [Authorize]

@using System.Globalization
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Services
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.ServiceRequests
@using TenantPlatform.Web.Security.Authorization

@inject IServiceRequestService ServiceRequestService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation
@inject ITenantAuthorizationService AuthorizationService

<PageTitle>@(request?.ServiceName ?? L["ServiceRequest"])</PageTitle>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (request is null)
{
    <div class="alert alert-warning">
        @L["ServiceRequestNotFound"]
    </div>
}
else
{
    <div class="mb-4">
        @if (isProviderUser)
        {
            <a href="/provider/requests"
               class="text-decoration-none">
                ← @L["AssignedRequests"]
            </a>
        }
        else
        {
            <a href="/portal/requests"
               class="text-decoration-none">
                ← @L["MyServiceRequests"]
            </a>
        }
    </div>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="mb-1">
                @request.ServiceName
            </h1>

            <div class="text-body-secondary">
                @request.RequesterOrganizationName
                ·
                @request.BuildingName

                @if (!string.IsNullOrWhiteSpace(request.UnitName))
                {
                    <span>
                        · @request.UnitName
                    </span>
                }
            </div>
        </div>

        <div class="d-flex gap-2 align-items-center">
            @if (canApprove)
            {
                <button type="button"
                        class="btn btn-success"
                        disabled="@isProcessing"
                        @onclick="ApproveAsync">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-lg me-2"></i>
                    }

                    @L["Approve"]
                </button>
            }

            @if (canAssignProvider)
            {
                <a class="btn btn-primary"
                   href="@($"/portal/requests/{request.Id}/assign-provider")">

                    <i class="bi bi-person-check me-1"></i>
                    @L["AssignProvider"]
                </a>
            }

            @if (canStartWork)
            {
                <button type="button"
                        class="btn btn-primary"
                        disabled="@isProcessing"
                        @onclick="StartWorkAsync">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-play-fill me-1"></i>
                    }

                    @L["StartWork"]
                </button>
            }

            @if (canComplete)
            {
                <button type="button"
                        class="btn btn-success"
                        disabled="@isProcessing"
                        @onclick="CompleteAsync">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle me-1"></i>
                    }

                    @L["Complete"]
                </button>
            }

            <span class="badge text-bg-secondary fs-6">
                @GetStatusText(request.Status)
            </span>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="alert alert-danger mb-4">
            @L[actionError]
        </div>
    }

    @if (request.Status == ServiceRequestStatus.Approved &&
         string.IsNullOrWhiteSpace(
             request.AssignedServiceProviderOrganizationName))
    {
        <div class="alert alert-warning mb-4">
            <i class="bi bi-exclamation-triangle me-1"></i>
            @L["ServiceRequestAwaitingProviderAssignment"]
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="card mb-4">
                <div class="card-header">
                    @L["RequestDetails"]
                </div>

                <div class="card-body">
                    @if (request.Values.Count == 0)
                    {
                        <span class="text-body-secondary">
                            @L["NoRequestValues"]
                        </span>
                    }
                    else
                    {
                        <dl class="row mb-0">
                            @foreach (var value in request.Values)
                            {
                                <dt class="col-sm-4">
                                    @value.Label
                                </dt>

                                <dd class="col-sm-8">
                                    @GetDisplayValue(value)
                                </dd>
                            }
                        </dl>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    @L["Activity"]
                </div>

                <div class="card-body">

                    @if (request.Messages.Count == 0)
                    {
                        <div class="text-body-secondary">
                            @L["NoActivity"]
                        </div>
                    }
                    else
                    {
                        @foreach (var message in request.Messages)
                        {
                            <div class="d-flex gap-3 mb-4">

                                <div>
                                    <i class="@GetMessageIcon(message) fs-5"></i>
                                </div>

                                <div class="flex-grow-1">

                                    <div class="fw-semibold">
                                        @GetMessageTitle(message)
                                    </div>

                                    <div class="small text-body-secondary mb-1">
                                        @(message.CreatedAt
                                            .ToLocalTime()
                                            .ToString("g"))
                                    </div>

                                    @if (message.Type != ServiceRequestMessageType.System &&
                                         !string.IsNullOrWhiteSpace(message.Body))
                                    {
                                        var visibleBody =
                                            GetVisibleMessageBody(
                                                message.Body);

                                        var isExpanded =
                                            expandedMessages.Contains(
                                                message.Id);

                                        var hasHiddenContent =
                                            HasHiddenQuotedContent(
                                                message.Body,
                                                visibleBody);

                                        <div style="white-space: pre-wrap;">@(isExpanded
                                            ? message.Body.Trim()
                                            : visibleBody)</div>

                                        @if (message.Type ==
                                                ServiceRequestMessageType.Email &&
                                             hasHiddenContent)
                                        {
                                            <button type="button"
                                                    class="btn btn-link btn-sm p-0 mt-1"
                                                    @onclick="() => ToggleMessage(message.Id)">

                                                @(isExpanded
                                                    ? L["HideFullMessage"]
                                                    : L["ShowFullMessage"])
                                            </button>
                                        }
                                    }

                                    @if (CanReplyToMessage(message))
                                    {
                                        @if (replyingToMessageId != message.Id)
                                        {
                                            <div class="mt-2">
                                                <button type="button"
                                                        class="btn btn-outline-primary btn-sm"
                                                        @onclick="() => StartReply(message.Id)">

                                                    <i class="bi bi-reply me-1"></i>
                                                    @L["Reply"]
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mt-3">

                                                <textarea class="form-control"
                                                          rows="4"
                                                          maxlength="4000"
                                                          @bind="replyText"
                                                          placeholder="@L["Reply"]">
                                                </textarea>

                                                <div class="d-flex gap-2 mt-2">

                                                    <button type="button"
                                                            class="btn btn-primary btn-sm"
                                                            disabled="@(isSendingReply || string.IsNullOrWhiteSpace(replyText))"
                                                            @onclick="SendReplyAsync">

                                                        @if (isSendingReply)
                                                        {
                                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-send me-1"></i>
                                                        }

                                                        @L["SendReply"]
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-outline-secondary btn-sm"
                                                            disabled="@isSendingReply"
                                                            @onclick="CancelReply">

                                                        @L["Cancel"]
                                                    </button>

                                                </div>
                                            </div>
                                        }
                                    }

                                </div>
                            </div>
                        }
                    }

                    <hr class="my-4" />

                    <div>
                        <label class="form-label fw-semibold">
                            @L["AddComment"]
                        </label>

                        <textarea class="form-control"
                                  rows="3"
                                  maxlength="4000"
                                  @bind="commentText"
                                  placeholder="@L["AddComment"]">
                        </textarea>

                        <div class="mt-2">
                            <button type="button"
                                    class="btn btn-outline-primary"
                                    disabled="@(isAddingComment || string.IsNullOrWhiteSpace(commentText))"
                                    @onclick="AddCommentAsync">

                                @if (isAddingComment)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                }
                                else
                                {
                                    <i class="bi bi-chat-left-text me-1"></i>
                                }

                                @L["AddComment"]
                            </button>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <div class="col-lg-4">

            <div class="card">

                <div class="card-header">
                    @L["RequestInformation"]
                </div>

                <div class="card-body">

                    <dl class="mb-0">

                        <dt>@L["Organization"]</dt>
                        <dd>@request.RequesterOrganizationName</dd>

                        <dt>@L["Building"]</dt>
                        <dd>@request.BuildingName</dd>

                        @if (!string.IsNullOrWhiteSpace(request.UnitName))
                        {
                            <dt>@L["Unit"]</dt>
                            <dd>@request.UnitName</dd>
                        }

                        <dt>@L["Provider"]</dt>
                        <dd>
                            @if (!string.IsNullOrWhiteSpace(
                                request.AssignedServiceProviderOrganizationName))
                            {
                                @request.AssignedServiceProviderOrganizationName
                            }
                            else
                            {
                                <span class="text-body-secondary">
                                    @L["NotAssigned"]
                                </span>
                            }
                        </dd>

                        <dt>@L["Created"]</dt>
                        <dd>
                            @(request.CreatedAt
                                .ToLocalTime()
                                .ToString("g"))
                        </dd>

                        @if (request.SubmittedAt.HasValue)
                        {
                            <dt>@L["Submitted"]</dt>
                            <dd>
                                @(request.SubmittedAt.Value
                                    .ToLocalTime()
                                    .ToString("g"))
                            </dd>
                        }

                    </dl>

                </div>
            </div>

        </div>
    </div>
}

@code {

    [Parameter]
    public Guid Id { get; set; }

    private ServiceRequestDetailsDto? request;

    private bool isLoading = true;

    private bool canApprove;
    private bool canAssignProvider;
    private bool canStartWork;
    private bool canComplete;

    private bool isProcessing;

    private string? actionError;

    private bool isProviderUser;
    private bool canUseProviderPortal;

    private bool isAddingComment;
    private string commentText = string.Empty;

    private Guid? latestInboundEmailId;

    private Guid? replyingToMessageId;
    private string replyText = string.Empty;
    private bool isSendingReply;

    private readonly HashSet<Guid> expandedMessages = [];

    protected override async Task OnInitializedAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        isProviderUser =
            await AuthorizationService
                .CanUseProviderPortalAsync();

        await ReloadAsync();

        isLoading = false;
    }

    private string GetStatusText(
        ServiceRequestStatus status)
    {
        return L[$"ServiceRequestStatus_{status}"];
    }

    private string GetDisplayValue(
        ServiceRequestFieldValueDto value)
    {
        if (string.IsNullOrWhiteSpace(value.Value))
        {
            return "-";
        }

        if (value.FieldType == ServiceFieldType.Boolean)
        {
            return string.Equals(
                value.Value,
                "true",
                StringComparison.OrdinalIgnoreCase)
                ? L["Yes"]
                : L["No"];
        }

        if (value.FieldType == ServiceFieldType.MultiChoice)
        {
            return value.Value.Replace(",", ", ");
        }

        return value.Value;
    }

    private string GetMessageTitle(
        ServiceRequestMessageDto message)
    {
        if (message.Type == ServiceRequestMessageType.System &&
            message.EventType.HasValue)
        {
            return L[
                $"ServiceRequestEvent_{message.EventType.Value}"];
        }

        return message.Type switch
        {
            ServiceRequestMessageType.Email =>
                L["Email"],

            ServiceRequestMessageType.Comment =>
                L["Comment"],

            _ =>
                L["Activity"]
        };
    }

    private static string GetMessageIcon(
        ServiceRequestMessageDto message)
    {
        if (message.Type == ServiceRequestMessageType.Email)
        {
            return message.Direction ==
                    ServiceRequestMessageDirection.Inbound
                ? "bi bi-envelope-arrow-down"
                : "bi bi-envelope-arrow-up";
        }

        if (message.Type == ServiceRequestMessageType.Comment)
        {
            return "bi bi-chat-left-text";
        }

        return "bi bi-check-circle";
    }

    private bool CanReplyToMessage(
        ServiceRequestMessageDto message)
    {
        if (request is null ||
            IsClosedStatus(request.Status))
        {
            return false;
        }

        return
            !isProviderUser &&
            latestInboundEmailId.HasValue &&
            latestInboundEmailId.Value == message.Id &&
            message.Type == ServiceRequestMessageType.Email &&
            message.Direction ==
                ServiceRequestMessageDirection.Inbound;
    }

    private static bool IsClosedStatus(
        ServiceRequestStatus status)
    {
        return status is
            ServiceRequestStatus.Completed or
            ServiceRequestStatus.Rejected or
            ServiceRequestStatus.Cancelled or
            ServiceRequestStatus.Failed;
    }

    private void StartReply(
        Guid messageId)
    {
        actionError = null;

        replyingToMessageId =
            messageId;

        replyText =
            string.Empty;
    }

    private void CancelReply()
    {
        replyingToMessageId =
            null;

        replyText =
            string.Empty;
    }

    private async Task SendReplyAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue ||
            !replyingToMessageId.HasValue ||
            string.IsNullOrWhiteSpace(replyText))
        {
            return;
        }

        actionError = null;
        isSendingReply = true;

        try
        {
            await ServiceRequestService
                .ReplyToEmailAsync(
                    accountId.Value,
                    Id,
                    replyingToMessageId.Value,
                    UserContext.Current.UserId,
                    replyText);

            replyingToMessageId =
                null;

            replyText =
                string.Empty;

            await ReloadAsync();
        }
        catch (ServiceRequestValidationException ex)
        {
            actionError =
                ex.Message;
        }
        finally
        {
            isSendingReply =
                false;
        }
    }

    private async Task ApproveAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        actionError = null;
        isProcessing = true;

        try
        {
            await ServiceRequestService
                .ApproveRequestAsync(
                    accountId.Value,
                    Id,
                    UserContext.Current.UserId);

            await ReloadAsync();
        }
        catch (ServiceRequestValidationException ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task StartWorkAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        actionError = null;
        isProcessing = true;

        try
        {
            await ServiceRequestService
                .StartWorkAsync(
                    accountId.Value,
                    Id,
                    UserContext.Current.UserId);

            await ReloadAsync();
        }
        catch (ServiceRequestValidationException ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CompleteAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        actionError = null;
        isProcessing = true;

        try
        {
            await ServiceRequestService
                .CompleteRequestAsync(
                    accountId.Value,
                    Id,
                    UserContext.Current.UserId);

            await ReloadAsync();
        }
        catch (ServiceRequestValidationException ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task AddCommentAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue ||
            string.IsNullOrWhiteSpace(commentText))
        {
            return;
        }

        actionError = null;
        isAddingComment = true;

        try
        {
            await ServiceRequestService
                .AddCommentAsync(
                    accountId.Value,
                    Id,
                    UserContext.Current.UserId,
                    commentText);

            commentText =
                string.Empty;

            await ReloadAsync();
        }
        catch (ServiceRequestValidationException ex)
        {
            actionError = ex.Message;
        }
        finally
        {
            isAddingComment = false;
        }
    }

    private void ToggleMessage(
        Guid messageId)
    {
        if (!expandedMessages.Add(messageId))
        {
            expandedMessages.Remove(messageId);
        }
    }

    private static bool HasHiddenQuotedContent(
        string fullBody,
        string visibleBody)
    {
        return !string.Equals(
            fullBody.Trim(),
            visibleBody.Trim(),
            StringComparison.Ordinal);
    }

    private static string GetVisibleMessageBody(
        string body)
    {
        if (string.IsNullOrWhiteSpace(body))
        {
            return string.Empty;
        }

        var normalized =
            body
                .Replace("\r\n", "\n")
                .Replace('\r', '\n')
                .Trim();

        var cutAt =
            normalized.Length;

        var fixedMarkers =
            new[]
            {
                "\n-----Original Message-----",
                "\n-----Opprinnelig melding-----",
                "\n________________________________",
                "\nFrom:",
                "\nFra:",
                "\nSent:",
                "\nSendt:",
                "\nTo:",
                "\nTil:",
                "\nSubject:",
                "\nEmne:"
            };

        foreach (var marker in fixedMarkers)
        {
            var index =
                normalized.IndexOf(
                    marker,
                    StringComparison.OrdinalIgnoreCase);

            if (index >= 0 &&
                index < cutAt)
            {
                cutAt =
                    index;
            }
        }

        var replyHeaderPatterns =
            new[]
            {
                @"(?im)^\s*On .+ wrote:\s*$",
                @"(?im)^\s*On .+ skrev:\s*$",
                @"(?im)^\s*Den .+ skrev .+:\s*$",
                @"(?im)^\s*Le .+ a écrit\s*:\s*$"
            };

        foreach (var pattern in replyHeaderPatterns)
        {
            var match =
                Regex.Match(
                    normalized,
                    pattern);

            if (match.Success &&
                match.Index < cutAt)
            {
                cutAt =
                    match.Index;
            }
        }

        var quotedLine =
            Regex.Match(
                normalized,
                @"(?m)^\s*>");

        if (quotedLine.Success &&
            quotedLine.Index < cutAt)
        {
            cutAt =
                quotedLine.Index;
        }

        var visible =
            normalized[..cutAt].Trim();

        return string.IsNullOrWhiteSpace(visible)
            ? normalized
            : visible;
    }

    private async Task ReloadAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        canUseProviderPortal =
            await AuthorizationService
                .CanUseProviderPortalAsync();

        request =
            await ServiceRequestService
                .GetRequestAsync(
                    accountId.Value,
                    Id,
                    UserContext.Current.UserId,
                    CultureInfo.CurrentUICulture.Name);

        if (request is null)
        {
            canApprove = false;
            canAssignProvider = false;
            canStartWork = false;
            canComplete = false;

            latestInboundEmailId =
                null;

            return;
        }

        latestInboundEmailId =
            request.Messages
                .Where(x =>
                    x.Type ==
                        ServiceRequestMessageType.Email &&
                    x.Direction ==
                        ServiceRequestMessageDirection.Inbound)
                .OrderByDescending(x => x.CreatedAt)
                .ThenByDescending(x => x.Id)
                .Select(x => (Guid?)x.Id)
                .FirstOrDefault();

        canApprove =
            request.Status ==
                ServiceRequestStatus.Submitted &&
            await AuthorizationService
                .CanApproveServiceRequestAsync(Id);

        canAssignProvider =
            request.Status ==
                ServiceRequestStatus.Approved &&
            string.IsNullOrWhiteSpace(
                request.AssignedServiceProviderOrganizationName) &&
            await AuthorizationService
                .CanApproveServiceRequestAsync(Id);

        canStartWork =
            canUseProviderPortal &&
            request.Status ==
                ServiceRequestStatus.Approved;

        var canAdminComplete =
            (
                request.Status ==
                    ServiceRequestStatus.Approved ||
                request.Status ==
                    ServiceRequestStatus.InProgress
            ) &&
            await AuthorizationService
                .CanCompleteServiceRequestAsync(Id);

        var canProviderComplete =
            canUseProviderPortal &&
            request.Status ==
                ServiceRequestStatus.InProgress;

        canComplete =
            canAdminComplete ||
            canProviderComplete;
    }
}

