@page "/users/create"

@rendermode InteractiveServer

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Localization
@using TenantPlatform.Web.Services.UserAdministration

@inject IUserAdministrationService UserAdministrationService
@inject NavigationManager Navigation

<PageTitle>@L["CreateUser"]</PageTitle>

@if (Model is not null)
{
    <div class="mb-4">
        <a href="/users"
           class="text-decoration-none">
            ← @L["Users"]
        </a>
    </div>

    <h1>@L["CreateUser"]</h1>

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <div class="alert alert-danger mt-3">
            @L[saveError]
        </div>
    }

    <div class="card mt-4">
        <div class="card-body">

            <EditForm Model="Model"
                      OnValidSubmit="CreateAsync"
                      FormName="CreateUser">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <h5 class="mb-3">
                    @L["UserInformation"]
                </h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            @L["FirstName"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="Model.FirstName" />

                        <ValidationMessage For="() => Model.FirstName" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">
                            @L["LastName"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="Model.LastName" />

                        <ValidationMessage For="() => Model.LastName" />
                    </div>

                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["Email"]
                    </label>

                    <InputText class="form-control"
                               type="email"
                               @bind-Value="Model.Email" />

                    <ValidationMessage For="() => Model.Email" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["PreferredLanguage"]
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="Model.PreferredLanguage">

                        @foreach (var language in SupportedLanguages.All)
                        {
                            <option value="@language.Code">
                                @language.DisplayName
                            </option>
                        }

                    </InputSelect>
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.IsActive" />

                    <label class="form-check-label">
                        @L["IsActive"]
                    </label>
                </div>

                <hr />

                <h5 class="mb-3">
                    @L["Authentication"]
                </h5>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.CreateLocalLogin" />

                    <label class="form-check-label">
                        @L["CreateLocalLogin"]
                    </label>
                </div>

                @if (Model.CreateLocalLogin)
                {
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input"
                                       @bind-Value="Model.IsLocalLoginEnabled" />

                        <label class="form-check-label">
                            @L["LocalLoginEnabled"]
                        </label>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            @L["TemporaryPassword"]
                        </label>

                        <InputText class="form-control"
                                   type="password"
                                   autocomplete="new-password"
                                   @bind-Value="Model.TemporaryPassword" />

                        <div class="form-text">
                            @L["TemporaryPasswordHelp"]
                        </div>
                    </div>
                }

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @if (isSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }

                        @(isSaving
                            ? L["Saving"]
                            : L["Create"])

                    </button>

                    <a href="/users"
                       class="btn btn-outline-secondary">

                        @L["Cancel"]

                    </a>

                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    [SupplyParameterFromForm(FormName = "CreateUser")]
    public CreateUserFormModel? Model { get; set; }

    private bool isSaving;

    private string? saveError;

    protected override void OnInitialized()
    {
        Model ??=
            new CreateUserFormModel
            {
                PreferredLanguage =
                    SupportedLanguages.NbNo,

                IsActive =
                    true,

                CreateLocalLogin =
                    true,

                IsLocalLoginEnabled =
                    true
            };
    }

    private async Task CreateAsync()
    {
        if (Model is null)
        {
            return;
        }

        if (Model.CreateLocalLogin &&
            string.IsNullOrWhiteSpace(
                Model.TemporaryPassword))
        {
            saveError =
                "TemporaryPasswordRequired";

            return;
        }

        saveError = null;
        isSaving = true;

        try
        {
            var userId =
                await UserAdministrationService
                    .CreateUserAsync(
                        new CreateUserRequest
                        {
                            FirstName =
                                Model.FirstName,

                            LastName =
                                Model.LastName,

                            Email =
                                Model.Email,

                            PreferredLanguage =
                                Model.PreferredLanguage,

                            IsActive =
                                Model.IsActive,

                            CreateLocalLogin =
                                Model.CreateLocalLogin,

                            IsLocalLoginEnabled =
                                Model.IsLocalLoginEnabled,

                            TemporaryPassword =
                                Model.CreateLocalLogin
                                    ? Model.TemporaryPassword
                                    : null,

                            AccountId =
                                null
                        });

            Navigation.NavigateTo(
                $"/users/{userId}/access");
        }
        catch (InvalidOperationException ex)
        {
            saveError =
                ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public sealed class CreateUserFormModel
    {
        [Required]
        [StringLength(200)]
        public string FirstName { get; set; } =
            string.Empty;

        [Required]
        [StringLength(200)]
        public string LastName { get; set; } =
            string.Empty;

        [Required]
        [EmailAddress]
        [StringLength(320)]
        public string Email { get; set; } =
            string.Empty;

        [Required]
        [StringLength(10)]
        public string PreferredLanguage { get; set; } =
            SupportedLanguages.NbNo;

        public bool IsActive { get; set; } =
            true;

        public bool CreateLocalLogin { get; set; } =
            true;

        public bool IsLocalLoginEnabled { get; set; } =
            true;

        [StringLength(500)]
        public string? TemporaryPassword { get; set; }
    }
}

