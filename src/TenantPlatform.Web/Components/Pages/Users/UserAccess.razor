@page "/users/{Id:guid}/access"

@rendermode InteractiveServer

@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Identity
@using TenantPlatform.Web.Services.UserAdministration

@inject IUserAdministrationService UserAdministrationService
@inject NavigationManager Navigation

<PageTitle>@L["ManageAccess"]</PageTitle>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (user is null)
{
    <div class="alert alert-warning">
        @L["UserNotFound"]
    </div>
}
else
{
    <div class="mb-4">

        <a href="@($"/users/{Id}")"
           class="text-decoration-none">
            ← @L["User"]
        </a>

    </div>

    <div class="mb-4">

        <h1 class="mb-1">
            @L["ManageAccess"]
        </h1>

        <div class="text-body-secondary">
            @GetDisplayName()
            ·
            @user.Email
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(actionError))
    {
        <div class="alert alert-danger">
            @L[actionError]
        </div>
    }

    <div class="card mb-4">

        <div class="card-header">
            <strong>@L["AccountAccess"]</strong>
        </div>

        <div class="card-body p-0">

            @if (user.Accounts.Count == 0)
            {
                <div class="p-3 text-body-secondary">
                    @L["NoAccountAccess"]
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>@L["Account"]</th>
                                <th>@L["Role"]</th>
                                <th>@L["Scope"]</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var account in user.Accounts)
                            {
                                if (account.Roles.Count == 0)
                                {
                                    <tr>

                                        <td>
                                            @account.AccountName
                                        </td>

                                        <td class="text-body-secondary">
                                            @L["NoRoles"]
                                        </td>

                                        <td></td>

                                        <td></td>

                                    </tr>
                                }
                                else
                                {
                                    var first = true;

                                    foreach (var role in account.Roles)
                                    {
                                        <tr>

                                            <td>
                                                @if (first)
                                                {
                                                    @account.AccountName
                                                }
                                            </td>

                                            <td>
                                                @GetRoleDisplayName(
                                                    role.Role)
                                            </td>

                                            <td>
                                                @GetScopeDisplayName(
                                                    role)
                                            </td>

                                            <td class="text-end">

                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        disabled="@isProcessing"
                                                        @onclick="() => RemoveRoleAsync(role.Id)">

                                                    <i class="bi bi-trash me-1"></i>
                                                    @L["Remove"]

                                                </button>

                                            </td>

                                        </tr>

                                        first = false;
                                    }
                                }
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

    <div class="card">

        <div class="card-header">
            <strong>@L["AddRole"]</strong>
        </div>

        <div class="card-body">

            @if (accounts.Count == 0)
            {
                <div class="text-body-secondary">
                    @L["NoAccountsAvailable"]
                </div>
            }
            else
            {
                <div class="mb-3">

                    <label class="form-label">
                        @L["Account"]
                    </label>

                    <select class="form-select"
                            value="@selectedAccountId"
                            @onchange="AccountChangedAsync">

                        @foreach (var account in accounts)
                        {
                            <option value="@account.Id">
                                @account.Name
                            </option>
                        }

                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label">
                        @L["Role"]
                    </label>

                    <select class="form-select"
                            value="@selectedRole"
                            @onchange="RoleChanged">

                        @foreach (var role in Enum.GetValues<UserRole>())
                        {
                            <option value="@role">
                                @GetRoleDisplayName(role)
                            </option>
                        }

                    </select>

                </div>

                @if (selectedRole == UserRole.PropertyAdmin)
                {
                    <div class="mb-3">

                        <label class="form-label">
                            @L["Building"]
                        </label>

                        <select class="form-select"
                                @bind="selectedBuildingId">

                            <option value="">
                                @L["SelectBuilding"]
                            </option>

                            @foreach (var building in buildings)
                            {
                                <option value="@building.Id">
                                    @building.Name
                                </option>
                            }

                        </select>

                    </div>
                }
                else if (RoleRequiresOrganization(selectedRole))
                {
                    <div class="mb-3">

                        <label class="form-label">
                            @L["Organization"]
                        </label>

                        <select class="form-select"
                                @bind="selectedOrganizationId">

                            <option value="">
                                @L["SelectOrganization"]
                            </option>

                            @foreach (var organization in organizations)
                            {
                                <option value="@organization.Id">
                                    @organization.Name
                                </option>
                            }

                        </select>

                    </div>
                }

                <button type="button"
                        class="btn btn-primary"
                        disabled="@isProcessing"
                        @onclick="AddRoleAsync">

                    @if (isProcessing)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="bi bi-plus-lg me-1"></i>
                    }

                    @L["AddRole"]

                </button>
            }

        </div>

    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UserDetailsDto? user;

    private IReadOnlyList<UserAccountOptionDto> accounts =
        Array.Empty<UserAccountOptionDto>();

    private IReadOnlyList<UserOrganizationOptionDto> organizations =
        Array.Empty<UserOrganizationOptionDto>();

    private IReadOnlyList<UserBuildingOptionDto> buildings =
        Array.Empty<UserBuildingOptionDto>();

    private Guid selectedAccountId;

    private UserRole selectedRole =
        UserRole.AccountAdmin;

    private Guid? selectedOrganizationId;

    private Guid? selectedBuildingId;

    private bool isLoading = true;

    private bool isProcessing;

    private string? actionError;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;

        user =
            await UserAdministrationService
                .GetUserAsync(Id);

        if (user is null)
        {
            isLoading = false;
            return;
        }

        accounts =
            await UserAdministrationService
                .GetAvailableAccountsAsync();

        if (accounts.Count > 0)
        {
            selectedAccountId =
                accounts[0].Id;

            await LoadScopeOptionsAsync();
        }

        isLoading = false;
    }

    private async Task AccountChangedAsync(
        ChangeEventArgs args)
    {
        if (!Guid.TryParse(
            args.Value?.ToString(),
            out var accountId))
        {
            return;
        }

        selectedAccountId =
            accountId;

        selectedOrganizationId =
            null;

        selectedBuildingId =
            null;

        await LoadScopeOptionsAsync();
    }

    private void RoleChanged(
        ChangeEventArgs args)
    {
        if (!Enum.TryParse<UserRole>(
            args.Value?.ToString(),
            out var role))
        {
            return;
        }

        selectedRole =
            role;

        selectedOrganizationId =
            null;

        selectedBuildingId =
            null;
    }

    private async Task LoadScopeOptionsAsync()
    {
        if (selectedAccountId == Guid.Empty)
        {
            organizations =
                Array.Empty<UserOrganizationOptionDto>();

            buildings =
                Array.Empty<UserBuildingOptionDto>();

            return;
        }

        organizations =
            await UserAdministrationService
                .GetAvailableOrganizationsAsync(
                    selectedAccountId);

        buildings =
            await UserAdministrationService
                .GetAvailableBuildingsAsync(
                    selectedAccountId);
    }

    private async Task AddRoleAsync()
    {
        if (selectedAccountId == Guid.Empty)
        {
            actionError =
                "AccountRequired";

            return;
        }

        if (selectedRole == UserRole.PropertyAdmin &&
            !selectedBuildingId.HasValue)
        {
            actionError =
                "PropertyAdminRequiresBuilding";

            return;
        }

        if (RoleRequiresOrganization(selectedRole) &&
            !selectedOrganizationId.HasValue)
        {
            actionError =
                "OrganizationRoleRequiresOrganization";

            return;
        }

        actionError = null;
        isProcessing = true;

        try
        {
            await UserAdministrationService
                .AddUserRoleAsync(
                    Id,
                    new AddUserRoleRequest
                    {
                        AccountId =
                            selectedAccountId,

                        Role =
                            selectedRole,

                        OrganizationId =
                            RoleRequiresOrganization(
                                selectedRole)
                                ? selectedOrganizationId
                                : null,

                        BuildingId =
                            selectedRole ==
                                UserRole.PropertyAdmin
                                ? selectedBuildingId
                                : null
                    });

            await ReloadUserAsync();

            selectedOrganizationId =
                null;

            selectedBuildingId =
                null;
        }
        catch (InvalidOperationException ex)
        {
            actionError =
                ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RemoveRoleAsync(
        Guid roleId)
    {
        actionError = null;
        isProcessing = true;

        try
        {
            await UserAdministrationService
                .RemoveUserRoleAsync(
                    Id,
                    roleId);

            await ReloadUserAsync();
        }
        catch (InvalidOperationException ex)
        {
            actionError =
                ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task ReloadUserAsync()
    {
        user =
            await UserAdministrationService
                .GetUserAsync(Id);
    }

    private static bool RoleRequiresOrganization(
        UserRole role)
    {
        return role is
            UserRole.TenantAdmin or
            UserRole.TenantUser or
            UserRole.ServiceProviderUser;
    }

    private string GetDisplayName()
    {
        if (user is null)
        {
            return string.Empty;
        }

        var name =
            $"{user.FirstName} {user.LastName}"
                .Trim();

        return string.IsNullOrWhiteSpace(name)
            ? user.Email
            : name;
    }

    private string GetRoleDisplayName(
        UserRole role)
    {
        return role switch
        {
            UserRole.AccountAdmin =>
                L["AccountAdmin"],

            UserRole.PropertyAdmin =>
                L["PropertyAdmin"],

            UserRole.TenantAdmin =>
                L["TenantAdmin"],

            UserRole.TenantUser =>
                L["TenantUser"],

            UserRole.ServiceProviderUser =>
                L["ServiceProviderUser"],

            _ =>
                role.ToString()
        };
    }

    private string GetScopeDisplayName(
        UserRoleAssignmentDto role)
    {
        if (!string.IsNullOrWhiteSpace(
            role.BuildingName))
        {
            return $"{L["Building"]}: {role.BuildingName}";
        }

        if (!string.IsNullOrWhiteSpace(
            role.OrganizationName))
        {
            return $"{L["Organization"]}: {role.OrganizationName}";
        }

        return L["EntireAccount"];
    }
}

