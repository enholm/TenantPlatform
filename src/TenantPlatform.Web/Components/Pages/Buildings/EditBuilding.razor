@page "/buildings/{Id:guid}/edit"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.Buildings

@inject IBuildingService BuildingService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L["EditBuilding"]</PageTitle>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (notFound)
{
    <div class="alert alert-warning">
        @L["BuildingNotFound"]
    </div>
}
else if (Model is not null)
{
    <div class="mb-4">
        <a href="@($"/buildings/{Id}")"
           class="text-decoration-none">
            ← @L["Building"]
        </a>
    </div>

    <h1>@L["EditBuilding"]</h1>

    <div class="card mt-4">
        <div class="card-body">

            <EditForm Model="Model!"
                      OnValidSubmit="SaveAsync"
                      FormName="EditBuilding">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">
                        @L["Name"]
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Model!.Name" />

                    <ValidationMessage For="() => Model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["Address"]
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Model!.AddressLine1" />
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">
                            @L["PostalCode"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="Model!.PostalCode" />
                    </div>

                    <div class="col-md-8 mb-3">
                        <label class="form-label">
                            @L["City"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="Model!.City" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["Country"]
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Model!.CountryCode" />

                    <ValidationMessage For="() => Model.CountryCode" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">
                        @(isSaving ? L["Saving"] : L["Save"])
                    </button>

                    <a href="@($"/buildings/{Id}")"
                       class="btn btn-outline-secondary">
                        @L["Cancel"]
                    </a>
                </div>

            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool isLoading = true;
    private bool isSaving;
    private bool notFound;


    [SupplyParameterFromForm(FormName = "EditBuilding")]
    public EditBuildingFormModel? Model { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        var canEdit =
            await AuthorizationService.CanEditBuildingAsync(Id);

        if (!canEdit)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        // Ved POST er Model allerede fylt fra skjemaet.
        if (Model is not null)
        {
            isLoading = false;
            return;
        }

        // Første GET: hent eksisterende verdier fra databasen.
        var building =
            await BuildingService.GetBuildingAsync(
                accountId.Value,
                Id);

        if (building is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        Model = new EditBuildingFormModel
        {
            Name = building.Name,
            AddressLine1 = building.AddressLine1,
            PostalCode = building.PostalCode,
            City = building.City,
            CountryCode = building.CountryCode ?? "NO"
        };

        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (Model is null)
        {
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        // Autorisasjon sjekkes også ved selve skriveoperasjonen.
        if (!await AuthorizationService.CanEditBuildingAsync(Id))
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        isSaving = true;

        try
        {
            await BuildingService.UpdateBuildingAsync(
                accountId.Value,
                Id,
                new UpdateBuildingRequest
                {
                    Name = Model.Name,
                    AddressLine1 = Model.AddressLine1,
                    PostalCode = Model.PostalCode,
                    City = Model.City,
                    CountryCode = Model.CountryCode
                });

            Navigation.NavigateTo(
                $"/buildings/{Id}");
        }
        finally
        {
            isSaving = false;
        }
    }

    public sealed class EditBuildingFormModel
    {
        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [StringLength(300)]
        public string? AddressLine1 { get; set; }

        [StringLength(20)]
        public string? PostalCode { get; set; }

        [StringLength(100)]
        public string? City { get; set; }

        [Required]
        [StringLength(2, MinimumLength = 2)]
        public string CountryCode { get; set; } = "NO";
    }
}