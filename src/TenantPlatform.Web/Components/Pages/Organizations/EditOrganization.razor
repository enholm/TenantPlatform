@page "/organizations/{Id:guid}/edit"
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Organizations
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.Organizations

@inject IOrganizationService OrganizationService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L["EditOrganization"]</PageTitle>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (notFound)
{
    <div class="alert alert-warning">
        @L["OrganizationNotFound"]
    </div>
}
else if (Model is not null)
{
    <div class="mb-4">
        <a href="@($"/organizations/{Id}")"
           class="text-decoration-none">
            ← @L["Organization"]
        </a>
    </div>

    <h1>@L["EditOrganization"]</h1>

    <div class="card mt-4">
        <div class="card-body">

            <EditForm Model="Model"
                      OnValidSubmit="SaveAsync"
                      FormName="EditOrganization">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="mb-3">
                    <label class="form-label">
                        @L["Name"]
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Model.Name" />

                    <ValidationMessage For="() => Model.Name" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["OrganizationNumber"]
                    </label>

                    <InputText class="form-control"
                               @bind-Value="Model.OrganizationNumber" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        @L["OrganizationType"]
                    </label>

                    <InputSelect class="form-select"
                                 @bind-Value="Model.Type">
                        <option value="@OrganizationType.PropertyManager">
                            @L["OrganizationTypePropertyManager"]
                        </option>

                        <option value="@OrganizationType.Tenant">
                            @L["OrganizationTypeTenant"]
                        </option>
                    </InputSelect>
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.IsActive" />

                    <label class="form-check-label">
                        @L["IsActive"]
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">
                        @(isSaving
                            ? L["Saving"]
                            : L["Save"])
                    </button>

                    <a href="@($"/organizations/{Id}")"
                       class="btn btn-outline-secondary">
                        @L["Cancel"]
                    </a>
                </div>

            </EditForm>

        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [SupplyParameterFromForm(FormName = "EditOrganization")]
    public EditOrganizationFormModel? Model { get; set; }

    private bool isLoading = true;
    private bool isSaving;
    private bool notFound;

    protected override async Task OnInitializedAsync()
    {
        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!await AuthorizationService
                .CanEditOrganizationAsync(Id))
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        if (Model is not null)
        {
            isLoading = false;
            return;
        }

        var organization =
            await OrganizationService.GetOrganizationAsync(
                accountId.Value,
                Id);

        if (organization is null)
        {
            notFound = true;
            isLoading = false;
            return;
        }

        Model = new EditOrganizationFormModel
        {
            Name = organization.Name,
            OrganizationNumber =
                organization.OrganizationNumber,
            Type = organization.Type,
            IsActive = organization.IsActive
        };

        isLoading = false;
    }

    private async Task SaveAsync()
    {
        if (Model is null)
        {
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        if (!await AuthorizationService
                .CanEditOrganizationAsync(Id))
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        isSaving = true;

        try
        {
            await OrganizationService.UpdateOrganizationAsync(
                accountId.Value,
                Id,
                new UpdateOrganizationRequest
                {
                    Name = Model.Name,
                    OrganizationNumber =
                        Model.OrganizationNumber,
                    Type = Model.Type,
                    IsActive = Model.IsActive
                });

            Navigation.NavigateTo(
                $"/organizations/{Id}");
        }
        finally
        {
            isSaving = false;
        }
    }

    public sealed class EditOrganizationFormModel
    {
        [Required]
        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [StringLength(50)]
        public string? OrganizationNumber { get; set; }

        [Required]
        public OrganizationType Type { get; set; }

        public bool IsActive { get; set; }
    }
}

