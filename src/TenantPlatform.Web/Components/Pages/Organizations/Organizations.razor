@page "/organizations"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.Organizations

@inject IOrganizationService OrganizationService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject ITenantAuthorizationService AuthorizationService
@inject NavigationManager Navigation

<PageTitle>@L["Organizations"]</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@L["Organizations"]</h1>

        <p class="text-body-secondary mb-0">
            @L["OrganizationsDescription"]
        </p>
    </div>

    @if (canCreate)
    {
        <a href="/organizations/create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            @L["CreateOrganization"]
        </a>
    }
</div>

@if (isLoading)
{
    <p>@L["Loading"]</p>
}
else if (organizations.Count == 0)
{
    <div class="alert alert-info">
        @L["NoOrganizations"]
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@L["Name"]</th>
                        <th>@L["OrganizationNumber"]</th>
                        <th>@L["Type"]</th>
                        <th>@L["Status"]</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var organization in organizations)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @organization.Name
                            </td>

                            <td>
                                @organization.OrganizationNumber
                            </td>

                            <td>
                                @GetOrganizationTypeText(organization.Type)
                            </td>

                            <td>
                                @if (organization.IsActive)
                                {
                                    <span class="badge text-bg-success">
                                        @L["Active"]
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">
                                        @L["Inactive"]
                                    </span>
                                }
                            </td>

                            <td class="text-end">
                                <a href="@($"/organizations/{organization.Id}")"
                                   class="btn btn-outline-secondary btn-sm">
                                    @L["Open"]
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool isLoading = true;
    private bool canCreate;

    private List<OrganizationListItemDto> organizations = [];

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthorizationService.CanManageOrganizationsAsync())
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }
        
        var accountId = UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            isLoading = false;
            return;
        }

        canCreate =
            await AuthorizationService.CanCreateOrganizationAsync();

        organizations =
            await OrganizationService.GetOrganizationsAsync(
                accountId.Value);

        isLoading = false;
    }

    private string GetOrganizationTypeText(
        TenantPlatform.Core.Organizations.OrganizationType type)
    {
        return type switch
        {
            TenantPlatform.Core.Organizations.OrganizationType.PropertyManager
                => L["OrganizationTypePropertyManager"],

            TenantPlatform.Core.Organizations.OrganizationType.Tenant
                => L["OrganizationTypeTenant"],

            TenantPlatform.Core.Organizations.OrganizationType.ServiceProvider =>
                L["OrganizationType_ServiceProvider"],

            _ => type.ToString()
        };
    }
}
