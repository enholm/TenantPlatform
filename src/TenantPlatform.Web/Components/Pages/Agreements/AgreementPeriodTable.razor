<div class="table-responsive"><table class="table table-hover"><thead><tr><th>@L["ProcessingLine"]</th><th>@L["FinanceReferencePeriod"]</th><th>@L["FinanceActualPeriod"]</th><th>@L[Periods.FirstOrDefault()?.Direction == AgreementDirection.Cost ? "FinanceExpectedInvoice" : "FinancePlannedInvoice"]</th><th>@L["FinanceCalculation"]</th><th>@L["FinanceAmount"]</th></tr></thead><tbody>
@foreach(var p in Periods){<tr><td>@p.LineName<details><summary>@L["FinanceVersions"]</summary><p>@L["FinanceLineVersion"]: @p.LineVersionId<br />@L["FinancePriceVersion"]: @p.PriceVersionId</p>@foreach(var d in p.DocumentIds){<p><a href="@($"/agreements/documents/{d}/download")">@L["AgreementDocuments"] · @d</a></p>}</details></td><td>@p.ReferenceFrom.ToString("d") – @p.ReferenceTo.ToString("d")</td><td>@p.From.ToString("d") – @p.To.ToString("d")</td><td>@p.InvoiceDate.ToString("d")</td><td>@p.Quantity × @p.UnitPrice × @p.ActiveDays/@p.ReferenceDays<AgreementAutomaticIndexTrace Adjustments="p.IndexAdjustments" /></td><td>@p.Amount.ToString("N2") @p.Currency</td></tr>}
</tbody></table></div>
@code { [Parameter, EditorRequired] public List<AgreementCalculatedPeriod> Periods {get;set;} = []; }
