@page "/agreements/create"
@page "/agreements/{Id:guid}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAgreementService AgreementsService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<div class="page-workspace">
<PageTitle>@L[Id.HasValue ? "AgreementEdit" : "AgreementCreate"]</PageTitle>
<h1>@L[Id.HasValue ? "AgreementEdit" : "AgreementCreate"]</h1>
@if (error is not null) { <div class="alert alert-danger" role="alert">@L[error]</div> }
@if (loading) { <p>@L["Loading"]</p> }
else if (options is not null)
{
<PageSectionNavigation Sections="@(new (string Id, string Label)[] { ("agreement-fields-overview", L["FollowupContractData"].Value), ("agreement-fields-dimensions", L["Dimensions"].Value), ("agreement-fields-finance", L["FinanceLinesAndForecast"].Value), ("agreement-fields-notice", L["NoticeRules"].Value), ("agreement-fields-location", L["AgreementPlacement"].Value), ("agreement-fields-terms", L["AgreementTerms"].Value) })" />
    <EditForm Model="model" OnValidSubmit="SaveAsync">
    <ValidationSummary class="text-danger" />
    <fieldset disabled="@busy">
        <AgreementFields Model="model" Options="options" DimensionState="dimensionState" CanManage="canManage" Existing="Id.HasValue" OriginalForm="originalForm" />
    <div class="page-form-actions"><button type="submit" class="btn btn-primary">@L["Save"]</button><a class="btn btn-outline-secondary" href="@(Id.HasValue ? $"/agreements/{Id}" : "/agreements")">@L["Cancel"]</a></div>
    </fieldset></EditForm>
}
</div>
@code {
    [Parameter] public Guid? Id { get; set; }
    private SaveAgreementRequest model = new();
    private AgreementForm originalForm;
    private AgreementOptionsDto? options;
    private AgreementDimensionEditState? dimensionState;
    private Guid? loadedAccount, loadedId;
    private bool initialized;
    private Guid accountId;
    private bool loading = true, busy, canManage;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        if (UserContext.Current.CurrentAccountId is not Guid id) { Navigation.NavigateTo("/access-denied"); return; }
        if (initialized && loadedAccount == id && loadedId == Id) return;
        initialized = true; loadedAccount = id; loadedId = Id;
        loading = true; options = null; dimensionState = null; error = null;
        accountId = id;
        try
        {
            if (Id.HasValue)
            {
                var details = await AgreementsService.GetAsync(accountId, Id.Value);
                if (!details.CanEdit) throw new UnauthorizedAccessException();
                model = details; originalForm = details.Form; canManage = details.CanManageAccess;
                dimensionState = new(details.Dimensions, details.Revision);
            }
            else { model = new() { OwnerUserId = UserContext.Current.UserId, Form = AgreementForm.FixedTerm }; originalForm = model.Form; canManage = true; }
            options = await AgreementsService.GetOptionsAsync(accountId, Id);
            if (!Id.HasValue) dimensionState = new(options.Dimensions, model.Revision);
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (Exception) { error = "AgreementOperationFailed"; }
        finally { loading = false; }
    }
    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            var id = Id;
            dimensionState!.ApplyTo(model);
            if (id.HasValue) await AgreementsService.UpdateAsync(accountId, id.Value, model);
            else id = await AgreementsService.CreateAsync(accountId, model);
            Navigation.NavigateTo($"/agreements/{id}");
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (AgreementValidationException ex) { error = ex.Message; }
        catch (Exception) { error = "AgreementOperationFailed"; }
        finally { busy = false; }
    }
}
