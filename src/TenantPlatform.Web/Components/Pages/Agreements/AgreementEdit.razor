@page "/agreements/create"
@page "/agreements/{Id:guid}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAgreementService AgreementsService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L[Id.HasValue ? "AgreementEdit" : "AgreementCreate"]</PageTitle>
<h1>@L[Id.HasValue ? "AgreementEdit" : "AgreementCreate"]</h1>
@if (error is not null) { <div class="alert alert-danger" role="alert">@L[error]</div> }
@if (loading) { <p>@L["Loading"]</p> }
else if (options is not null)
{
    <EditForm Model="model" OnValidSubmit="SaveAsync">
    <ValidationSummary class="text-danger" />
    <fieldset disabled="@busy"><div class="card"><div class="card-body"><div class="row g-3">
        <AgreementFields Model="model" Options="options" CanManage="canManage" Existing="Id.HasValue" OriginalForm="originalForm" />
    </div></div></div>
    <div class="d-flex gap-2 mt-3"><button type="submit" class="btn btn-primary">@L["Save"]</button><a class="btn btn-outline-secondary" href="@(Id.HasValue ? $"/agreements/{Id}" : "/agreements")">@L["Cancel"]</a></div>
    </fieldset></EditForm>
}
@code {
    [Parameter] public Guid? Id { get; set; }
    private SaveAgreementRequest model = new();
    private AgreementForm originalForm;
    private AgreementOptionsDto? options;
    private Guid accountId;
    private bool loading = true, busy, canManage;
    private string? error;
    protected override async Task OnParametersSetAsync()
    {
        loading = true; options = null; error = null;
        if (UserContext.Current.CurrentAccountId is not Guid id) { Navigation.NavigateTo("/access-denied"); return; }
        accountId = id;
        try
        {
            if (Id.HasValue)
            {
                var details = await AgreementsService.GetAsync(accountId, Id.Value);
                if (!details.CanEdit) throw new UnauthorizedAccessException();
                model = details; originalForm = details.Form; canManage = details.CanManageAccess;
            }
            else { model = new() { OwnerUserId = UserContext.Current.UserId, Form = AgreementForm.FixedTerm }; originalForm = model.Form; canManage = true; }
            options = await AgreementsService.GetOptionsAsync(accountId, Id);
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (Exception) { error = "AgreementOperationFailed"; }
        finally { loading = false; }
    }
    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true; error = null;
        try
        {
            var id = Id;
            if (id.HasValue) await AgreementsService.UpdateAsync(accountId, id.Value, model);
            else id = await AgreementsService.CreateAsync(accountId, model);
            Navigation.NavigateTo($"/agreements/{id}");
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (AgreementValidationException ex) { error = ex.Message; }
        catch (Exception) { error = "AgreementOperationFailed"; }
        finally { busy = false; }
    }
}
