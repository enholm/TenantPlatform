@page "/agreements/{AgreementId:guid}/adjustments"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAgreementService Service
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation
@inject ILogger<AgreementAdjustments> Logger
@using System.Text.Json

<PageTitle>@L["ProcessingAdjustments"]</PageTitle>
<a href="@($"/agreements/{AgreementId}/lines")">@L["FinanceLinesAndForecast"]</a>
<h1>@L["ProcessingAdjustments"]</h1>
<p>@L["AutoIndexHelp"]</p>
@if (error is not null) { <div class="alert alert-danger" role="alert">@L[error]</div> }
@if (agreement is not null)
{
    <p><strong>@L["ProcessingIndex"]:</strong> @(agreement.IndexName ?? L["AgreementNone"].Value)</p>
    @if (agreement.IndexSetupNeedsReview) { <div class="alert alert-warning">@L["SimpleIndexReview"]</div> }
    <div class="d-flex gap-3 mb-3">
        <a href="/agreements/indices">@L["ProcessingIndices"]</a>
        <a href="@($"/agreements/{AgreementId}/lines")">@L["FinancePreview"]</a>
        <a href="@($"/agreements/{AgreementId}/basis")">@L["ProcessingGenerate"]</a>
    </div>
}
@if (data is not null)
{
    <h2 class="h5">@L["AutoLegacyHistory"]</h2>
    @if (data.Proposals.Count == 0) { <p>@L["ProcessingEmpty"]</p> }
    @foreach (var p in data.Proposals)
    {
        <div class="card mb-3 p-3">
            <h3 class="h6">@LineName(p.LineId) · @p.OldPrice → @p.NewPrice @lines?.Currency <span class="badge text-bg-secondary">@L[$"ProcessingProposal{p.Status}"]</span></h3>
            <p>@L["FinanceEffectiveFrom"]: @p.EffectiveDate.ToString("d")</p>
            <details><summary>@L["FinanceCalculation"]</summary><AgreementAdjustmentExplanation Calculation="@(JsonSerializer.Deserialize<AgreementAdjustmentCalculation>(p.CalculationJson)!)" /></details>
            <p>@p.Comment · @p.DecidedUtc?.ToString("u") · @p.DecidedByUserId</p>
        </div>
    }
}

@code {
    [Parameter] public Guid AgreementId { get; set; }
    private AgreementProcessingView? data;
    private AgreementLinesDto? lines;
    private AgreementDetailsDto? agreement;
    private string? error;
    private string LineName(Guid id) => lines?.Lines.FirstOrDefault(x => x.Line.Id == id)?.Versions[0].Name ?? id.ToString();
    protected override async Task OnParametersSetAsync()
    {
        error = null;
        try
        {
            var account = UserContext.Current.CurrentAccountId ?? throw new UnauthorizedAccessException();
            agreement = await Service.GetAsync(account, AgreementId);
            lines = await Service.GetLinesAsync(account, AgreementId);
            data = await Service.GetProcessingAsync(account, AgreementId);
        }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (AgreementValidationException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Reading index history failed."); error = "AgreementOperationFailed"; }
    }
}
