@page "/agreements/reminder-settings"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IAgreementFollowupService Service
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation
@inject ILogger<AgreementReminderSettings> Logger
<PageTitle>@L["FollowupAccountSettings"]</PageTitle>
<h1>@L["FollowupAccountSettings"]</h1>
<p>@L["FollowupActivationHelp"]</p>
@if (error is not null) { <div class="alert alert-danger" role="alert">@L[error]</div> }
@if (saved) { <div class="alert alert-success" role="status">@L["FollowupSaved"]</div> }
@if (settings is null) { <p>@L["Loading"]</p> }
else
{
    <div class="card"><div class="card-body"><fieldset disabled="@busy">
        <div class="form-check mb-3"><input id="reminder-enabled" type="checkbox" class="form-check-input" @bind="settings.Enabled" /><label for="reminder-enabled">@L["FollowupEnable"]</label></div>
        <div class="mb-3"><label for="reminder-days" class="form-label">@L["FollowupThresholds"]</label><input id="reminder-days" class="form-control" @bind="days" /></div>
        <div class="mb-3"><label for="reminder-zone" class="form-label">@L["FollowupTimeZone"]</label><input id="reminder-zone" class="form-control" @bind="settings.TimeZoneId" maxlength="100" /></div>
        <div class="mb-3"><label for="reminder-time" class="form-label">@L["FollowupSendAt"]</label><input id="reminder-time" type="time" class="form-control" @bind="settings.SendAt" /></div>
        <button class="btn btn-primary" @onclick="SaveAsync">@L["Save"]</button>
        <a class="btn btn-outline-secondary ms-2" href="/agreements/follow-up">@L["Cancel"]</a>
    </fieldset></div></div>
}
@code {
    private SaveAgreementReminderSettings? settings;
    private string days = "90,30,7";
    private string? error;
    private Guid accountId;
    private bool busy, saved;
    protected override async Task OnInitializedAsync()
    {
        if (UserContext.Current.CurrentAccountId is not Guid id) { Navigation.NavigateTo("/access-denied"); return; }
        accountId = id;
        try { settings = await Service.GetReminderSettingsAsync(id); days = string.Join(",", settings.Days); }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (Exception ex) { Logger.LogError(ex, "Could not load reminder settings."); error = "AgreementOperationFailed"; }
    }
    private async Task SaveAsync()
    {
        if (busy || settings is null) return;
        busy = true; error = null; saved = false;
        try { settings.Days = AgreementReminderSchedule.ParseDays(days); await Service.SaveReminderSettingsAsync(accountId, settings);
            settings = await Service.GetReminderSettingsAsync(accountId); saved = true; }
        catch (UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); }
        catch (AgreementValidationException ex) { error = ex.Message; }
        catch (Exception ex) { Logger.LogError(ex, "Could not save reminder settings."); error = "AgreementOperationFailed"; }
        finally { busy = false; }
    }
}

