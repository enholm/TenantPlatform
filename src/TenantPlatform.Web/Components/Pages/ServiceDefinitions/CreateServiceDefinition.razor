@page "/service-definitions/create"

@rendermode InteractiveServer

@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Localization
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.ServiceDefinitions

@inject IServiceDefinitionService ServiceDefinitionService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L["CreateServiceDefinition"]</PageTitle>

@if (Model is not null)
{
    <div class="mb-4">
        <a href="/service-definitions"
           class="text-decoration-none">
            ← @L["ServiceDefinitions"]
        </a>
    </div>

    <h1>@L["CreateServiceDefinition"]</h1>

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <div class="alert alert-danger mt-3">
            @saveError
        </div>
    }

    <div class="card mt-4">
        <div class="card-body">

            <EditForm Model="Model"
                      OnValidSubmit="CreateAsync"
                      FormName="CreateServiceDefinition">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <h5 class="mb-3">@L["General"]</h5>

                <div class="mb-3">
                    <label class="form-label">@L["Code"]</label>

                    <InputText class="form-control"
                               @bind-Value="Model.Code" />

                    <ValidationMessage For="() => Model.Code" />
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["Category"]</label>

                    <InputText class="form-control"
                               @bind-Value="Model.Category" />
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["HandlerType"]</label>

                    <InputText class="form-control"
                               @bind-Value="Model.HandlerType" />
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["EstimatedDuration"]</label>

                    <InputNumber class="form-control"
                                 @bind-Value="Model.EstimatedDurationMinutes" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.RequiresApproval" />

                    <label class="form-check-label">
                        @L["RequiresApproval"]
                    </label>
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.IsBookableByTenant" />

                    <label class="form-check-label">
                        @L["TenantBookable"]
                    </label>
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.RequiresOccupancy" />

                    <label class="form-check-label">
                        @L["RequiresOccupancy"]
                    </label>

                    <div class="form-text">
                        @L["RequiresOccupancyHelp"]
                    </div>
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.IsActive" />

                    <label class="form-check-label">
                        @L["IsActive"]
                    </label>
                </div>

                <hr />

                <ul class="nav nav-tabs mt-4 mb-3">
                    @for (var i = 0; i < Model.Translations.Count; i++)
                    {
                        var index = i;
                        var translation = Model.Translations[index];

                        var language =
                            SupportedLanguages.All.First(x =>
                                string.Equals(
                                    x.Code,
                                    translation.LanguageCode,
                                    StringComparison.OrdinalIgnoreCase));

                        <li class="nav-item">
                            <button type="button"
                                    class="@GetLanguageTabClass(index)"
                                    @onclick="() => activeLanguageIndex = index">

                                @language.DisplayName

                                @if (!string.IsNullOrWhiteSpace(
                                    translation.Name))
                                {
                                    <span class="ms-1">✓</span>
                                }

                            </button>
                        </li>
                    }
                </ul>

                @if (Model.Translations.Count > 0)
                {
                    var translation =
                        Model.Translations[activeLanguageIndex];

                    <div class="mb-3">
                        <label class="form-label">
                            @L["Name"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="translation.Name" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            @L["Description"]
                        </label>

                        <InputTextArea class="form-control"
                                       rows="4"
                                       @bind-Value="translation.Description" />
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">

                        @(isSaving
                            ? L["Saving"]
                            : L["Create"])

                    </button>

                    <a href="/service-definitions"
                       class="btn btn-outline-secondary">

                        @L["Cancel"]

                    </a>
                </div>

            </EditForm>

        </div>
    </div>
}

@code {

    [SupplyParameterFromForm(FormName = "CreateServiceDefinition")]
    public CreateServiceDefinitionFormModel? Model { get; set; }

    private bool isSaving;

    private string? saveError;

    private int activeLanguageIndex;

    protected override void OnInitialized()
    {
        Model ??= new CreateServiceDefinitionFormModel();

        EnsureTranslations();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthorizationService
            .CanManageServiceDefinitionsAsync())
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!await AuthorizationService
            .CanCreateServiceDefinitionAsync())
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private void EnsureTranslations()
    {
        if (Model is null)
        {
            return;
        }

        foreach (var language in SupportedLanguages.All)
        {
            if (Model.Translations.Any(
                x => string.Equals(
                    x.LanguageCode,
                    language.Code,
                    StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            Model.Translations.Add(
                new TranslationFormModel
                {
                    LanguageCode = language.Code
                });
        }

        Model.Translations =
            SupportedLanguages.All
                .Select(language =>
                    Model.Translations.First(
                        translation =>
                            string.Equals(
                                translation.LanguageCode,
                                language.Code,
                                StringComparison.OrdinalIgnoreCase)))
                .ToList();

        if (activeLanguageIndex >=
            Model.Translations.Count)
        {
            activeLanguageIndex = 0;
        }
    }

    private string GetLanguageTabClass(int index)
    {
        return index == activeLanguageIndex
            ? "nav-link active"
            : "nav-link";
    }

    private async Task CreateAsync()
    {
        if (Model is null)
        {
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        if (!await AuthorizationService
            .CanCreateServiceDefinitionAsync())
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        if (!Model.Translations.Any(
            x => !string.IsNullOrWhiteSpace(x.Name)))
        {
            saveError =
                "At least one language must have a name.";

            return;
        }

        saveError = null;

        isSaving = true;

        try
        {
            var id =
                await ServiceDefinitionService
                    .CreateServiceDefinitionAsync(
                        accountId.Value,
                        new CreateServiceDefinitionRequest
                        {
                            Code =
                                Model.Code,

                            Category =
                                Model.Category,

                            HandlerType =
                                Model.HandlerType,

                            RequiresApproval =
                                Model.RequiresApproval,

                            IsBookableByTenant =
                                Model.IsBookableByTenant,

                            RequiresOccupancy =
                                Model.RequiresOccupancy,

                            EstimatedDurationMinutes =
                                Model.EstimatedDurationMinutes,

                            IsActive =
                                Model.IsActive,

                            Translations =
                                Model.Translations
                                    .Select(x =>
                                        new ServiceDefinitionTranslationRequest
                                        {
                                            LanguageCode =
                                                x.LanguageCode,

                                            Name =
                                                x.Name,

                                            Description =
                                                x.Description
                                        })
                                    .ToList()
                        });

            Navigation.NavigateTo(
                $"/service-definitions/{id}");
        }
        catch (InvalidOperationException ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    public sealed class CreateServiceDefinitionFormModel
    {
        [Required]
        [StringLength(100)]
        public string Code { get; set; } = string.Empty;

        [StringLength(100)]
        public string? Category { get; set; }

        [Required]
        [StringLength(200)]
        public string HandlerType { get; set; } = "Generic";

        public bool RequiresApproval { get; set; }

        public bool IsBookableByTenant { get; set; } = true;

        public bool RequiresOccupancy { get; set; } = true;

        public int? EstimatedDurationMinutes { get; set; }

        public bool IsActive { get; set; } = true;

        public List<TranslationFormModel>
            Translations { get; set; } = [];
    }

    public sealed class TranslationFormModel
    {
        public string LanguageCode { get; set; } = string.Empty;

        [StringLength(200)]
        public string Name { get; set; } = string.Empty;

        [StringLength(2000)]
        public string? Description { get; set; }
    }
}

