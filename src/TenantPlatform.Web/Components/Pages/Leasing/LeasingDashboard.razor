@using System.Text.Json
@inject LeasingService Service
@inject ICurrentUserContextService User
<section class="card mb-4"><div class="card-body"><h2 class="h4">@L["LifeDashboard"]</h2><p>@L["LifeDashboardHelp"]</p><div class="d-flex gap-2 mb-3"><label>@L["PaymentFrom"]<input class="form-control" type="date" @bind="from" /></label><label>@L["PaymentTo"]<input class="form-control" type="date" @bind="to" /></label><button class="btn btn-secondary align-self-end" disabled="@busy" @onclick="Load">@L["Search"]</button></div>
@if(error!=null){<p class="alert alert-danger">@L[error]</p>}
@if(data!=null){<div class="row g-3">
<div class="col-md-3"><a href="@Report(LeasingReportKind.Agreements,new(){Status="LifeActive"})">@L["LifeActive"]: @data.Active</a></div><div class="col-md-3"><a href="@Report(LeasingReportKind.Agreements,new(){DateField=LeasingReportDate.End,From=shownFrom,To=shownTo,AcquisitionsOnly=true,Status="LifeActive"})">@L["LifeExpiring"]: @data.Expiring</a></div><div class="col-md-3"><a href="@Report(LeasingReportKind.Agreements,new(){DateField=LeasingReportDate.Notice,From=shownFrom,To=shownTo,Status="LifeActive"})">@L["LifeNoticeDate"]: @data.Notices</a></div><div class="col-md-3"><a href="@Report(LeasingReportKind.Agreements,new(){DateField=LeasingReportDate.Return,From=shownFrom,To=shownTo,Status="LifeActive"})">@L["LifeReturnDue"]: @data.Returns</a></div>
<div class="col-md-3"><a href="@($"/leasing/followup?to={shownTo:yyyy-MM-dd}")">@L["LifeOpenFollowups"]: @data.OpenTasks</a></div><div class="col-md-3"><a href="@Report(LeasingReportKind.Payments,new(){Status="PaymentNoPlan"})">@L["PaymentNoPlan"]: @data.MissingPlans</a></div><div class="col-md-3"><a href="@Report(LeasingReportKind.InvoiceControl,new(){Status="PaymentBillingVariance"})">@L["PaymentBillingVariance"]: @data.Variances</a></div></div>
@foreach(var entry in data.Reports){<h3 class="h5 mt-3"><a href="@Report(entry.Key,entry.Key==LeasingReportKind.Payments?new(){DateField=LeasingReportDate.Due,From=shownFrom,To=shownTo}:new())">@L[$"LifeReport{entry.Key}"]</a></h3>@foreach(var t in entry.Value.Totals){<p><strong>@t.Currency @(t.Basis==""?"":L[t.Basis])</strong> · @if(entry.Key==LeasingReportKind.Capacity){@L["LifeColumnLimit"] @t.Limit.ToString("N2") <span> · @L["LifeColumnUsed"] @t.Used.ToString("N2") · @L["LifeColumnReserved"] @t.Reserved.ToString("N2") · @L["LifeColumnAvailable"] @t.Available.ToString("N2")</span>}else if(entry.Key==LeasingReportKind.Payments){@L["LifePlannedPayments"] @t.Expected.ToString("N2")}else{<span>@L["PaymentInvoiced"] @t.Invoiced.ToString("N2") · @L["RentalUnallocated"] @t.Unallocated.ToString("N2")</span>} · @L["LifeIncompleteRows"]: @t.Incomplete</p>}}
}
</div></section>
@code{LeasingDashboardResult? data;DateOnly from=DateOnly.FromDateTime(DateTime.Today),to=DateOnly.FromDateTime(DateTime.Today.AddDays(90));DateOnly shownFrom,shownTo;string? error;bool busy;protected override Task OnInitializedAsync()=>Load();async Task Load(){busy=true;error=null;try{data=await Service.GetLeasingDashboardAsync(User.Current.CurrentAccountId??throw new UnauthorizedAccessException(),from,to);shownFrom=from;shownTo=to;}catch(LeasingValidationException ex){error=ex.Message;}catch{error="LeasingFailed";}finally{busy=false;}}string Report(LeasingReportKind kind,LeasingReportFilter filter)=>$"/leasing/reports?kind={(int)kind}&filter={Uri.EscapeDataString(JsonSerializer.Serialize(filter))}";}
