@page "/leasing/reports"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@inject LeasingService Service
@inject ICurrentUserContextService User
@inject NavigationManager Navigation
<div class="leasing-workspace">
<h1>@L["LifeReports"]</h1><p>@L["LifeReportLimitations"]</p>
@if(error!=null){<p class="alert alert-danger">@L[error]</p>}
<EditForm Model="filter" OnValidSubmit="Search"><div class="row g-2"><label class="col-md-4">@L["LifeReport"]<InputSelect class="form-select" @bind-Value="kind">@foreach(var r in Enum.GetValues<LeasingReportKind>()){<option value="@r">@L[$"LifeReport{r}"]</option>}</InputSelect></label><label class="col-md-4">@L["LifeDateField"]<InputSelect class="form-select" @bind-Value="filter.DateField">@foreach(var d in Enum.GetValues<LeasingReportDate>()){<option value="@d">@L[$"LifeDate{d}"]</option>}</InputSelect></label><label class="col-md-2">@L["PaymentFrom"]<InputDate class="form-control" @bind-Value="filter.From" /></label><label class="col-md-2">@L["PaymentTo"]<InputDate class="form-control" @bind-Value="filter.To" /></label>
</div><details class="leasing-disclosure mt-3"><summary>@L["LeasingMoreFilters"]</summary><div class="row g-2"><label class="col-md-3">@L["LeasingFinanceCompany"]<InputSelect class="form-select" @bind-Value="filter.FinanceId"><option value="">@L["AgreementAll"]</option>@foreach(var p in options?.Parties??[]){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label class="col-md-3">@L["LeasingOwner"]<InputSelect class="form-select" @bind-Value="filter.OwnerId"><option value="">@L["AgreementAll"]</option>@foreach(var p in options?.Owners??[]){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label class="col-md-2">@L["LeasingCurrency"]<InputText class="form-control" @bind-Value="filter.Currency" maxlength="3" /></label><label class="col-md-4">@L["Search"]<InputText class="form-control" @bind-Value="filter.Search" /></label>
<label class="col-md-4">@L["Status"]<InputSelect class="form-select" @bind-Value="filter.Status"><option value="">@L["AgreementAll"]</option>@foreach(var key in StatusKeys){<option value="@key">@L[key]</option>}</InputSelect></label><label class="col-md-4"><InputCheckbox @bind-Value="filter.AcquisitionsOnly" /> @L["LifeAcquisitionsOnly"]</label>
@if(kind==LeasingReportKind.Dimensions){<label class="col-md-4">@L["Dimensions"]<InputSelect class="form-select" @bind-Value="filter.DimensionValueId"><option value="">@L["AgreementAll"]</option>@foreach(var d in dimensions?.Dimensions??[]){@foreach(var v in d.Values){<option value="@v.Id">@d.Dimension.Name · @v.Name</option>}}</InputSelect></label>}
</div></details><button class="btn btn-primary my-3" disabled="@busy">@L["Search"]</button></EditForm>
@if(data!=null){<p>@L["LifeGenerated"]: @data.GeneratedUtc · @L["LifeDateField"]: @L[$"LifeDate{applied.DateField}"] · @data.Count</p>
@if(data.CanExport){<a class="btn btn-outline-primary m-1" href="@Export("csv")">CSV</a><a class="btn btn-outline-primary m-1" href="@Export("xlsx")">XLSX</a>}
<div class="leasing-summary-grid my-3">@foreach(var t in data.Totals){<section class="card"><div class="card-body"><h2 class="h6">@t.Currency @(t.Basis==""?"":L[t.Basis])</h2><dl class="leasing-amounts">
@if(data.Kind==LeasingReportKind.Capacity){<dt>@L["LifeColumnLimit"]</dt><dd>@t.Limit.ToString("N2")</dd><dt>@L["LifeColumnUsed"]</dt><dd>@t.Used.ToString("N2")</dd><dt>@L["LifeColumnReserved"]</dt><dd>@t.Reserved.ToString("N2")</dd><dt>@L["LifeColumnAvailable"]</dt><dd>@t.Available.ToString("N2")</dd>}
else if(data.Kind==LeasingReportKind.Payments){<dt>@L["LifeColumnExpected"]</dt><dd>@t.Expected.ToString("N2")</dd>}
else if(data.Kind==LeasingReportKind.InvoiceControl){<dt>@L["LifeColumnExpected"]</dt><dd>@t.Expected.ToString("N2")</dd><dt>@L["LifeColumnInvoiced"]</dt><dd>@t.Invoiced.ToString("N2")</dd><dt>@L["LifeColumnUnallocated"]</dt><dd>@t.Unallocated.ToString("N2")</dd>}
else if(data.Kind!=LeasingReportKind.Equipment){<dt>@L["LifeColumnGross"]</dt><dd>@t.Gross.ToString("N2")</dd>}
</dl><span class="small text-body-secondary">@L["LifeIncompleteRows"]: @t.Incomplete</span></div></section>}</div>
<label class="d-block my-3"><input type="checkbox" class="form-check-input" @bind="allColumns" /> @L["LeasingAllColumns"]</label><div class="table-responsive"><table class="table table-sm"><thead><tr>@foreach(var c in VisibleColumns){<th class="@(Numeric(c)?"leasing-numeric":"")">@L[$"LifeColumn{c}"]</th>}</tr></thead><tbody>@foreach(var r in data.Rows){<tr>@foreach(var c in VisibleColumns){<td class="@(Numeric(c)?"leasing-numeric":"")">@if(c=="Name"){<a href="@r.Link">@r.Name</a>}else{@Display(LeasingReportExport.Value(r,c))}</td>}</tr>}</tbody></table></div><div class="d-flex gap-3"><button class="btn btn-outline-secondary" disabled="@(data.Page<=1)" @onclick="()=>Page(-1)">@L["AgreementPrevious"]</button><span>@data.Count</span><button class="btn btn-outline-secondary" disabled="@(data.Page*50>=data.Count)" @onclick="()=>Page(1)">@L["AgreementNext"]</button></div>}
</div>
@code{
bool allColumns;
IEnumerable<string> VisibleColumns => allColumns ? LeasingReportExport.Columns : (data?.Kind ?? kind) switch
{
    LeasingReportKind.Capacity => ["Name","Finance","Currency","Basis","Limit","Used","Reserved","Available","From","To"],
    LeasingReportKind.Dimensions => ["Name","Reference","Currency","Net","Vat","Gross","Dimensions","NeedsReview","Notes"],
    LeasingReportKind.Payments => ["Name","Finance","Currency","From","To","DueDate","Expected","Version","NeedsReview"],
    LeasingReportKind.InvoiceControl => ["Name","Finance","Currency","DueDate","Expected","Invoiced","Difference","Unallocated","Status","NeedsReview"],
    LeasingReportKind.Equipment => ["Name","Reference","Serial","Location","Owner","Status","Quantity","EventDate","ClosedDate","ClosureKind"],
    _ => ["Name","Reference","Finance","Owner","Currency","PurchaseDate","EndDate","NoticeDate","ReturnDate","Status"]
};
static bool Numeric(string column) => column is "Net" or "Vat" or "Gross" or "Limit" or "Used" or "Reserved" or "Available" or "Expected" or "Invoiced" or "Difference" or "Unallocated" or "Quantity" or "BuyoutAmount";

[SupplyParameterFromQuery(Name="kind")]public int? QueryKind{get;set;}[SupplyParameterFromQuery(Name="filter")]public string? QueryFilter{get;set;}LeasingReportKind kind=LeasingReportKind.Agreements;LeasingReportFilter filter=new(),applied=new();LeasingReportResult? data;LeasingOptions? options;LeasingClassificationCatalog? dimensions;string? error;bool busy;int page=1;Guid account=>User.Current.CurrentAccountId??throw new UnauthorizedAccessException();
IEnumerable<string> StatusKeys=>new[]{"LifeActive","PaymentNoPlan","PaymentPlanActive","LifeUnallocated"}.Concat(Enum.GetNames<LeasingLifecycleStatus>().Select(x=>"LifeStatus"+x)).Concat(Enum.GetNames<LeasingBillingStatus>().Select(x=>"PaymentBilling"+x)).Concat(Enum.GetNames<LeasingFrameworkStatus>().Select(x=>"LeasingStatus"+x));
protected override Task OnParametersSetAsync()=>Run(async()=>{if(QueryKind.HasValue)kind=(LeasingReportKind)QueryKind;if(QueryFilter!=null)filter=JsonSerializer.Deserialize<LeasingReportFilter>(QueryFilter)??new();options=await Service.OptionsAsync(account);dimensions=await Service.ClassificationCatalogAsync(account);await Load();});
async Task Load(){data=await Service.GetLeasingReportAsync(account,kind,filter,page);applied=JsonSerializer.Deserialize<LeasingReportFilter>(JsonSerializer.Serialize(filter))!;}
async Task Run(Func<Task> f){if(busy)return;busy=true;error=null;try{await f();}catch(UnauthorizedAccessException){Navigation.NavigateTo("/access-denied");}catch(LeasingValidationException ex){error=ex.Message;}catch{error="LeasingFailed";}finally{busy=false;}}
Task Search(){page=1;return Run(Load);}Task Page(int change){page+=change;return Run(Load);}string Export(string format)=>$"/leasing/reports/export?kind={(int)data!.Kind}&format={format}&filter={Uri.EscapeDataString(JsonSerializer.Serialize(applied))}";
string Display(object? v)=>v switch{null=>"",DateOnly d=>d.ToString("dd.MM.yyyy"),decimal n=>n.ToString("N2"),bool b=>L[b?"PaymentYes":"PaymentNo"],string s=>L[s],_=>v.ToString()??""};
}
