@page "/leasing/equipment"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@inject LeasingService Service
@inject ICurrentUserContextService User
@inject NavigationManager Navigation
<div class="leasing-workspace">
<h1>@L["LifeEquipment"]</h1><p>@L["LifeEquipmentHelp"]</p>
@if(error!=null){<p class="alert alert-danger" role="alert">@L[error]</p>}
<div class="d-flex flex-wrap gap-2 mb-3"><input class="form-control w-auto" aria-label="@L["Search"]" @bind="search" /><select class="form-select w-auto" aria-label="@L["Status"]" @bind="status"><option value="">@L["AgreementAll"]</option>@foreach(var s in Enum.GetValues<LeasingEquipmentStatus>()){<option value="@s">@L[$"LifeEquipment{s}"]</option>}</select><button class="btn btn-secondary" @onclick="()=>Run(Load)">@L["Search"]</button></div>
@if(rows!=null){<div class="table-responsive"><table class="table"><thead><tr><th>@L["LeasingAcquisition"]</th><th>@L["LifeInternalId"] / @L["LifeSerial"]</th><th>@L["LeasingDescription"]</th><th>@L["LifeLocation"]</th><th>@L["Status"]</th><th>@L["Edit"]</th></tr></thead><tbody>@foreach(var r in rows.Rows){<tr><td><a href="@($"/leasing/acquisitions/{r.AcquisitionId}/lifecycle")">@rows.Acquisitions.GetValueOrDefault(r.AcquisitionId)</a></td><td>@r.InternalId / @r.SerialNumber</td><td>@r.Description</td><td>@rows.Buildings.GetValueOrDefault(r.BuildingId??Guid.Empty)</td><td>@L[$"LifeEquipment{r.Status}"]</td><td><a href="@($"/leasing/equipment?acquisition={r.AcquisitionId}")">@L["Edit"]</a></td></tr>}</tbody></table></div><div class="d-flex gap-3"><button class="btn btn-outline-secondary" disabled="@(rows.Page<=1)" @onclick="()=>Page(-1)">@L["AgreementPrevious"]</button><span>@rows.Count</span><button class="btn btn-outline-secondary" disabled="@(rows.Page*50>=rows.Count)" @onclick="()=>Page(1)">@L["AgreementNext"]</button></div>}
@if(data!=null){<h2 class="h4 mt-4">@data.Acquisition.Name</h2>
@if(data.CanMaintainEquipment){
@foreach(var line in data.Acquisition.Items){<p>@line.Description · @line.Quantity <button class="btn btn-outline-secondary btn-sm" @onclick="()=>Countable(line)">@L[line.CountableEquipment?"LifeDisableUnits":"LifeEnableUnits"]</button></p>}
<div class="d-flex gap-2 flex-wrap">@foreach(var r in data.Equipment.Where(x=>x.Status is LeasingEquipmentStatus.InUse or LeasingEquipmentStatus.PlannedReturn)){<button class="btn btn-outline-secondary" @onclick="()=>Edit(r)">@r.InternalId @r.SerialNumber @r.Description</button>}<button class="btn btn-outline-primary" @onclick="New">@L["LifeNewEquipment"]</button></div>
<h3 class="h5 mt-3">@L[equipment.Id==Guid.Empty?"LifeNewEquipment":"Edit"]</h3>
<EditForm Model="equipment" OnValidSubmit="Save"><fieldset disabled="@busy"><div class="row g-2 mt-3">
<label class="col-md-6">@L["LifeItem"]<InputSelect class="form-select" @bind-Value="equipment.ItemId"><option value="@Guid.Empty">@L["Select"]</option>@foreach(var i in data.Acquisition.Items.Where(x=>x.CountableEquipment)){<option value="@i.Id">@i.Description</option>}</InputSelect></label><label class="col-md-6">@L["LeasingDescription"]<InputText class="form-control" @bind-Value="equipment.Description" /></label>
<label class="col-md-4">@L["LifeInternalId"]<InputText class="form-control" @bind-Value="equipment.InternalId" /></label><label class="col-md-4">@L["LifeSerial"]<InputText class="form-control" @bind-Value="equipment.SerialNumber" /></label><label class="col-md-4">@L["LifeRegisteredDate"]<InputDate class="form-control" @bind-Value="equipment.RegisteredDate" /></label>
<label class="col-md-4">@L["LifeEventDate"]<InputDate class="form-control" @bind-Value="equipment.StatusDate" /></label><label class="col-md-4">@L["Status"]<InputSelect class="form-select" @bind-Value="equipment.Status"><option value="InUse">@L["LifeEquipmentInUse"]</option><option value="PlannedReturn">@L["LifeEquipmentPlannedReturn"]</option></InputSelect></label><label class="col-md-4">@L["LifeLocation"]<InputSelect class="form-select" @bind-Value="equipment.BuildingId"><option value="">@L["DashboardUnspecified"]</option>@foreach(var b in buildings){<option value="@b.Id">@b.Name</option>}</InputSelect></label><label class="col-md-4">@L["LeasingOwner"]<InputSelect class="form-select" @bind-Value="equipment.OwnerUserId"><option value="">@L["DashboardUnspecified"]</option>@foreach(var u in options!.Owners){<option value="@u.Id">@u.Name</option>}</InputSelect></label>
<label class="col-md-6">@L["LifeDocument"]<InputSelect class="form-select" @bind-Value="equipment.SourceDocumentId"><option value="">@L["Select"]</option>@foreach(var d in data.Documents){<option value="@d.Id">@d.FileName</option>}</InputSelect></label><label class="col-md-6">@L["PaymentNotes"]<InputTextArea class="form-control" @bind-Value="equipment.Notes" /></label>
@if(equipment.Id==Guid.Empty){<label class="col-12">@L["LifeBulkSerialHelp"]<InputTextArea class="form-control" @bind-Value="bulk" rows="5" /></label><label class="col-md-3">@L["LifeBulkCount"]<InputNumber class="form-control" @bind-Value="count" min="1" max="1000" /></label>}
<label class="col-12"><InputCheckbox @bind-Value="duplicateConfirmed" /> @L["LifeConfirmSerial"]</label><label class="col-12">@L["PaymentReason"]<InputText class="form-control" @bind-Value="reason" /></label></div><button class="btn btn-primary my-2">@L["Save"]</button></fieldset></EditForm>
}}
</div>
@code{
[SupplyParameterFromQuery(Name="acquisition")]public Guid? Acquisition{get;set;}EquipmentPage? rows;LifecycleDetails? data;LeasingEquipment equipment=new(){RegisteredDate=DateOnly.FromDateTime(DateTime.Today)};LeasingOptions? options;List<LeasingOption> buildings=[];string? error;string search="",reason="",bulk="";LeasingEquipmentStatus? status;int page=1,count=1;bool busy,duplicateConfirmed;Guid account=>User.Current.CurrentAccountId??throw new UnauthorizedAccessException();
protected override Task OnParametersSetAsync()=>Run(Load);
async Task Load(){rows=await Service.ListEquipmentAsync(account,search,status,Acquisition,page);if(Acquisition.HasValue){data=await Service.GetLifecycleAsync(account,Acquisition.Value);options=await Service.OptionsAsync(account);buildings=await Service.EquipmentBuildingsAsync(account);}}
async Task Run(Func<Task> f){if(busy)return;busy=true;error=null;try{await f();}catch(UnauthorizedAccessException){Navigation.NavigateTo("/access-denied");}catch(LeasingValidationException ex){error=ex.Message;}catch{error="LeasingFailed";}finally{busy=false;}}
Task Page(int change){page+=change;return Run(Load);}void New(){equipment=new(){RegisteredDate=DateOnly.FromDateTime(DateTime.Today)};bulk="";count=1;duplicateConfirmed=false;}void Edit(LeasingEquipment e){equipment=JsonSerializer.Deserialize<LeasingEquipment>(JsonSerializer.Serialize(e))!;bulk="";count=1;}
Task Countable(LeasingItem item)=>Run(async()=>{await Service.SetCountableAsync(account,Acquisition!.Value,item.Id,!item.CountableEquipment,L["LifeCountableChange"]);await Load();});
Task Save()=>Run(async()=>{if(equipment.ItemId==Guid.Empty)throw new LeasingValidationException("LifeSelectEquipmentItem");var list=new List<LeasingEquipment>();if(equipment.Id!=Guid.Empty)list.Add(equipment);else if(!string.IsNullOrWhiteSpace(bulk)){foreach(var line in bulk.Split('\n',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries)){var cells=line.Split(';');var e=JsonSerializer.Deserialize<LeasingEquipment>(JsonSerializer.Serialize(equipment))!;e.SerialNumber=cells[0];e.InternalId=cells.Length>1?cells[1]:null;list.Add(e);}}else for(var i=0;i<count;i++)list.Add(JsonSerializer.Deserialize<LeasingEquipment>(JsonSerializer.Serialize(equipment))!);await Service.SaveEquipmentAsync(account,Acquisition!.Value,list,duplicateConfirmed,reason,Guid.NewGuid());New();await Load();});
}
