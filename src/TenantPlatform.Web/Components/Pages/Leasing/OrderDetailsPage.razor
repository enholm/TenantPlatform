@page "/leasing/purchase-orders/{Id:guid}"
@using System.Text.Json
@attribute [Authorize]
@rendermode InteractiveServer
@inject LeasingService Service
@inject ICurrentUserContextService User
@inject NavigationManager Navigation
<div class="leasing-workspace">
<h1>@L["PurchaseOrders"] · @data?.Order.Number</h1>
@if(error!=null) { <p class="alert alert-danger">@L[error]</p> }
@if(data is {} d)
{
    var o=d.Order; var reserved=LeasingOrderCalculator.Reserved(o,d.Framework.IncludesVat);
    <p>@L["PurchaseOrderHelp"]</p>
    <p><span class="leasing-status">@L[$"OrderStatus{o.Status}"]</span> · @L[LeasingService.FulfillmentKey(o)] · <a href="@($"/leasing/frameworks/{o.FrameworkId}")">@d.Framework.Name</a></p>
    <div class="row g-3 mb-4"><div class="col-lg-6"><section class="card h-100"><div class="card-body"><h2 class="h6">@L["LeasingDetails"]</h2><dl class="leasing-amounts">
        <dt>@L["LeasingSupplier"]</dt><dd>@Name(o.SupplierOrganizationId)</dd><dt>@L["LeasingOwner"]</dt><dd>@Name(o.OwnerUserId)</dd><dt>@L["OrderDate"]</dt><dd>@o.OrderDate.ToString("dd.MM.yyyy")</dd><dt>@L["OrderExpected"]</dt><dd>@o.ExpectedDate?.ToString("dd.MM.yyyy")</dd>
    </dl></div></section></div><div class="col-lg-6"><section class="card h-100"><div class="card-body"><h2 class="h6">@L["LeasingCapacity"] · @o.Currency · @L[d.Framework.IncludesVat ? "LeasingGross" : "LeasingNet"]</h2><dl class="leasing-amounts">
        <dt>@L["LeasingLimit"]</dt><dd>@d.Capacity.Limit.ToString("N2")</dd><dt>@L["LeasingUsed"]</dt><dd>@d.Capacity.Used.ToString("N2")</dd><dt>@L["OrderReserved"]</dt><dd>@d.Capacity.Reserved.ToString("N2")</dd><dt>@L["LeasingAvailable"]</dt><dd class="fw-semibold">@d.Capacity.Available.ToString("N2")</dd>
    </dl></div></section></div></div>
    @if(d.NeedsReview) { <p class="alert alert-warning">@L["OrderNeedsReview"]</p> }
    <div class="d-flex flex-wrap gap-2 mb-3">@if(d.CanEdit) { <a class="btn btn-outline-primary" href="@($"/leasing/purchase-orders/{Id}/edit")">@L["Edit"]</a> }
    @if(d.CanEdit && o.Status==LeasingOrderStatus.Approved) { <a class="btn btn-primary" href="@($"/leasing/acquisitions/create?framework={o.FrameworkId}&order={Id}")">@L["OrderRealize"]</a> }
    <a class="btn btn-outline-primary" href="@($"/leasing/invoices?order={Id}")">@L["InvoiceImport"]</a></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>@L["LeasingDescription"]</th><th>@L["OrderMethod"]</th><th>@L["LeasingQuantity"]</th><th>@L["OrderRealized"]</th><th>@L["OrderRemaining"]</th><th>@L["OrderReserved"]</th><th>@L["OrderActual"] (@L["LeasingNet"]) / @L["OrderVariance"]</th></tr></thead><tbody>
    @foreach(var line in o.Lines.OrderBy(x=>x.Position))
    {
        var links=d.Realizations.Where(x=>x.OrderLineId==line.Id&&!x.Reversed).ToList();
        <tr><td>@line.Description<br/>@line.ItemNumber</td><td>@L[$"OrderMethod{line.Method}"]</td><td>@line.Quantity @line.Unit</td><td>@line.Fulfilled.ToString("0.####")</td><td>@((line.Scope-line.Fulfilled).ToString("0.####")) @if(line.Unreserved>0) { <span class="text-danger">@L["OrderUnreserved"]: @line.Unreserved</span> }</td><td>@((o.Status==LeasingOrderStatus.Approved?(d.Framework.IncludesVat?LeasingOrderCalculator.Remaining(line).Gross:LeasingOrderCalculator.Remaining(line).Net):0).ToString("N2"))</td><td>@links.Sum(x=>x.ActualNet).ToString("N2") / @links.Sum(x=>x.ActualNet-x.ApprovedNet).ToString("N2")</td></tr>
    }
    </tbody></table></div>
    @if(catalog!=null) { @foreach(var line in o.Lines) { <LeasingClassificationView Item="@LeasingService.OrderClassificationPreview(line,catalog)" Catalog="catalog" /> } }
    <p>@L["LeasingTotals", o.Lines.Sum(x=>LeasingCalculator.Line(x.Item()).Net).ToString("N2"),o.Lines.Sum(x=>LeasingCalculator.Line(x.Item()).Vat).ToString("N2"),o.Lines.Sum(x=>LeasingCalculator.Line(x.Item()).Gross).ToString("N2"),o.Currency]</p>
    <p>@L["OrderApprovedValue"]: @LeasingService.ApprovedOrderValue(d).ToString("N2") · @L["OrderReserved"]: @reserved.ToString("N2")</p>
    <p>@L["OrderDocumented"]: @d.DocumentedNet.ToString("N2") (@L["LeasingNet"])</p>
    <h2 class="h5">@L["LeasingAcquisitions"]</h2><ul>@foreach(var group in d.Realizations.GroupBy(x=>x.AcquisitionId)) { <li><a href="@($"/leasing/acquisitions/{group.Key}")">@group.Key</a> · @group.Sum(x=>x.ActualNet).ToString("N2")</li> }</ul>
    <h2 class="h5">@L["InvoiceDocuments"]</h2><ul>@foreach(var invoice in d.Invoices) { <li><a href="@($"/leasing/invoices/{invoice.Id}")">@invoice.Number</a> · @L[$"InvoiceStatus{invoice.Status}"]</li> }</ul>
    <p style="white-space:pre-wrap">@o.Notes</p>
    <section class="leasing-form-section"><EditForm Model="@this" FormName="order-actions"><fieldset disabled="@busy">
    @if(o.ProposalJson!=null)
    {
        var proposal=JsonSerializer.Deserialize<LeasingOrder>(o.ProposalJson)!;
        <h2 class="h5">@L["OrderProposal"]</h2><p>@L["OrderProposalHelp"]</p>
        <p>@L["LeasingBefore"]: @reserved.ToString("N2") · @L["LeasingAfter"]: @ProposalReserved(proposal).ToString("N2") · @L["OrderAvailableAfter"]: @((d.Capacity.Available+reserved-ProposalReserved(proposal)).ToString("N2"))</p>
        <ul>@foreach(var line in proposal.Lines) { <li>@line.Description · @line.Quantity × @line.UnitPrice · @line.VatPercent %</li> }</ul>
    }
    <label class="d-block">@L["LeasingChangeReason"]<InputTextArea class="form-control mb-2" @bind-Value="reason" /></label>
    @if(d.CanEdit && o.Status is LeasingOrderStatus.Draft or LeasingOrderStatus.Rejected) { <button type="button" class="btn btn-primary" @onclick="()=>Action(LeasingOrderStatus.Pending)">@L["OrderSubmit"]</button> }
    @if(d.CanApprove && (o.Status==LeasingOrderStatus.Pending || o.ProposalJson!=null))
    {
        <p>@L["OrderAvailableAfter"]: @((d.Capacity.Available+reserved-ProposalReserved(o.ProposalJson==null?o:JsonSerializer.Deserialize<LeasingOrder>(o.ProposalJson)!)).ToString("N2"))</p>
        <button type="button" class="btn btn-success" @onclick="()=>Action(LeasingOrderStatus.Approved)">@L["OrderApprove"]</button>
        <button type="button" class="btn btn-outline-danger" @onclick="()=>Action(LeasingOrderStatus.Rejected)">@L["OrderReject"]</button>
    }
    @if(d.CanEdit && o.Status is not (LeasingOrderStatus.Cancelled or LeasingOrderStatus.Closed))
    {
        <p class="mt-3">@L["OrderRelease"]: @reserved.ToString("N2") · @L["OrderAvailableAfter"]: @((d.Capacity.Available+reserved).ToString("N2"))</p>
        <button type="button" class="btn btn-outline-danger" @onclick="()=>Action(LeasingOrderStatus.Cancelled)">@L["OrderCancel"]</button>
        <button type="button" class="btn btn-outline-secondary" @onclick="()=>Action(LeasingOrderStatus.Closed)">@L["OrderClose"]</button>
    }
    @if(o.Lines.Any(x=>x.Unreserved>0) && d.CanApprove && o.Status==LeasingOrderStatus.Approved)
    {
        <p>@L["OrderReopenHelp"]</p><p>@L["OrderAvailableAfter"]: @ReopenAvailable().ToString("N2")</p><button type="button" class="btn btn-outline-primary" @onclick="Reopen">@L["OrderReopen"]</button>
    }
    @if(d.CanEdit && o.Status==LeasingOrderStatus.Approved)
    {
        <h2 class="h5 mt-4">@L["OrderLink"]</h2>
        <label>@L["LeasingAcquisitions"]<InputSelect class="form-select" @bind-Value="linkId" @bind-Value:after="LoadLink"><option value="">@L["LeasingChoose"]</option>@foreach(var a in candidates) { <option value="@a.Id">@a.Name · @a.PurchaseDate</option> }</InputSelect></label>
        @if(link!=null) { <OrderDeliveryEditor Details="d" Delivery="delivery" Items="link.Items" Existing="true" /><button type="button" class="btn btn-primary" @onclick="Link">@L["OrderLink"]</button> }
    }
    </fieldset></EditForm></section>
    <h2 class="h5 mt-4">@L["LeasingDocuments"]</h2><ul>@foreach(var doc in d.Documents) { <li><a href="@($"/leasing/documents/{doc.Id}/download")">@doc.FileName</a></li> }</ul>@if(d.CanEdit) { <InputFile OnChange="Upload" disabled="@busy" /> }
    <details class="leasing-disclosure mt-4"><summary>@L["LeasingHistory"]</summary>
    @foreach(var h in d.History) { <details class="border-bottom py-2"><summary>@h.RecordedUtc.ToString("dd.MM.yyyy HH:mm 'UTC'") · @Name(h.ActorUserId) · @L[$"OrderAction{h.Action}"]</summary><p>@h.Reason</p><div class="row"><div class="col-md-6"><h3 class="h6">@L["LeasingBefore"]</h3><OrderHistorySnapshot Json="h.BeforeJson" /></div><div class="col-md-6"><h3 class="h6">@L["LeasingAfter"]</h3><OrderHistorySnapshot Json="h.AfterJson" /></div></div></details> }
    </details>
}
</div>
@code {
    [Parameter] public Guid Id { get; set; }
    private Guid actionRequest = Guid.NewGuid();
    private Guid account; private bool busy; private string? error; private string reason=""; private OrderDetails? data; private LeasingOptions? options;
    private LeasingClassificationCatalog? catalog;
    private List<LeasingAcquisition> candidates=[]; private Guid? linkId; private LeasingAcquisition? link; private OrderDelivery delivery=new();
    private string Name(Guid id)=>options?.Parties.Concat(options.Owners).FirstOrDefault(x=>x.Id==id)?.Name??id.ToString();
    protected override async Task OnParametersSetAsync() { if(User.Current.CurrentAccountId is not Guid a) { Navigation.NavigateTo("/access-denied"); return; } account=a; await Run(Load); }
    private async Task Load() { data=await Service.GetOrderAsync(account,Id); options=await Service.OptionsAsync(account); catalog=await Service.ClassificationCatalogAsync(account); candidates=await Service.OrderLinkCandidatesAsync(account,Id); delivery=new(){OrderId=Id,Revision=data.Order.Revision}; actionRequest=Guid.NewGuid(); link=null; linkId=null; }
    private decimal ProposalReserved(LeasingOrder proposal) { try { return LeasingService.ProposedReservation(data!.Order,proposal,data.Framework.IncludesVat); } catch { return 0; } }
    private decimal ReopenAvailable() { var copy=JsonSerializer.Deserialize<LeasingOrder>(JsonSerializer.Serialize(data!.Order))!; foreach(var l in copy.Lines) l.Unreserved=0; return data.Capacity.Available+LeasingOrderCalculator.Reserved(data.Order,data.Framework.IncludesVat)-LeasingOrderCalculator.Reserved(copy,data.Framework.IncludesVat); }
    private Task Action(LeasingOrderStatus status)=>Run(async()=>{ await Service.OrderActionAsync(account,Id,data!.Order.Revision,status,reason,actionRequest); await Load(); });
    private Task Reopen()=>Run(async()=>{ await Service.ReopenOrderAsync(account,Id,data!.Order.Revision,reason,actionRequest); await Load(); });
    private async Task LoadLink() { link=linkId.HasValue?(await Service.GetAsync(account,linkId.Value,false)).Acquisition:null; delivery=new(){OrderId=Id,Revision=data!.Order.Revision}; }
    private Task Link()=>Run(async()=>{ delivery.Lines.RemoveAll(x=>x.OrderLineId==Guid.Empty); await Service.LinkOrderAcquisitionAsync(account,link!.Id,link.Revision,delivery); await Load(); });
    private Task Upload(InputFileChangeEventArgs e)=>Run(async()=>{ await using var stream=e.File.OpenReadStream(Service.MaxFileSizeBytes); await Service.UploadOrderAsync(account,Id,data!.Order.Revision,e.File.Name,stream); await Load(); });
    private async Task Run(Func<Task> action) { if(busy)return; busy=true; error=null; try { await action(); } catch(LeasingValidationException e) { error=e.Message; } catch(UnauthorizedAccessException) { Navigation.NavigateTo("/access-denied"); } catch(Exception) { error="LeasingFailed"; } finally { busy=false; } }
}
