@page "/leasing/acquisitions/{Id:guid}/lifecycle"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@inject LeasingService Service
@inject ICurrentUserContextService User
@inject NavigationManager Navigation
<div class="leasing-workspace">
<h1>@L["LifeLifecycle"] – @data?.Acquisition.Name</h1><p>@L["LifeFinancialSeparation"]</p>
@if(error!=null){<p class="alert alert-danger" role="alert">@L[error]</p>}
@if(data!=null){
<div class="d-flex gap-2"><a href="@($"/leasing/acquisitions/{Id}")">@L["LeasingAcquisition"]</a><a href="@($"/leasing/acquisitions/{Id}/payments")">@L["PaymentDetails"]</a><a href="@($"/leasing/equipment?acquisition={Id}")">@L["LifeEquipment"]</a></div>
<p><strong>@L[$"LifeStatus{data.Lifecycle.Status}"]</strong> · @L["LifeOriginalEnd"]: @data.Lifecycle.OriginalEndDate · @L["LifeAgreedEnd"]: @data.Lifecycle.AgreedEndDate · @L["LifeClosedDate"]: @data.Lifecycle.ClosedDate</p>
<p>@L["LifeNoticeDate"]: @(data.Lifecycle.NoticeDate?.ToString("dd.MM.yyyy")??L["DashboardUnspecified"]) · @L[$"LifeNotice{data.Lifecycle.NoticeBasis}"] @data.Lifecycle.NoticeCount</p>
@if(data.Lifecycle.PaymentPlanReviewRequired){<p class="alert alert-warning">@L["LifePlanIncomplete"]</p>}
<section class="card my-3"><div class="card-body"><h2 class="h4">@L["LifeTerms"]</h2><p>@L["LifeDeadlineRule"]</p>
<EditForm Model="terms" OnValidSubmit="SaveTerms"><fieldset disabled="@(!data.CanManage||busy)"><div class="row g-2">
<label class="col-md-4">@L["LifeNoticeBasis"]<InputSelect class="form-select" @bind-Value="terms.NoticeBasis">@foreach(var v in Enum.GetValues<LeasingNoticeBasis>()){<option value="@v">@L[$"LifeNotice{v}"]</option>}</InputSelect></label>
<label class="col-md-4">@L["LifeExplicitNotice"]<InputDate class="form-control" @bind-Value="terms.ExplicitNoticeDate" /></label><label class="col-md-4">@L["LifeNoticeCount"]<InputNumber class="form-control" @bind-Value="terms.NoticeCount" /></label>
<label class="col-md-4">@L["LifeAutomaticExtension"]<InputSelect class="form-select" @bind-Value="terms.AutomaticExtension"><option value="">@L["DashboardUnspecified"]</option><option value="true">@L["PaymentYes"]</option><option value="false">@L["PaymentNo"]</option></InputSelect></label><label class="col-md-4">@L["LifeExtensionMonths"]<InputNumber class="form-control" @bind-Value="terms.ExtensionMonths" /></label><label class="col-md-4">@L["LifeReturnDue"]<InputDate class="form-control" @bind-Value="terms.ReturnDueDate" /></label>
<label class="col-md-6">@L["LeasingOwner"]<InputSelect class="form-select" @bind-Value="terms.OwnerUserId"><option value="">@L["DashboardUnspecified"]</option>@foreach(var u in options!.Owners){<option value="@u.Id">@u.Name</option>}</InputSelect></label><label class="col-md-6">@L["LifeDocument"]<InputSelect class="form-select" @bind-Value="terms.SourceDocumentId"><option value="">@L["Select"]</option>@foreach(var d in data.Documents){<option value="@d.Id">@d.FileName</option>}</InputSelect></label>
<label class="col-12">@L["PaymentNotes"]<InputTextArea class="form-control" @bind-Value="terms.Notes" /></label></div><label class="d-block">@L["PaymentReason"]<InputText class="form-control" @bind-Value="reason" /></label><button class="btn btn-primary my-2">@L["Save"]</button></fieldset></EditForm></div></section>
<section class="card my-3"><div class="card-body"><h2 class="h4">@L["LifeClosureChecklist"]</h2><p>@L["LifeNoBankSettlement"]</p><ul>@foreach(var issue in data.ClosureIssues){<li>@L[issue]</li>}</ul>
<p>@L["LifeDocumentControl"]: @L[data.Lifecycle.DocumentReviewComplete?"PaymentYes":"PaymentNo"]</p>
@if(data.CanApprove){<label class="d-block">@L["PaymentReason"]<input class="form-control" @bind="reason" /></label><button class="btn btn-outline-primary m-1" disabled="@busy" @onclick="()=>Review(false,true)">@L["LifeCompleteDocuments"]</button><button class="btn btn-outline-secondary m-1" disabled="@busy" @onclick="()=>Review(false,false)">@L["LifeReopenDocuments"]</button>
@if(data.Lifecycle.PaymentPlanReviewRequired){<button class="btn btn-outline-primary m-1" disabled="@busy" @onclick="()=>Review(true,true)">@L["LifeConfirmPlan"]</button>}}
</div></section>
@if(data.CanManage){<section class="card my-3"><div class="card-body"><h2 class="h4">@L["LifeNewEvent"]</h2><EditForm Model="proposal" OnValidSubmit="Propose"><fieldset disabled="@busy"><div class="row g-2">
<label class="col-md-4">@L["LifeEventType"]<InputSelect class="form-select" @bind-Value="proposal.Kind">@foreach(var v in Enum.GetValues<LeasingLifecycleKind>().Where(x=>x!=LeasingLifecycleKind.Correct)){<option value="@v">@L[$"LifeKind{v}"]</option>}</InputSelect></label><label class="col-md-4">@L["LifeEventDate"]<InputDate class="form-control" @bind-Value="proposal.Date" /></label><label class="col-md-4">@L["LifeDocument"]<InputSelect class="form-select" @bind-Value="proposal.SourceDocumentId"><option value="">@L["Select"]</option>@foreach(var d in data.Documents){<option value="@d.Id">@d.FileName</option>}</InputSelect></label>
<label class="col-md-6">@L["LifeCounterparty"]<InputSelect class="form-select" @bind-Value="proposal.CounterpartyId"><option value="">@L["Select"]</option>@foreach(var p in options!.Parties){<option value="@p.Id">@p.Name</option>}</InputSelect></label><label class="col-md-6">@L["PaymentReference"]<InputText class="form-control" @bind-Value="proposal.Reference" /></label>
@if(proposal.Kind==LeasingLifecycleKind.Extend){<label class="col-md-4">@L["LifePreviousEnd"]<InputDate class="form-control" @bind-Value="proposal.PreviousEndDate" /></label><label class="col-md-4">@L["LifeNewEnd"]<InputDate class="form-control" @bind-Value="proposal.NewEndDate" /></label><label class="col-md-4"><InputCheckbox @bind-Value="proposal.PaymentsChanged" /> @L["LifePaymentsChanged"]</label><label class="col-12">@L["LifeContinuedTerms"]<InputTextArea class="form-control" @bind-Value="proposal.TermsReference" /></label>}
@if(proposal.Kind is LeasingLifecycleKind.Return or LeasingLifecycleKind.Replace or LeasingLifecycleKind.Buyout or LeasingLifecycleKind.LossOrDamage){<label class="col-md-6">@L["LifeItem"]<InputSelect class="form-select" @bind-Value="proposal.ItemId"><option value="">@L["Select"]</option>@foreach(var i in data.Acquisition.Items){<option value="@i.Id">@i.Description (@i.Quantity)</option>}</InputSelect></label><label class="col-md-3">@L["LeasingQuantity"]<InputNumber class="form-control" @bind-Value="proposal.Quantity" /></label>
@foreach(var unit in data.Equipment.Where(x=>x.ItemId==proposal.ItemId&&x.Status is LeasingEquipmentStatus.InUse or LeasingEquipmentStatus.PlannedReturn)){<label class="col-12"><input type="checkbox" checked="@selected.Contains(unit.Id)" @onchange="e=>Select(unit.Id,(bool)e.Value!)" /> @unit.InternalId · @unit.SerialNumber · @unit.Description</label>}
@if(proposal.Kind==LeasingLifecycleKind.Buyout){<label class="col-md-4">@L["LifeBuyoutAmount"] (@data.Acquisition.Currency)<InputNumber class="form-control" @bind-Value="proposal.BuyoutAmount" /></label>}
@if(proposal.Kind==LeasingLifecycleKind.Replace){<label class="col-md-4">@L["Search"]<input class="form-control" @bind="replacementSearch" /></label><button type="button" class="btn btn-outline-secondary col-md-2" @onclick="FindReplacement">@L["Search"]</button><label class="col-md-6">@L["LifeReplacement"]<InputSelect class="form-select" @bind-Value="proposal.ReplacementEquipmentId"><option value="">@L["Select"]</option>@foreach(var r in replacements){<option value="@r.Id">@r.InternalId · @r.SerialNumber · @r.Description</option>}</InputSelect></label>}}
<label class="col-12">@L["PaymentReason"]<InputTextArea class="form-control" @bind-Value="proposal.Reason" /></label><label class="col-12"><InputCheckbox @bind-Value="proposal.UnresolvedConfirmed" /> @L["LifeConfirmUnresolvedLabel"]</label></div><button class="btn btn-primary my-2">@L["LifeSubmit"]</button></fieldset></EditForm></div></section>}
<details class="my-3"><summary>@L["PaymentHistory"]</summary>@foreach(var h in data.Changes){<p>@h.RecordedUtc · @Name(h.ActorUserId) · @h.Reason</p>@if(h.Action=="LifecycleTerms"){var old=JsonSerializer.Deserialize<LeasingLifecycle>(h.BeforeJson)!;var next=JsonSerializer.Deserialize<LeasingLifecycle>(h.AfterJson)!;<p>@L["LifeNoticeDate"]: @old.NoticeDate → @next.NoticeDate · @L["LifeReturnDue"]: @old.ReturnDueDate → @next.ReturnDueDate · @L["LeasingOwner"]: @Name(old.OwnerUserId) → @Name(next.OwnerUserId)</p>}}</details>
<h2 class="h4">@L["LifeEventHistory"]</h2>
@foreach(var e in data.Events){<details class="border p-3 my-2"><summary>@e.Date · @L[$"LifeKind{e.Kind}"] · @L[$"LifeDecision{e.Decision}"]</summary><p>@e.Reason · @e.Reference · @Name(e.ActorUserId) · @e.RecordedUtc · @Name(e.ApprovedByUserId) · @e.ApprovedUtc</p>@{var input=JsonSerializer.Deserialize<LifecycleEventInput>(e.InputJson)!;}<p>@L["LeasingQuantity"]: @input.Quantity · @L["LifePreviousEnd"]: @input.PreviousEndDate · @L["LifeNewEnd"]: @input.NewEndDate · @L["LifeBuyoutAmount"]: @input.BuyoutAmount @data.Acquisition.Currency</p><p>@input.TermsReference</p>
@if(e.SourceDocumentId.HasValue){<a href="@($"/leasing/documents/{e.SourceDocumentId}/download")">@L["LifeDocument"]</a>}
@if(data.CanApprove){<label class="d-block">@L["PaymentReason"]<input class="form-control" @bind="reason" /></label>@if(e.Decision==LeasingLifecycleDecision.Pending){<button class="btn btn-success m-1" disabled="@busy" @onclick="()=>Decide(e,true)">@L["LifeApprove"]</button><button class="btn btn-outline-danger m-1" disabled="@busy" @onclick="()=>Decide(e,false)">@L["LifeReject"]</button>}@if(e.Decision==LeasingLifecycleDecision.Approved){<button class="btn btn-outline-danger m-1" disabled="@busy" @onclick="()=>Reverse(e)">@L["LifeReverse"]</button>}}
</details>}
}
</div>
@code{
[Parameter]public Guid Id{get;set;}LifecycleDetails? data;LeasingOptions? options;LeasingLifecycle terms=new();LifecycleEventInput proposal=new();string? error;string reason="",replacementSearch="";bool busy;HashSet<Guid> selected=[];List<LeasingEquipment> replacements=[];Guid account=>User.Current.CurrentAccountId??throw new UnauthorizedAccessException();
protected override Task OnParametersSetAsync()=>Run(Load);
string Name(Guid? id)=>options?.Owners.FirstOrDefault(x=>x.Id==id)?.Name??"";
async Task Load(){data=await Service.GetLifecycleAsync(account,Id);terms=JsonSerializer.Deserialize<LeasingLifecycle>(JsonSerializer.Serialize(data.Lifecycle))!;options=await Service.OptionsAsync(account);proposal.PreviousEndDate=data.Lifecycle.AgreedEndDate;}
async Task Run(Func<Task> f){if(busy)return;busy=true;error=null;try{await f();}catch(UnauthorizedAccessException){Navigation.NavigateTo("/access-denied");}catch(LeasingValidationException ex){error=ex.Message;}catch{error="LeasingFailed";}finally{busy=false;}}
Task SaveTerms()=>Run(async()=>{await Service.SaveLifecycleTermsAsync(account,Id,terms,reason,Guid.NewGuid());await Load();});
void Select(Guid id,bool value){if(value)selected.Add(id);else selected.Remove(id);proposal.Quantity=selected.Count;}
Task FindReplacement()=>Run(async()=>replacements=(await Service.ListEquipmentAsync(account,replacementSearch,LeasingEquipmentStatus.InUse)).Rows);
Task Propose()=>Run(async()=>{proposal.EquipmentIds=selected.ToArray();await Service.ProposeLifecycleEventAsync(account,Id,proposal,Guid.NewGuid());proposal=new();selected=[];await Load();});
Task Decide(LeasingLifecycleEvent e,bool approve)=>Run(async()=>{await Service.DecideLifecycleEventAsync(account,e.Id,e.Revision,approve,reason,Guid.NewGuid());await Load();});
Task Reverse(LeasingLifecycleEvent e)=>Run(async()=>{await Service.ReverseLifecycleEventAsync(account,e.Id,e.Revision,reason,Guid.NewGuid());await Load();});
Task Review(bool plan,bool complete)=>Run(async()=>{await Service.ReviewLifecycleDocumentsAsync(account,Id,data!.Lifecycle.Revision,plan,complete,reason,Guid.NewGuid());await Load();});
}
