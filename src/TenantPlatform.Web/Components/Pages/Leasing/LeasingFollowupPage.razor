@page "/leasing/followup"
@attribute [Authorize]
@rendermode InteractiveServer
@using TenantPlatform.Web.Services.Agreements
@using TenantPlatform.Web.Components.Pages.Agreements
@inject LeasingService Service
@inject ICurrentUserContextService User
@inject NavigationManager Navigation
<h1>@L["LifeFollowup"]</h1>
@if(error!=null){<p class="alert alert-danger">@L[error]</p>}
@if(data!=null){
@if(data.Notifications.Count>0){<section class="alert alert-info"><h2 class="h5">@L["LifeNotifications"]</h2>@foreach(var n in data.Notifications){var task=data.NotificationTasks[n.FollowupId];<p><a href="@(task.AcquisitionId.HasValue?$"/leasing/acquisitions/{task.AcquisitionId}/lifecycle":$"/leasing/frameworks/{task.FrameworkId}")">@data.Names.GetValueOrDefault(task.AcquisitionId??task.FrameworkId??Guid.Empty) · @L[$"LifeFollowup{task.Kind}"] · @task.DueDate</a> · @n.DeliveredUtc · @n.DaysBefore @L["LifeDaysBefore"] @if(n.ReadUtc==null){<button class="btn btn-sm btn-outline-primary" @onclick="()=>Read(n.Id)">@L["LifeMarkRead"]</button>}<a href="#tasks">@L["LifeFollowup"]</a></p>}</section>}
<div class="row g-2 mb-3"><label class="col-md-3">@L["LifeFollowupType"]<select class="form-select" @bind="kind"><option value="">@L["AgreementAll"]</option>@foreach(var k in Enum.GetValues<LeasingFollowupKind>()){<option value="@k">@L[$"LifeFollowup{k}"]</option>}</select></label><label class="col-md-3">@L["Status"]<select class="form-select" @bind="status"><option value="">@L["AgreementAll"]</option>@foreach(var s in Enum.GetValues<LeasingFollowupStatus>()){<option value="@s">@L[$"LifeTask{s}"]</option>}</select></label><label class="col-md-3">@L["LifeDueThrough"]<input class="form-control" type="date" @bind="to" /></label><button class="btn btn-secondary col-md-2 align-self-end" @onclick="Search">@L["Search"]</button></div>
<div id="tasks">@foreach(var t in data.Rows){<details class="border p-3 my-2"><summary>@L[$"LifeFollowup{t.Kind}"] · @data.Names.GetValueOrDefault(t.AcquisitionId??t.FrameworkId??Guid.Empty) · @t.DueDate · @L[$"LifeTask{t.Status}"]</summary><a href="@(t.AcquisitionId.HasValue?$"/leasing/acquisitions/{t.AcquisitionId}/lifecycle":$"/leasing/frameworks/{t.FrameworkId}")">@L["LifeOpenObject"]</a><p>@t.Comment · @t.CompletedUtc · @options?.Owners.FirstOrDefault(x=>x.Id==t.CompletedByUserId)?.Name</p>
<EditForm Model="t" OnValidSubmit="()=>Save(t)"><fieldset disabled="@busy"><div class="row g-2"><label class="col-md-4">@L["LeasingOwner"]<InputSelect class="form-select" @bind-Value="t.OwnerUserId"><option value="">@L["DashboardUnspecified"]</option>@foreach(var u in options!.Owners){<option value="@u.Id">@u.Name</option>}</InputSelect></label><label class="col-md-4">@L["Status"]<InputSelect class="form-select" @bind-Value="t.Status">@foreach(var s in Enum.GetValues<LeasingFollowupStatus>().Where(x=>x!=LeasingFollowupStatus.Obsolete)){<option value="@s">@L[$"LifeTask{s}"]</option>}</InputSelect></label><label class="col-12">@L["PaymentReason"]<InputTextArea class="form-control" @bind-Value="t.Comment" /></label></div><button class="btn btn-primary my-2">@L["Save"]</button></fieldset></EditForm></details>}</div>
<div class="d-flex gap-3"><button class="btn btn-outline-secondary" disabled="@(data.Page<=1)" @onclick="()=>Page(-1)">@L["AgreementPrevious"]</button><span>@data.Count</span><button class="btn btn-outline-secondary" disabled="@(data.Page*50>=data.Count)" @onclick="()=>Page(1)">@L["AgreementNext"]</button></div>
}
@if(settings!=null){<details class="card p-3 my-3"><summary>@L["LifeNotificationSettings"]</summary><p>@L["LifeActivationRule"]</p><EditForm Model="settings" OnValidSubmit="SaveSettings"><fieldset disabled="@busy"><label class="d-block"><InputCheckbox @bind-Value="settings.Enabled" /> @L["LifeEnableNotifications"]</label><label class="d-block">@L["LifeNotificationDays"]<InputText class="form-control" @bind-Value="days" /></label><label class="d-block">@L["LifeTimeZone"]<InputSelect class="form-select" @bind-Value="settings.TimeZoneId">@foreach(var z in AgreementTimeZones.Options(settings.TimeZoneId)){<option>@z</option>}</InputSelect></label><p>@L["LifeExtraRecipients"]</p>@foreach(var u in options!.Owners){<label class="d-block"><input type="checkbox" checked="@recipients.Contains(u.Id)" @onchange="e=>Recipient(u.Id,(bool)e.Value!)" /> @u.Name</label>}<label class="d-block">@L["PaymentReason"]<InputText class="form-control" @bind-Value="reason" /></label><button class="btn btn-primary my-2">@L["Save"]</button></fieldset></EditForm>
<h3 class="h5">@L["LifeDeliveryHistory"]</h3>@foreach(var n in deliveryHistory){<p>@n.ScheduledUtc · @options?.Owners.FirstOrDefault(x=>x.Id==n.RecipientUserId)?.Name · @L[$"LifeNotification{n.Status}"] · @(n.ResultKey==null?"":L[n.ResultKey])</p>}
</details>}
@code{
[SupplyParameterFromQuery(Name="to")]public string? QueryTo{get;set;}
TenantPlatform.Web.Services.Leasing.LeasingFollowupPage? data;LeasingOptions? options;LeasingNotificationSettings? settings;List<LeasingNotification> deliveryHistory=[];string? error;string days="90,30,7",reason="";HashSet<Guid> recipients=[];bool busy;int page=1;LeasingFollowupKind? kind;LeasingFollowupStatus? status=LeasingFollowupStatus.Open;DateOnly? to=DateOnly.FromDateTime(DateTime.Today.AddDays(90));Guid account=>User.Current.CurrentAccountId??throw new UnauthorizedAccessException();
protected override Task OnParametersSetAsync()=>Run(async()=>{if(DateOnly.TryParse(QueryTo,out var parsed))to=parsed;await Load();});
async Task Load(){options=await Service.OptionsAsync(account);data=await Service.ListLeasingFollowupsAsync(account,kind,status,to,page:page);if(options.CanCreate){settings=await Service.GetLeasingNotificationSettingsAsync(account);days=string.Join(',',settings.Days);recipients=settings.ExtraRecipientIds.ToHashSet();deliveryHistory=await Service.LeasingNotificationHistoryAsync(account);}}
async Task Run(Func<Task> f){if(busy)return;busy=true;error=null;try{await f();}catch(UnauthorizedAccessException){Navigation.NavigateTo("/access-denied");}catch(LeasingValidationException ex){error=ex.Message;}catch(AgreementValidationException ex){error=ex.Message;}catch{error="LeasingFailed";}finally{busy=false;}}
Task Search(){page=1;return Run(Load);}Task Page(int change){page+=change;return Run(Load);}Task Save(LeasingFollowup t)=>Run(async()=>{await Service.UpdateLeasingFollowupAsync(account,t.Id,t.Revision,t.Status,t.OwnerUserId,t.Comment,Guid.NewGuid());await Load();});
void Recipient(Guid id,bool value){if(value)recipients.Add(id);else recipients.Remove(id);}Task SaveSettings()=>Run(async()=>{settings!.Days=AgreementReminderSchedule.ParseDays(days);settings.ExtraRecipientIds=recipients.ToArray();await Service.SaveLeasingNotificationSettingsAsync(account,settings,reason);await Load();});Task Read(Guid id)=>Run(async()=>{await Service.ReadLeasingNotificationAsync(account,id);await Load();});
}
