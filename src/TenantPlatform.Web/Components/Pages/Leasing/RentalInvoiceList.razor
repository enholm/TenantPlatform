@page "/leasing/rental-invoices"
@attribute [Authorize]
@rendermode InteractiveServer
@using System.Text.Json
@inject LeasingService Service
@inject ICurrentUserContextService User
@inject NavigationManager Navigation
<h1>@L["RentalInvoices"]</h1><p>@L["PaymentScopeHelp"]</p>
@if(error!=null){<p class="alert alert-danger">@L[error]</p>}
@if(canRegister){<button class="btn btn-primary mb-3" disabled="@busy" @onclick="New">@L["RentalNew"]</button><label class="d-block mb-3">@L["RentalUpload"] <InputFile OnChange="Upload" accept=".xml,.pdf,.png,.jpg,.jpeg" disabled="@busy" /></label>}
<div class="d-flex gap-2 flex-wrap mb-3"><input class="form-control w-auto" aria-label="@L["Search"]" @bind="search" placeholder="@L["Search"]" /><input class="form-control w-auto" @bind="currency" maxlength="3" aria-label="@L["LeasingCurrency"]" placeholder="@L["LeasingCurrency"]" /><select class="form-select w-auto" @bind="finance" aria-label="@L["LeasingFinanceCompany"]"><option value="">@L["LeasingFinanceCompany"]</option>@foreach(var p in options?.Parties??[]){<option value="@p.Id">@p.Name</option>}</select><select class="form-select w-auto" @bind="status" aria-label="@L["Status"]"><option value="">@L["Status"]</option>@foreach(var s in Enum.GetValues<LeasingInvoiceStatus>()){<option value="@s">@L[$"InvoiceStatus{s}"]</option>}</select><button class="btn btn-secondary" disabled="@busy" @onclick="()=>Run(Load)">@L["Search"]</button></div>
<div class="table-responsive"><table class="table"><thead><tr><th>@L["LeasingFinanceCompany"]</th><th>@L["LeasingInvoiceNumber"]</th><th>@L["LeasingInvoiceDate"]</th><th>@L["LeasingCurrency"]</th><th>@L["LeasingGross"]</th><th>@L["Status"]</th><th>@L["RentalAllocated"]</th><th>@L["RentalUnallocated"]</th><th>@L["LeasingAcquisition"]</th></tr></thead><tbody>
@foreach(var r in rows){var d=JsonSerializer.Deserialize<RentalInvoiceReview>(r.Invoice.ReviewJson)?.Data;var gross=r.Invoice.Status==LeasingInvoiceStatus.Review?d?.Gross:r.Invoice.Net+r.Invoice.Vat;<tr><td>@r.FinanceName</td><td><a href="@($"/leasing/rental-invoices/{r.Invoice.Id}")">@(string.IsNullOrEmpty(r.Invoice.Number)?L["RentalDraft"]:r.Invoice.Number)</a> · @L[$"InvoiceKind{d?.Kind}"]</td><td>@(r.Invoice.InvoiceDate??d?.Date)</td><td>@r.Invoice.Currency</td><td>@gross?.ToString("N2")</td><td>@L[$"InvoiceStatus{r.Invoice.Status}"] · @L[$"InvoiceProcessing{r.Invoice.Processing}"]</td><td>@((r.AllocatedNet+r.AllocatedVat).ToString("N2"))</td><td>@((gross-r.AllocatedNet-r.AllocatedVat)?.ToString("N2"))</td><td>@string.Join(", ",r.Acquisitions)</td></tr>}
</tbody></table></div>
@foreach(var group in rows.Where(x=>x.Invoice.Status==LeasingInvoiceStatus.Approved).GroupBy(x=>x.Invoice.Currency)){<p>@L["RentalApprovedTotal"] (@group.Key): @group.Sum(x=>(x.Invoice.Kind==LeasingInvoiceKind.CreditNote?-1:1)*(x.Invoice.Net+x.Invoice.Vat)).ToString("N2")</p>}
@code{List<RentalInvoiceRow> rows=[];LeasingOptions? options;string? error;string search="",currency="";Guid? finance;LeasingInvoiceStatus? status;bool busy,canRegister;Guid account=>User.Current.CurrentAccountId??throw new UnauthorizedAccessException();
protected override Task OnInitializedAsync()=>Run(Load);
async Task Load(){options=await Service.OptionsAsync(account);canRegister=await Service.CanRegisterRentalInvoiceAsync(account);rows=await Service.ListRentalInvoicesAsync(account,search,currency.ToUpperInvariant(),finance,status);}
async Task Run(Func<Task> f){if(busy)return;busy=true;error=null;try{await f();}catch(UnauthorizedAccessException){Navigation.NavigateTo("/access-denied");}catch(LeasingValidationException ex){error=ex.Message;}catch{error="LeasingFailed";}finally{busy=false;}}
Task New()=>Run(async()=>{var id=await Service.NewRentalInvoiceAsync(account,Guid.NewGuid());Navigation.NavigateTo($"/leasing/rental-invoices/{id}");});
Task Upload(InputFileChangeEventArgs e)=>Run(async()=>{await using var stream=e.File.OpenReadStream(Service.MaxFileSizeBytes);var id=await Service.UploadRentalInvoiceAsync(account,e.File.Name,stream);Navigation.NavigateTo($"/leasing/rental-invoices/{id}");});}
