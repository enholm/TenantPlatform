@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using TenantPlatform.Web.Components.Pages.Dashboard
@using TenantPlatform.Core.Identity

@using TenantPlatform.Infrastructure.Persistence
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Security.Authorization

@inject ITenantAuthorizationService AuthorizationService

@inject NavigationManager Navigation
@inject IDbContextFactory<TenantPlatformDbContext> DbContextFactory
@inject ICurrentUserContextService UserContext

<PageTitle>Dashboard</PageTitle>
@if (canShowHome)
{
    @if (UserContext.Current.CurrentAccountId is Guid dashboardAccountId)
    {

        <div class="dashboard-grid mb-4">
            <AttentionWidget AccountId="dashboardAccountId" />
            <ContractsWidget AccountId="dashboardAccountId" />
            <InsightsWidget AccountId="dashboardAccountId" />
        </div>
    }
    @if (overviewError)
    {
        <div class="alert alert-warning" role="alert">@L["DashboardLoadError"]</div>
    }
    else if (isLoading)
    {
        <p>Laster dashboard...</p>
    }
    else if (accountName is null)
    {
        <div class="alert alert-warning">
            Ingen aktiv Account er valgt.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Bygg</div>
                        <div class="fs-2 fw-bold">@buildingCount</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Organisasjoner</div>
                        <div class="fs-2 fw-bold">@organizationCount</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Seksjoner / enheter</div>
                        <div class="fs-2 fw-bold">@unitCount</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Åpne bestillinger</div>
                        <div class="fs-2 fw-bold">@openRequestCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                Siste bestillinger
            </div>

            <div class="card-body p-0">
                @if (recentRequests.Count == 0)
                {
                    <div class="p-3 text-muted">
                        Ingen bestillinger ennå.
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Opprettet</th>
                                <th>Status</th>
                                <th>Requester</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in recentRequests)
                            {
                                <tr>
                                    <td>@request.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@request.Status</td>
                                    <td>@request.RequesterName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}
@code {
    private bool isLoading = true;
    private bool overviewError;

    private string? accountName;

    private int buildingCount;
    private int organizationCount;
    private int unitCount;
    private int openRequestCount;

    private List<RecentRequest> recentRequests = [];
    private bool canShowHome;
   protected override async Task OnInitializedAsync()
{
    if (!await AuthorizationService.CanUseHomeAsync())
    {
        var startPage =
            await AuthorizationService.GetStartPageAsync();
        Navigation.NavigateTo(startPage);
        return;
    }

    canShowHome = true;
    var currentAccountId = UserContext.Current.CurrentAccountId;

    if (!currentAccountId.HasValue)
    {
        isLoading = false;
        return;
    }

    try
    {
    await using var dbContext =
        await DbContextFactory.CreateDbContextAsync();

    var accountId = currentAccountId.Value;

    accountName = await dbContext.Accounts
        .Where(x => x.Id == accountId)
        .Select(x => x.Name)
        .SingleOrDefaultAsync();

    // Match the administrative building/request overview's account and building scopes.
    var roles = await dbContext.UserAccountRoles.AsNoTracking()
        .Where(x => x.UserAccount.AccountId == accountId && x.UserAccount.UserId == UserContext.Current.UserId)
        .Select(x => new { x.Role, x.BuildingId }).ToListAsync();
    var isAccountAdmin = roles.Any(x => x.Role == UserRole.AccountAdmin);
    var buildingIds = roles.Where(x => x.Role == UserRole.PropertyAdmin && x.BuildingId.HasValue)
        .Select(x => x.BuildingId!.Value).ToList();
    buildingCount = await dbContext.Buildings
        .CountAsync(x => x.AccountId == accountId && (isAccountAdmin || buildingIds.Contains(x.Id)));

    organizationCount = await dbContext.Organizations
        .CountAsync(x => x.AccountId == accountId);

    unitCount = await dbContext.Units
        .CountAsync(x => x.AccountId == accountId && (isAccountAdmin || buildingIds.Contains(x.BuildingId)));

    openRequestCount = await dbContext.ServiceRequests
        .CountAsync(x =>
            x.AccountId == accountId &&
            (isAccountAdmin || buildingIds.Contains(x.BuildingId)) &&
            x.Status != Core.Services.ServiceRequestStatus.Completed &&
            x.Status != Core.Services.ServiceRequestStatus.Cancelled &&
            x.Status != Core.Services.ServiceRequestStatus.Rejected &&
            x.Status != Core.Services.ServiceRequestStatus.Failed);

    recentRequests = await dbContext.ServiceRequests
        .Where(x => x.AccountId == accountId && (isAccountAdmin || buildingIds.Contains(x.BuildingId)))
        .OrderByDescending(x => x.CreatedAt)
        .Take(10)
        .Join(
            dbContext.Users,
            request => request.RequesterUserId,
            user => user.Id,
            (request, user) => new RecentRequest
            {
                CreatedAt = request.CreatedAt,
                Status = request.Status.ToString(),
                RequesterName =
                    user.FirstName + " " + user.LastName
            })
        .ToListAsync();

    }
    catch (Exception) { overviewError = true; }
    finally { isLoading = false; }
}
    private class RecentRequest
    {
        public DateTimeOffset CreatedAt { get; set; }

        public string Status { get; set; } = string.Empty;

        public string RequesterName { get; set; } = string.Empty;
    }
}
