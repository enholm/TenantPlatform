@page "/"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Application.Dashboard
@using TenantPlatform.Web.Components.Pages.Dashboard
@using TenantPlatform.Core.Identity

@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Security.Authorization

@inject ITenantAuthorizationService AuthorizationService

@inject NavigationManager Navigation
@inject HomeReader Overview
@inject ICurrentUserContextService UserContext

<PageTitle>Dashboard</PageTitle>
@if (canShowHome)
{
    @if (UserContext.Current.CurrentAccountId is Guid dashboardAccountId)
    {

        <div class="dashboard-grid mb-4">
            <AttentionWidget AccountId="dashboardAccountId" />
            <ContractsWidget AccountId="dashboardAccountId" />
            <InsightsWidget AccountId="dashboardAccountId" />
        </div>
    }
    @if (overviewError)
    {
        <div class="alert alert-warning" role="alert">@L["DashboardLoadError"]</div>
    }
    else if (isLoading)
    {
        <p>Laster dashboard...</p>
    }
    else if (accountName is null)
    {
        <div class="alert alert-warning">
            Ingen aktiv Account er valgt.
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Bygg</div>
                        <div class="fs-2 fw-bold">@buildingCount</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Organisasjoner</div>
                        <div class="fs-2 fw-bold">@organizationCount</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Seksjoner / enheter</div>
                        <div class="fs-2 fw-bold">@unitCount</div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="text-muted">Åpne bestillinger</div>
                        <div class="fs-2 fw-bold">@openRequestCount</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                Siste bestillinger
            </div>

            <div class="card-body p-0">
                @if (recentRequests.Count == 0)
                {
                    <div class="p-3 text-muted">
                        Ingen bestillinger ennå.
                    </div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Opprettet</th>
                                <th>Status</th>
                                <th>Requester</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var request in recentRequests)
                            {
                                <tr>
                                    <td>@request.CreatedAt.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>@request.Status</td>
                                    <td>@request.RequesterName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}
@code {
    private bool isLoading = true;
    private bool overviewError;

    private string? accountName;

    private int buildingCount;
    private int organizationCount;
    private int unitCount;
    private int openRequestCount;

    private IReadOnlyList<RecentServiceRequest> recentRequests = [];
    private bool canShowHome;
   protected override async Task OnInitializedAsync()
{
    if (!await AuthorizationService.CanUseHomeAsync())
    {
        var startPage =
            await AuthorizationService.GetStartPageAsync();
        Navigation.NavigateTo(startPage);
        return;
    }

    canShowHome = true;
    var currentAccountId = UserContext.Current.CurrentAccountId;

    if (!currentAccountId.HasValue)
    {
        isLoading = false;
        return;
    }

    try
    {
        var overview = await Overview.ReadAsync(currentAccountId.Value);
        accountName = overview.AccountName;
        buildingCount = overview.BuildingCount;
        organizationCount = overview.OrganizationCount;
        unitCount = overview.UnitCount;
        openRequestCount = overview.OpenRequestCount;
        recentRequests = overview.RecentRequests;

    }
    catch (Exception) { overviewError = true; }
    finally { isLoading = false; }
}
}
