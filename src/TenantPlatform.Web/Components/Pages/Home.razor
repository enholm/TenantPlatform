@page "/"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore

@using TenantPlatform.Infrastructure.Persistence
@using TenantPlatform.Web.Security.CurrentUserContext

@inject IDbContextFactory<TenantPlatformDbContext> DbContextFactory
@inject ICurrentUserContextService UserContext

<PageTitle>Dashboard</PageTitle>

@if (isLoading)
{
    <p>Laster dashboard...</p>
}
else if (accountName is null)
{
    <div class="alert alert-warning">
        Ingen aktiv Account er valgt.
    </div>
}
else
{
    <div class="mb-4">
        <h1>Dashboard</h1>
        <p class="text-muted">@accountName</p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Bygg</div>
                    <div class="fs-2 fw-bold">@buildingCount</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Organisasjoner</div>
                    <div class="fs-2 fw-bold">@organizationCount</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Seksjoner / enheter</div>
                    <div class="fs-2 fw-bold">@unitCount</div>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="text-muted">Åpne bestillinger</div>
                    <div class="fs-2 fw-bold">@openRequestCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            Siste bestillinger
        </div>

        <div class="card-body p-0">
            @if (recentRequests.Count == 0)
            {
                <div class="p-3 text-muted">
                    Ingen bestillinger ennå.
                </div>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Opprettet</th>
                            <th>Status</th>
                            <th>Requester</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var request in recentRequests)
                        {
                            <tr>
                                <td>@request.CreatedAt.LocalDateTime.ToString("g")</td>
                                <td>@request.Status</td>
                                <td>@request.RequesterName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private bool isLoading = true;

    private string? accountName;

    private int buildingCount;
    private int organizationCount;
    private int unitCount;
    private int openRequestCount;

    private List<RecentRequest> recentRequests = [];

   protected override async Task OnInitializedAsync()
{
    var currentAccountId = UserContext.Current.CurrentAccountId;

    if (!currentAccountId.HasValue)
    {
        isLoading = false;
        return;
    }

    await using var dbContext =
        await DbContextFactory.CreateDbContextAsync();

    var accountId = currentAccountId.Value;

    accountName = await dbContext.Accounts
        .Where(x => x.Id == accountId)
        .Select(x => x.Name)
        .SingleOrDefaultAsync();

    buildingCount = await dbContext.Buildings
        .CountAsync(x => x.AccountId == accountId);

    organizationCount = await dbContext.Organizations
        .CountAsync(x => x.AccountId == accountId);

    unitCount = await dbContext.Units
        .CountAsync(x => x.AccountId == accountId);

    openRequestCount = await dbContext.ServiceRequests
        .CountAsync(x =>
            x.AccountId == accountId &&
            x.Status != Core.Services.ServiceRequestStatus.Completed &&
            x.Status != Core.Services.ServiceRequestStatus.Cancelled &&
            x.Status != Core.Services.ServiceRequestStatus.Rejected &&
            x.Status != Core.Services.ServiceRequestStatus.Failed);

    recentRequests = await dbContext.ServiceRequests
        .Where(x => x.AccountId == accountId)
        .OrderByDescending(x => x.CreatedAt)
        .Take(10)
        .Join(
            dbContext.Users,
            request => request.RequesterUserId,
            user => user.Id,
            (request, user) => new RecentRequest
            {
                CreatedAt = request.CreatedAt,
                Status = request.Status.ToString(),
                RequesterName =
                    user.FirstName + " " + user.LastName
            })
        .ToListAsync();

    isLoading = false;
}
    private class RecentRequest
    {
        public DateTimeOffset CreatedAt { get; set; }

        public string Status { get; set; } = string.Empty;

        public string RequesterName { get; set; } = string.Empty;
    }
}
