@page "/service-definitions/{ServiceDefinitionId:guid}/fields/create"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization
@using TenantPlatform.Core.Localization
@using TenantPlatform.Core.Services
@using TenantPlatform.Web.Security.Authorization
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.ServiceDefinitionFields

@inject IServiceDefinitionFieldService FieldService
@inject ITenantAuthorizationService AuthorizationService
@inject ICurrentUserContextService UserContext
@inject NavigationManager Navigation

<PageTitle>@L["AddField"]</PageTitle>

@if (Model is not null)
{
    <div class="mb-4">
        <a href="@($"/service-definitions/{ServiceDefinitionId}")"
           class="text-decoration-none">
            ← @L["ServiceDefinition"]
        </a>
    </div>

    <h1>@L["AddField"]</h1>

    @if (!string.IsNullOrWhiteSpace(saveError))
    {
        <div class="alert alert-danger mt-3">
            @saveError
        </div>
    }

    <div class="card mt-4">
        <div class="card-body">

            <EditForm Model="Model"
                      OnValidSubmit="CreateAsync"
                      FormName="CreateServiceDefinitionField">

                <DataAnnotationsValidator />
                <ValidationSummary />

                <h5 class="mb-3">@L["General"]</h5>

                <div class="mb-3">
                    <label class="form-label">@L["Key"]</label>

                    <InputText class="form-control"
                               @bind-Value="Model.Key" />

                    <ValidationMessage For="() => Model.Key" />

                    <div class="form-text">
                        @L["ServiceFieldKeyHelp"]
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["FieldType"]</label>

                    <InputSelect class="form-select"
                                 @bind-Value="Model.FieldType">

                        @foreach (var fieldType in Enum.GetValues<ServiceFieldType>())
                        {
                            <option value="@fieldType">
                                @GetFieldTypeText(fieldType)
                            </option>
                        }

                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label class="form-label">@L["SortOrder"]</label>

                    <InputNumber class="form-control"
                                 @bind-Value="Model.SortOrder" />
                </div>

                <div class="form-check mb-4">
                    <InputCheckbox class="form-check-input"
                                   @bind-Value="Model.IsRequired" />

                    <label class="form-check-label">
                        @L["Required"]
                    </label>
                </div>

                <div class="mb-4">
                    <label class="form-label">@L["Options"]</label>

                    <InputTextArea class="form-control"
                                   rows="5"
                                   @bind-Value="Model.OptionsText" />

                    <div class="form-text">
                        @L["ServiceFieldOptionsHelp"]
                    </div>
                </div>

                <hr />

                <ul class="nav nav-tabs mt-4 mb-3">
                    @for (var i = 0; i < Model.Translations.Count; i++)
                    {
                        var index = i;
                        var translation = Model.Translations[index];
                        var language = SupportedLanguages.All
                            .First(x => x.Code == translation.LanguageCode);

                        <li class="nav-item">
                            <button type="button"
                                    class="@GetLanguageTabClass(index)"
                                    @onclick="() => activeLanguageIndex = index">
                                @language.DisplayName
                                @if (!string.IsNullOrWhiteSpace(translation.Label))
                                {
                                    <span class="ms-1">✓</span>
                                }
                            </button>
                        </li>
                    }
                </ul>

                @if (Model.Translations.Count > 0)
                {
                    var translation =
                        Model.Translations[activeLanguageIndex];

                    <div class="mb-3">
                        <label class="form-label">
                            @L["Label"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="translation.Label" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            @L["Placeholder"]
                        </label>

                        <InputText class="form-control"
                                   @bind-Value="translation.Placeholder" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label">
                            @L["HelpText"]
                        </label>

                        <InputTextArea class="form-control"
                                       rows="3"
                                       @bind-Value="translation.HelpText" />
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary"
                            disabled="@isSaving">
                        @(isSaving ? L["Saving"] : L["Create"])
                    </button>

                    <a href="@($"/service-definitions/{ServiceDefinitionId}")"
                       class="btn btn-outline-secondary">
                        @L["Cancel"]
                    </a>
                </div>

            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid ServiceDefinitionId { get; set; }

    [SupplyParameterFromForm(
        FormName = "CreateServiceDefinitionField")]
    public CreateFieldFormModel? Model { get; set; }

    private bool isSaving;
    private string? saveError;
    private int activeLanguageIndex;

    protected override void OnInitialized()
    {
        Model ??= new CreateFieldFormModel();

        EnsureTranslations();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthorizationService
            .CanManageServiceDefinitionsAsync())
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        if (!UserContext.Current.CurrentAccountId.HasValue)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (!await AuthorizationService
            .CanEditServiceDefinitionAsync(ServiceDefinitionId))
        {
            Navigation.NavigateTo("/access-denied");
        }
    }

    private void EnsureTranslations()
    {
        if (Model is null)
        {
            return;
        }

        foreach (var language in SupportedLanguages.All)
        {
            if (Model.Translations.Any(
                x => string.Equals(
                    x.LanguageCode,
                    language.Code,
                    StringComparison.OrdinalIgnoreCase)))
            {
                continue;
            }

            Model.Translations.Add(
                new TranslationFormModel
                {
                    LanguageCode = language.Code
                });
        }
    }

    private async Task CreateAsync()
    {
        if (Model is null)
        {
            return;
        }

        var accountId =
            UserContext.Current.CurrentAccountId;

        if (!accountId.HasValue)
        {
            return;
        }

        if (!await AuthorizationService
            .CanEditServiceDefinitionAsync(ServiceDefinitionId))
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        if (!Model.Translations.Any(
            x => !string.IsNullOrWhiteSpace(x.Label)))
        {
            saveError =
                "At least one language must have a label.";

            return;
        }

        saveError = null;
        isSaving = true;

        try
        {
            await FieldService.CreateFieldAsync(
                accountId.Value,
                ServiceDefinitionId,
                new CreateServiceDefinitionFieldRequest
                {
                    Key = Model.Key,
                    FieldType = Model.FieldType,
                    IsRequired = Model.IsRequired,
                    SortOrder = Model.SortOrder,
                    OptionsText = Model.OptionsText,

                    Translations =
                        Model.Translations
                            .Select(x =>
                                new ServiceDefinitionFieldTranslationRequest
                                {
                                    LanguageCode =
                                        x.LanguageCode,

                                    Label =
                                        x.Label,

                                    Placeholder =
                                        x.Placeholder,

                                    HelpText =
                                        x.HelpText
                                })
                            .ToList()
                });

            Navigation.NavigateTo(
                $"/service-definitions/{ServiceDefinitionId}");
        }
        catch (InvalidOperationException ex)
        {
            saveError = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private string GetLanguageTabClass(
        int index)
    {
        return index == activeLanguageIndex
            ? "nav-link active"
            : "nav-link";
    }

    private string GetFieldTypeText(
        ServiceFieldType fieldType)
    {
        return fieldType switch
        {
            ServiceFieldType.Text =>
                L["FieldTypeText"],

            ServiceFieldType.TextArea =>
                L["FieldTypeTextArea"],

            ServiceFieldType.Integer =>
                L["FieldTypeInteger"],

            ServiceFieldType.Decimal =>
                L["FieldTypeDecimal"],

            ServiceFieldType.Boolean =>
                L["FieldTypeBoolean"],

            ServiceFieldType.Date =>
                L["FieldTypeDate"],

            ServiceFieldType.DateTime =>
                L["FieldTypeDateTime"],

            ServiceFieldType.Email =>
                L["FieldTypeEmail"],

            ServiceFieldType.Phone =>
                L["FieldTypePhone"],

            ServiceFieldType.Choice =>
                L["FieldTypeChoice"],

            ServiceFieldType.MultiChoice =>
                L["FieldTypeMultiChoice"],

            _ => fieldType.ToString()
        };
    }

    public sealed class CreateFieldFormModel
    {
        [Required]
        [StringLength(100)]
        public string Key { get; set; } =
            string.Empty;

        public ServiceFieldType FieldType { get; set; } =
            ServiceFieldType.Text;

        public bool IsRequired { get; set; }

        public int SortOrder { get; set; } = 10;

        public string? OptionsText { get; set; }

        public List<TranslationFormModel>
            Translations { get; set; } = [];
    }

    public sealed class TranslationFormModel
    {
        public string LanguageCode { get; set; } =
            string.Empty;

        [StringLength(200)]
        public string Label { get; set; } =
            string.Empty;

        [StringLength(200)]
        public string? Placeholder { get; set; }

        [StringLength(1000)]
        public string? HelpText { get; set; }
    }
}

