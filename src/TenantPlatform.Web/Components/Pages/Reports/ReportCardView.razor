@using TenantPlatform.Core.Reports
@using TenantPlatform.Web.Services.Reports
@implements IAsyncDisposable
@inject IReportPreviewSession Preview

<article class="card report-card h-100 @(Passive ? "report-card-passive" : null)"
         aria-labelledby="@(!TitleHidden ? TitleId : null)" aria-label="@(TitleHidden ? Card.Name : null)"
         data-report-title-placement="@TitlePlacementValue"
         data-report-has-subtitle="@HasSubtitle.ToString().ToLowerInvariant()"
         data-report-preview-passive="@Passive.ToString().ToLowerInvariant()">
    <div class="card-body">
        @if (HasHeaderContent)
        {
        <div class="report-card-heading">
            @if (!TitleHidden)
            {
                <h2 id="@TitleId" class="h5 mb-0 @TitleAlignmentClass">@Card.Name</h2>
            }
            @if (HasSubtitle)
            {
                <p class="report-card-subtitle small text-body-secondary mb-0 @SubtitleAlignmentClass @(TitleHidden ? null : "mt-1")">@Subtitle</p>
            }
        </div>
        }
        @if (loading)
        {
            <p class="text-body-secondary @(HasHeaderContent ? "mt-3" : null)" role="status">
                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>@L["Loading"]
            </p>
        }
        else if (error is not null)
        {
            <div class="alert alert-warning @(HasHeaderContent ? "mt-3" : null) mb-0" role="alert">@L[error]</div>
        }
        else if (Card.Definition.Visualization == ReportVisualization.RelationshipTree)
        {
            @if (Passive && treeResult is not null)
            {
                <ReportTreePreview Result="treeResult" CardName="Card.Name"
                                   ShowDescriptions="@(!TitleHidden)" />
            }
            else if (!Passive && treeResult is not null)
            {
                <ReportTree AccountId="AccountId" Definition="Card.Definition" CardName="Card.Name"
                            InitialPreview="treeResult" />
            }
        }
        else if (result is not null)
        {
            @if (Empty)
            {
                <p class="text-body-secondary @(HasHeaderContent ? "mt-3" : null) mb-0">@L["ReportNoData"]</p>
            }
            else
            {
                <div class="report-kpis @(HasHeaderContent ? "mt-3" : null)">
                    @foreach (var total in result.Totals)
                    {
                        <div class="report-kpi">
                            <div class="report-kpi-value">@Format(total)</div>
                            @if (!string.IsNullOrWhiteSpace(total.Currency))
                            {
                                <div class="report-kpi-label">@total.Currency</div>
                            }
                        </div>
                    }
                </div>

                @if (ChartModel is not null)
                {
                    <ReportChart Model="ChartModel" Interactive="@(!Passive)" @key="Card.Id" />
                    @if (ChartModel.NonAdditive)
                    {
                        <p class="small text-body-secondary mb-0">
                            <i class="bi bi-info-circle me-1" aria-hidden="true"></i>@L["ReportChartNonAdditive"]
                        </p>
                    }
                }
                else if (chartError is not null)
                {
                    <div class="alert alert-warning mt-3" role="alert">@L[chartError]</div>
                }

                @if (result.Groups.Count > 0)
                {
                    <ResultTable Caption="@L["ReportGroupedResults"]">
                        @foreach (var group in result.Groups)
                        {
                            <tr>
                                <th scope="row">@Label(group.Label)</th>
                                <td>@Values(group.Values)</td>
                                <td>@group.UniqueEntityCount</td>
                            </tr>
                        }
                    </ResultTable>
                }
                else if (result.TimeSeries.Count > 0)
                {
                    <ResultTable Caption="@L["ReportTimeResults"]">
                        @foreach (var bucket in result.TimeSeries)
                        {
                            <tr>
                                <th scope="row">@TimeLabel(bucket)</th>
                                <td>@Values(bucket.Values)</td>
                                <td>@bucket.UniqueEntityCount</td>
                            </tr>
                        }
                    </ResultTable>
                }

                @if (result.Table is not null)
                {
                    <div class="table-responsive mt-3">
                        <table class="table table-sm align-middle mb-0">
                            <caption>@L["ReportDetailRows"] (@result.Table.TotalRows)</caption>
                            <thead><tr><th>@L["Name"]</th><th>@L["Reference"]</th><th>@L["Status"]</th><th class="text-end">@L["Value"]</th></tr></thead>
                            <tbody>
                            @foreach (var row in result.Table.Rows)
                            {
                                @if (row is ReportAgreementTableRow agreement)
                                {
                                    <tr>
                                        <th scope="row">
                                            @if (Passive) { @agreement.AgreementTitle }
                                            else { <a href="@($"/agreements/{agreement.AgreementId}")">@agreement.AgreementTitle</a> }
                                        </th>
                                        <td>@agreement.Counterparty</td>
                                        <td>@L[$"AgreementStatus{agreement.Status}"]</td>
                                        <td class="text-end">@Format(agreement.Value, agreement.Currency)</td>
                                    </tr>
                                }
                                else if (row is ReportLeasingTableRow leasing)
                                {
                                    <tr>
                                        <th scope="row">
                                            @if (Passive) { @leasing.Name }
                                            else { <a href="@(leasing.IsFramework ? $"/leasing/frameworks/{leasing.RecordId}" : $"/leasing/acquisitions/{leasing.RecordId}")">@leasing.Name</a> }
                                        </th>
                                        <td>@leasing.Reference</td>
                                        <td>@L[leasing.StatusResourceKey]</td>
                                        <td class="text-end">@Format(leasing.Value, leasing.Currency)</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }

            @if (!TitleHidden && Card.Definition.Visualization is (ReportVisualization.Bar or ReportVisualization.Line or ReportVisualization.Donut))
            {
                <p class="report-card-description small text-body-secondary mt-3 mb-0">@L["ReportChartTableFallback"]</p>
            }
            @foreach (var restriction in result.Metadata.RestrictionResourceKeys)
            {
                <p class="report-card-restriction small text-body-secondary mt-2 mb-0"><i class="bi bi-info-circle me-1" aria-hidden="true"></i>@L[restriction]</p>
            }
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public Guid AccountId { get; set; }
    [Parameter, EditorRequired] public Guid SessionId { get; set; }
    [Parameter, EditorRequired] public ReportCardDto Card { get; set; } = null!;
    [Parameter] public bool Passive { get; set; }
    [Parameter] public long RefreshVersion { get; set; }

    private CancellationTokenSource? loadCancellation;
    private ReportExecutionResult? result;
    private ReportTreePreviewResult? treeResult;
    private ReportChartModel? ChartModel;
    private string? error;
    private string? chartError;
    private string? requestFingerprint;
    private string? presentationFingerprint;
    private long loadedRefreshVersion = -1;
    private long generation;
    private bool loading;

    private string TitleId => $"report-card-title-{Card.Id:N}";
    private bool TitleHidden => Card.Definition.TitlePlacement == ReportTitlePlacement.Hidden;
    private string? Subtitle => Card.Definition.Subtitle;
    private bool HasSubtitle => !string.IsNullOrWhiteSpace(Subtitle);
    private bool HasHeaderContent => !TitleHidden || HasSubtitle;
    private string TitlePlacementValue => Card.Definition.TitlePlacement.ToString().ToLowerInvariant();
    private string TitleAlignmentClass => Card.Definition.TitlePlacement switch
    {
        ReportTitlePlacement.Center => "text-center",
        ReportTitlePlacement.Right => "text-end",
        _ => "text-start"
    };
    private string SubtitleAlignmentClass => TitleHidden ? "text-start" : TitleAlignmentClass;
    private string UnitLabel => result?.Metadata.Unit switch
    {
        ReportValueUnit.Count => L["ReportUnitCount"].Value,
        ReportValueUnit.Amount => L["ReportUnitAmount"].Value,
        _ => string.Empty
    };
    private bool Empty => result is not null && result.Totals.All(x => x.Value == 0) &&
        result.Groups.Count == 0 && result.TimeSeries.All(x => x.Values.All(y => y.Value == 0)) &&
        result.Table is not { TotalRows: > 0 };

    protected override async Task OnParametersSetAsync()
    {
        var nextRequest = $"{SessionId:N}|{AccountId:N}|{Fingerprint(Card.Definition)}";
        var nextPresentation = $"{Card.Name}|{Card.Definition.Visualization}|{Passive}";
        var forceRefresh = loadedRefreshVersion >= 0 && loadedRefreshVersion != RefreshVersion;
        if (requestFingerprint == nextRequest && !forceRefresh)
        {
            if (presentationFingerprint != nextPresentation && result is not null) MapChart(result);
            presentationFingerprint = nextPresentation;
            return;
        }
        requestFingerprint = nextRequest;
        presentationFingerprint = nextPresentation;
        loadedRefreshVersion = RefreshVersion;
        await LoadAsync(forceRefresh);
    }

    private async Task LoadAsync(bool forceRefresh)
    {
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        loadCancellation = new();
        var token = loadCancellation.Token;
        var currentGeneration = ++generation;
        loading = true;
        result = null;
        treeResult = null;
        ChartModel = null;
        error = null;
        chartError = null;
        try
        {
            if (Card.Definition.Visualization == ReportVisualization.RelationshipTree)
            {
                var loadedTree = await Preview.LoadTreeAsync(SessionId, AccountId, Card.Definition,
                    forceRefresh, token);
                if (currentGeneration == generation && !token.IsCancellationRequested)
                    treeResult = loadedTree;
                return;
            }
            var loaded = await Preview.ExecuteAsync(SessionId, AccountId, new(Card.Definition),
                forceRefresh, token);
            if (currentGeneration == generation && !token.IsCancellationRequested)
            {
                result = loaded;
                MapChart(loaded);
            }
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (UnauthorizedAccessException)
        {
            if (currentGeneration == generation) error = "ReportCardUnavailable";
        }
        catch (ReportDefinitionValidationException)
        {
            if (currentGeneration == generation) error = "ReportCardInvalid";
        }
        catch (ReportExecutionException ex)
        {
            if (currentGeneration == generation) error = ex.Message;
        }
        catch (ReportTreeException ex)
        {
            if (currentGeneration == generation) error = ex.Message;
        }
        catch
        {
            if (currentGeneration == generation) error = "ReportCardLoadFailed";
        }
        finally
        {
            if (currentGeneration == generation) loading = false;
        }
    }

    private string Label(ReportExecutionLabel label) =>
        label.ResourceKey is not null ? L[label.ResourceKey].Value : label.Text ?? "";
    private string Format(ReportExecutionValue value) => Format(value.Value, value.Currency);
    private string Format(decimal? value, string? currency) =>
        value.HasValue ? $"{value.Value:N2}{(currency is null ? "" : $" {currency}")}" : "—";
    private string Values(IReadOnlyList<ReportExecutionValue> values) =>
        values.Count == 0 ? "—" : string.Join(", ", values.Select(Format));
    private static string TimeLabel(ReportTimeResult bucket) =>
        $"{bucket.OverlapFrom:d}–{bucket.OverlapTo:d}";
    private void MapChart(ReportExecutionResult loaded)
    {
        if (Card.Definition.Visualization is not (ReportVisualization.Bar or ReportVisualization.Line or ReportVisualization.Donut))
            return;
        try
        {
            ChartModel = ReportChartMapper.Map(Card.Definition.Visualization.Value, loaded, Label, TimeLabel,
                UnitLabel, L["ReportChartAria", Card.Name].Value);
        }
        catch (ReportChartMappingException ex) { chartError = ex.Message; }
    }
    private static string Fingerprint(ReportCardDefinition definition) =>
        $"{definition.Module}|{definition.DefinitionVersion}|{definition.Metric}|" +
        $"{definition.DateBasis}|{definition.Aggregation}|{definition.Period}|{definition.Grouping}|" +
        $"{definition.TimeGrouping}|{definition.Visualization}|" +
        $"{ReportFilterJson.Serialize(definition.Filters)}";

    public ValueTask DisposeAsync()
    {
        generation++;
        loadCancellation?.Cancel();
        loadCancellation?.Dispose();
        return ValueTask.CompletedTask;
    }
}
