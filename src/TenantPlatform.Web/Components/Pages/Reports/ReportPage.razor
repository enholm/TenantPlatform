@page "/reports/{ReportPageId:guid}"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using TenantPlatform.Core.Reports
@using TenantPlatform.Web.Security.CurrentUserContext
@using TenantPlatform.Web.Services.Reports
@inject ICurrentUserContextService UserContext
@inject IReportPageService Pages
@inject IReportCatalogService Catalogs
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@(page?.Name ?? L["ReportsTitle"])</PageTitle>
<NavigationLock ConfirmExternalNavigation="@IsDirty" OnBeforeInternalNavigation="ConfirmNavigationAsync" />

<div class="page-workspace">
@if (busy && page is null) { <p role="status">@L["Loading"]</p> }
else if (loadError is not null) { <div class="alert alert-danger" role="alert">@L[loadError]</div> }
else if (page is not null)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div><a href="/reports" class="small">@L["ReportsTitle"]</a><h1 class="mb-0">@(editing ? workspace.Page(page.Id).Name : page.Name)</h1></div>
        <div class="d-flex flex-wrap gap-2">
            @if (!editing)
            {
                <button type="button" class="btn btn-primary" @onclick="BeginEdit">@L["ReportPageEdit"]</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="DuplicatePageAsync">@L["Duplicate"]</button>
                <button type="button" class="btn btn-outline-danger" @onclick="() => deleting = true">@L["Delete"]</button>
            }
        </div>
    </div>

    @if (operationError is not null) { <div class="alert alert-danger" role="alert">@L[operationError]</div> }
    @if (conflict)
    {
        <div class="alert alert-warning" role="alert">
            @L["ReportPageConcurrency"]
            <button type="button" class="btn btn-sm btn-outline-dark ms-2" @onclick="ReloadAfterConflictAsync">@L["ReportDiscardAndReload"]</button>
        </div>
    }

    @if (!editing)
    {
        @if (page.Cards.Count == 0) { <div class="alert alert-info">@L["ReportPageEmpty"]</div> }
        else
        {
            <ReportGrid Items="ViewGridItems" Editable="false">
                <ItemTemplate Context="gridItem">
                    @{ var viewCard = page.Cards.Single(x => x.Id == gridItem.ClientId); }
                    <ReportCardView AccountId="accountId" Card="viewCard" @key="gridItem.ClientId" />
                </ItemTemplate>
            </ReportGrid>
        }
    }
    else
    {
        @foreach (var draftPage in workspace.Pages)
        {
            <section class="card mb-3" aria-labelledby="@($"workspace-page-{draftPage.Id:N}")">
                <div class="card-header">
                    <label class="form-label fw-semibold" id="@($"workspace-page-{draftPage.Id:N}")" for="@($"workspace-name-{draftPage.Id:N}")">@L["ReportPageName"]</label>
                    <input id="@($"workspace-name-{draftPage.Id:N}")" class="form-control" value="@draftPage.Name" @oninput="e => workspace.Rename(draftPage.Id, e.Value?.ToString() ?? string.Empty)" />
                </div>
                <div class="card-body">
                    @if (draftPage.Cards.Count == 0) { <p class="text-body-secondary">@L["ReportPageEmpty"]</p> }
                    <ReportGrid Items="@DraftGridItems(draftPage)" Editable="true" Generation="workspaceGeneration"
                                SelectedClientId="@(selection.PageId == draftPage.Id ? selection.CardId : null)"
                                OnSelectionChanged="cardId => SelectCard(draftPage.Id, cardId)"
                                OnLayoutChanged="change => ApplyLayout(draftPage.Id, change)">
                        <ItemTemplate Context="gridItem">
                        @{ var card = draftPage.Cards.Single(x => x.ClientId == gridItem.ClientId); }
                        <article class="card h-100 report-edit-card" @key="card.ClientId">
                            <div class="card-body overflow-auto">
                                <strong>@card.Name</strong>
                            </div>
                        </article>
                        </ItemTemplate>
                    </ReportGrid>
                    <button type="button" class="btn btn-outline-primary" @onclick="() => AddCardAsync(draftPage.Id)"><i class="bi bi-plus-lg" aria-hidden="true"></i> @L["ReportCardAdd"]</button>
                </div>
            </section>
        }
        <ReportLayoutPalette @ref="layoutPalette" Name="@(SelectedCard?.Name ?? string.Empty)" Disabled="@(SelectedCard is null)"
            TargetPages="PaletteTargetPages" OnEdit="EditSelected" OnDuplicate="DuplicateSelected"
            OnDelete="DeleteSelectedAsync" OnMoveToPage="MoveSelectedToPageAsync"
            OnMoveUp="() => MoveSelected(-1)" OnMoveDown="() => MoveSelected(1)"
            OnNarrower="() => ResizeSelected(-1, 0)" OnWider="() => ResizeSelected(1, 0)"
            OnShorter="() => ResizeSelected(0, -1)" OnTaller="() => ResizeSelected(0, 1)" />
        <p class="small text-body-secondary">@L["ReportWorkspaceSaveHelp"]</p>
        <p class="visually-hidden" aria-live="polite">@layoutStatus</p>
        <div class="sticky-actions d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-outline-secondary" disabled="@(busy || editorOpen)" @onclick="CancelEdit">@L["Cancel"]</button>
            <button type="button" class="btn btn-primary" disabled="@(busy || editorOpen || !workspace.IsDirty)" @onclick="SaveAsync">@L["SaveChanges"]</button>
        </div>
    }
}
</div>

<ReportCardEditorDialog AccountId="accountId" IsOpen="editorOpen" IsNew="editorNew" Card="editorCard" OnApply="ApplyCard" OnCancel="CloseEditor" />

@if (deleting && page is not null)
{
    <div class="modal-backdrop show"></div><div class="modal d-block" role="alertdialog" aria-modal="true" aria-labelledby="delete-report-title">
    <div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h2 id="delete-report-title" class="modal-title fs-5">@L["ReportPageDelete"]</h2></div>
    <div class="modal-body">@L["ReportPageDeleteConfirm", page.Name, page.Cards.Count]</div><div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" @onclick="() => deleting = false">@L["Cancel"]</button><button type="button" class="btn btn-danger" @onclick="DeletePageAsync">@L["Delete"]</button>
    </div></div></div></div>
}

@code {
    [Parameter] public Guid ReportPageId { get; set; }
    private readonly ReportWorkspaceState workspace = new();
    private readonly ReportCardSelectionState selection = new();
    private ReportPageDto? page;
    private IReadOnlyList<ReportPageSummaryDto> summaries = [];
    private Guid accountId, editorPageId;
    private ReportLayoutPalette? layoutPalette;
    private ReportCardDraft? editorCard;
    private string? loadError, operationError;
    private bool busy, editing, conflict, deleting, editorOpen, editorNew;
    private long workspaceGeneration;
    private string layoutStatus = "";
    private CancellationTokenSource? lifetime;
    private bool IsDirty => editing && workspace.IsDirty;

    protected override async Task OnParametersSetAsync()
    {
        lifetime?.Cancel(); lifetime?.Dispose(); lifetime = new();
        if (UserContext.Current.CurrentAccountId is not Guid id) { Navigation.NavigateTo("/access-denied"); return; }
        accountId = id; await LoadAsync(lifetime.Token);
    }

    private async Task LoadAsync(CancellationToken ct = default)
    {
        busy = true; loadError = null; operationError = null;
        try { page = await Pages.GetAsync(accountId, ReportPageId, ct); summaries = await Pages.ListAsync(accountId, ct); editing = false; ClearSelection(); workspaceGeneration++; }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (UnauthorizedAccessException) { loadError = "ReportPageUnavailable"; }
        catch { loadError = "ReportPagesLoadFailed"; }
        finally { busy = false; }
    }

    private void BeginEdit() { if (page is null) return; workspace.Begin(page); ClearSelection(); workspaceGeneration++; editing = true; conflict = false; operationError = null; }
    private void CancelEdit() { if (editorOpen) return; workspace.Cancel(); ClearSelection(); workspaceGeneration++; editing = false; conflict = false; }
    private void MoveOrder(Guid pageId, Guid cardId, int direction) { workspace.MoveCardInPage(pageId, cardId, direction); layoutStatus = L["ReportLayoutUpdated"]; }
    private void ResizeCard(Guid pageId, Guid cardId, int width, int height) { workspace.ResizeCard(pageId, cardId, width, height); layoutStatus = L["ReportLayoutUpdated"]; }
    private ReportCardDraft? SelectedCard => selection.Resolve(workspace.Pages);
    private IReadOnlyList<ReportPageSummaryDto> PaletteTargetPages => selection.PageId is Guid pageId
        ? summaries.Where(x => x.Id != pageId).ToList()
        : [];

    private Task SelectCard(Guid pageId, Guid? cardId)
    {
        if (!editing || cardId is null)
        {
            ClearSelection();
            return Task.CompletedTask;
        }
        if (workspace.Page(pageId).Cards.All(x => x.ClientId != cardId)) return Task.CompletedTask;
        selection.Select(pageId, cardId.Value);
        return Task.CompletedTask;
    }

    private void ClearSelection() => selection.Clear();
    private void MoveSelected(int direction)
    {
        if (selection.PageId is not Guid pageId || selection.CardId is not Guid cardId) return;
        MoveOrder(pageId, cardId, direction);
    }
    private void ResizeSelected(int width, int height)
    {
        if (selection.PageId is not Guid pageId || selection.CardId is not Guid cardId) return;
        ResizeCard(pageId, cardId, width, height);
    }
    private void EditSelected()
    {
        if (selection.PageId is not Guid pageId || SelectedCard is not { } card) return;
        EditCard(pageId, card);
    }
    private void DuplicateSelected()
    {
        if (selection.PageId is not Guid pageId || SelectedCard is not { } card) return;
        var copy = workspace.DuplicateCard(pageId, card.ClientId, $"{card.Name} {L["ReportCopySuffix"]}");
        selection.Select(pageId, copy.ClientId);
    }
    private async Task DeleteSelectedAsync()
    {
        if (selection.PageId is not Guid pageId || selection.CardId is not Guid cardId) return;
        workspace.DeleteCard(pageId, cardId);
        ClearSelection();
        await InvokeAsync(StateHasChanged);
        if (layoutPalette is not null) await layoutPalette.FocusAsync();
    }

    private async Task AddCardAsync(Guid pageId)
    {
        operationError = null;
        try
        {
            ReportModuleCatalog? catalog = null;
            foreach (var module in Enum.GetValues<ReportModule>()) { try { catalog = await Catalogs.GetAsync(accountId, module); break; } catch (UnauthorizedAccessException) { } }
            if (catalog is null) { operationError = "ReportCardUnavailable"; return; }
            var metric = catalog.Compatibility.Metrics.First();
            var definition = new ReportCardDefinition(catalog.Module, 1, [], new(ReportPeriodRule.CurrentYear), metric.DateBasis,
                metric.Metric, metric.Aggregation, null, null, ReportVisualization.KeyFigure);
            editorPageId = pageId; editorCard = new() { ClientId = Guid.NewGuid(), Name = L["ReportCardDefaultName"], Definition = definition,
                GridColumn = 1, GridRow = workspace.Page(pageId).Cards.Count + 1, GridWidth = 12, GridHeight = 4, SortOrder = workspace.Page(pageId).Cards.Count };
            editorNew = true; editorOpen = true;
        }
        catch { operationError = "ReportCardUnavailable"; }
    }

    private void EditCard(Guid pageId, ReportCardDraft card) { editorPageId = pageId; editorCard = ReportWorkspaceState.Copy(card.Definition) is var d ? card with { Definition = d } : card; editorNew = false; editorOpen = true; }
    private Task CloseEditor() { editorOpen = false; editorCard = null; return Task.CompletedTask; }
    private Task ApplyCard(ReportCardDraft card)
    {
        if (editorNew)
        {
            var added = workspace.AddCard(editorPageId, card.Definition, card.Name);
            workspace.UpdateCard(editorPageId, added.ClientId, card with { ClientId = added.ClientId, Id = null });
        }
        else workspace.UpdateCard(editorPageId, card.ClientId, card);
        editorOpen = false; editorCard = null; return Task.CompletedTask;
    }

    private async Task MoveSelectedToPageAsync(Guid targetId)
    {
        if (selection.PageId is not Guid sourceId || selection.CardId is not Guid cardId) return;
        if (!await MoveToPageAsync(sourceId, cardId, targetId)) return;
        await InvokeAsync(StateHasChanged);
        if (layoutPalette is not null) await layoutPalette.FocusAsync();
    }

    private async Task<bool> MoveToPageAsync(Guid sourceId, Guid cardId, Guid targetId)
    {
        if (targetId == sourceId || summaries.All(x => x.Id != targetId)) return false;
        try
        {
            if (!workspace.Pages.Any(x => x.Id == targetId)) workspace.AddSnapshot(await Pages.GetAsync(accountId, targetId));
            workspace.MoveCard(sourceId, targetId, cardId);
            if (selection.Matches(sourceId, cardId)) ClearSelection();
            return true;
        }
        catch (UnauthorizedAccessException) { operationError = "ReportPageUnavailable"; }
        catch { operationError = "ReportPagesLoadFailed"; }
        return false;
    }

    private async Task SaveAsync()
    {
        if (editorOpen || !workspace.IsDirty) return;
        busy = true; operationError = null; conflict = false;
        try
        {
            var saved = await Pages.SaveWorkspaceAsync(accountId, workspace.BuildRequest());
            workspace.ApplySaved(saved); page = saved.Single(x => x.Id == ReportPageId); ClearSelection(); workspaceGeneration++; editing = false;
        }
        catch (ReportPageConflictException) { conflict = true; }
        catch (ReportPageValidationException ex) { operationError = ex.Message; }
        catch (UnauthorizedAccessException) { operationError = "ReportPageUnavailable"; }
        catch { operationError = "ReportPageSaveFailed"; }
        finally { busy = false; }
    }

    private async Task ReloadAfterConflictAsync() { if (editorOpen) return; await LoadAsync(); conflict = false; }
    private async Task DuplicatePageAsync()
    {
        if (page is null) return;
        try { var copy = await Pages.DuplicateAsync(accountId, page.Id, page.Revision); Navigation.NavigateTo($"/reports/{copy.Id}"); }
        catch (ReportPageConflictException) { operationError = "ReportPageConcurrency"; }
        catch { operationError = "ReportPageSaveFailed"; }
    }
    private async Task DeletePageAsync()
    {
        if (page is null) return;
        try { await Pages.DeleteAsync(accountId, page.Id, page.Revision); Navigation.NavigateTo("/reports"); }
        catch (ReportPageConflictException) { operationError = "ReportPageConcurrency"; deleting = false; }
        catch { operationError = "ReportPageDeleteFailed"; deleting = false; }
    }

    private async Task ConfirmNavigationAsync(LocationChangingContext context)
    {
        if (!IsDirty) return;
        if (!await JS.InvokeAsync<bool>("confirm", L["ReportUnsavedNavigation"].Value)) context.PreventNavigation();
    }
    private IReadOnlyList<ReportGridItem> ViewGridItems => page is null ? [] :
        ReportLayoutEngine.Normalize(page.Cards.Select(x => new ReportGridItem(
            x.Id, x.GridColumn, x.GridRow, x.GridWidth, x.GridHeight, x.SortOrder)));
    private static IReadOnlyList<ReportGridItem> DraftGridItems(ReportPageDraft draft) =>
        draft.Cards.Select(x => new ReportGridItem(x.ClientId, x.GridColumn, x.GridRow,
            x.GridWidth, x.GridHeight, x.SortOrder)).ToList();
    private Task ApplyLayout(Guid pageId, ReportGridLayoutChange change)
    {
        if (!editing || change.Generation != workspaceGeneration) return Task.CompletedTask;
        workspace.UpdateLayout(pageId, change);
        layoutStatus = L["ReportLayoutUpdated"];
        return Task.CompletedTask;
    }
    public void Dispose() { ClearSelection(); lifetime?.Cancel(); lifetime?.Dispose(); }
}
